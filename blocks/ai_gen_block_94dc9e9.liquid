{% doc %}
  @prompt
    Create a section that can display multiple blocks. Each block consists of a picture and a piece of text, with the picture on top and the text below. The size can be adjusted. On the PC side, a maximum of four pictures can be displayed per row. If more than four are needed, they can be slide
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
    #shopify-section-{{ section.id }} {
      background-color: {{ block.settings.section_background_color }};
      padding: {{ block.settings.section_padding }}px 0;
    }

  .ai-image-text-grid-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-image-text-grid__container-{{ ai_gen_id }} {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-image-text-grid__heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weiht:600;
  }

  .ai-image-text-grid__slider-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: 0 60px;
  }

  .ai-image-text-grid__slider-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.3s ease;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-image-text-grid__slide-{{ ai_gen_id }} {
    {% assign gap_count_desktop = block.settings.columns_desktop | minus: 1 %}
    {% assign total_gap_desktop = block.settings.grid_gap | times: gap_count_desktop %}
    width: calc((100% - {{ total_gap_desktop }}px) / {{ block.settings.columns_desktop }});
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .ai-image-text-grid__item-{{ ai_gen_id }} {
    text-align: left;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    height: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }
  .ai-image-text-grid-item-heading {
    font-size: 18px;
    color: #000000;
    margin-bottom: 0;
  }
  .ai-image-text-grid-item-sub-heading {
    font-size: 14px;
    color: #666666;
    margin-bottom: 8px;
  }

  .ai-image-text-grid-item-button-link {
    font-size: 16px;
    color: #000;
    margin-bottom: 0px;
    text-decoration: underline !important;
  }

  .ai-image-text-grid__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4/3;
    margin-bottom: 16px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-text-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-grid__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-image-text-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  .ai-image-text-grid__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    flex-grow: 1;
  }

  .ai-image-text-grid__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_text_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
    z-index: 10;
  }

  .ai-image-text-grid__prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-image-text-grid__next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-image-text-grid__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-image-text-grid__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-image-text-grid__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-style: italic;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding: {{ block.settings.section_padding | times: 0.5 }}px 0;
    }

    .ai-image-text-grid__slider-container-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-image-text-grid__slide-{{ ai_gen_id }} {
      {% assign gap_count_mobile = block.settings.columns_mobile | minus: 1 %}
      {% assign mobile_gap = block.settings.grid_gap | divided_by: 2 %}
      {% assign total_gap_mobile = mobile_gap | times: gap_count_mobile %}
      width: calc((100% - {{ total_gap_mobile }}px) / {{ block.settings.columns_mobile }});
      box-sizing: border-box;
    }

    .ai-image-text-grid__slider-{{ ai_gen_id }} {
      gap: {{ block.settings.grid_gap | divided_by: 2 }}px;
    }

    .ai-image-text-grid__nav-button-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
      background-color: rgba(0, 0, 0, 0.6);
    }

    .ai-image-text-grid__prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-image-text-grid__next-{{ ai_gen_id }} {
      right: 10px;
    }

    .ai-image-text-grid__heading-{{ ai_gen_id }} {
      font-size: 30px;
      margin-bottom: 20px;
    }

  }

  @media screen and (max-width: 480px) {
    .ai-image-text-grid__heading-{{ ai_gen_id }} {
      font-size: 24px;
      font-family: 'Mulish-Bold';
    }
  }
{% endstyle %}

<image-text-slider-{{ ai_gen_id }}
  class="ai-image-text-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-columns-desktop="{{ block.settings.columns_desktop }}"
  data-columns-mobile="{{ block.settings.columns_mobile }}"
>
  <div class="ai-image-text-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-image-text-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% assign has_content = false %}
    {% for i in (1..12) %}
      {% assign image_key = 'image_' | append: i %}
      {% assign text_key = 'text_' | append: i %}
      {% if block.settings[image_key] != blank or block.settings[text_key] != blank %}
        {% assign has_content = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_content %}
      <div class="ai-image-text-grid__slider-container-{{ ai_gen_id }}">
        <button
          class="ai-image-text-grid__nav-button-{{ ai_gen_id }} ai-image-text-grid__prev-{{ ai_gen_id }}"
          aria-label="Previous slide"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
        </button>

        <div class="ai-image-text-grid__slider-{{ ai_gen_id }}">
          {% for i in (1..12) %}
            {% assign image_key = 'image_' | append: i %}
            {% assign text_key = 'text_' | append: i %}
            {% assign image = block.settings[image_key] %}
            {% assign text = block.settings[text_key] %}
            {% assign heading_key = 'heading_' | append: i %}
            {% assign sub_heading_key = 'sub_heading_' | append: i %}
            {% assign button_key = 'button_' | append: i %}
            {% assign button_link_key = 'button_link_' | append: i %}
            {% assign heading = block.settings[heading_key] %}
            {% assign sub_heading = block.settings[sub_heading_key] %}
            {% assign button = block.settings[button_key] %}
            {% assign button_link = block.settings[button_link_key] %}
            {% if image != blank or text != blank %}
              <div class="ai-image-text-grid__slide-{{ ai_gen_id }}">
                <div class="ai-image-text-grid__item-{{ ai_gen_id }}">
                  {% if button_link != blank %}
                    <a
                      href="{{ button_link }}"
                      class="ai-image-text-grid__image-wrapper-{{ ai_gen_id }}"
                      target="_blank"
                    >
                  {% else %}
                    <div class="ai-image-text-grid__image-wrapper-{{ ai_gen_id }}">
                  {% endif %}
                  {% if image != blank %}
                    <img
                      src="{{ image | image_url: width: 400 }}"
                      alt="{{ image.alt | escape }}"
                      class="ai-image-text-grid__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="400"
                      height="auto"
                    >
                  {% else %}
                    <div class="ai-image-text-grid__image-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                  {% if button_link != blank %}
                    </a>
                  {% else %}
                    </div>
                  {% endif %}
                  {% if heading != blank %}
                    <div class="ai-image-text-grid-item-heading">{{ heading }}</div>
                  {% endif %}
                  {% if sub_heading != blank %}
                    <div class="ai-image-text-grid-item-sub-heading">{{ sub_heading }}</div>
                  {% endif %}

                  {% if text != blank %}
                    <div class="ai-image-text-grid__text-{{ ai_gen_id }}">{{ text }}</div>
                  {% endif %}
                  {% if button_link != blank %}
                    <a class="ai-image-text-grid-item-button-link" href="{{ button_link }}">{{ button }}</a>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <button
          class="ai-image-text-grid__nav-button-{{ ai_gen_id }} ai-image-text-grid__next-{{ ai_gen_id }}"
          aria-label="Next slide"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9,18 15,12 9,6"></polyline>
          </svg>
        </button>
      </div>
    {% else %}
      <div class="ai-image-text-grid__empty-state-{{ ai_gen_id }}">Add images and text to get started</div>
    {% endif %}
  </div>
</image-text-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageTextSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 0;
        this.columnsDesktop = parseInt(this.dataset.columnsDesktop) || 4;
        this.columnsMobile = parseInt(this.dataset.columnsMobile) || 1;
      }

      connectedCallback() {
        this.slider = this.querySelector('.ai-image-text-grid__slider-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-image-text-grid__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-image-text-grid__prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-image-text-grid__next-{{ ai_gen_id }}');

        if (!this.slider || this.slides.length === 0) return;

        this.calculateSlides();
        this.setupEventListeners();
        this.updateNavigation();

        window.addEventListener('resize', () => {
          this.calculateSlides();
          this.updateSlider();
          this.updateNavigation();
        });
      }

      calculateSlides() {
        const isMobile = window.innerWidth <= 768;
        const columns = isMobile ? this.columnsMobile : this.columnsDesktop;
        this.totalSlides = Math.max(0, this.slides.length - columns);
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }
      }

      previousSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
          this.updateSlider();
          this.updateNavigation();
        }
      }

      nextSlide() {
        if (this.currentSlide < this.totalSlides) {
          this.currentSlide++;
          this.updateSlider();
          this.updateNavigation();
        }
      }

      updateSlider() {
        if (!this.slider || this.slides.length === 0) return;
        
        const slideWidth = this.slides[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.slider).gap) || 0;
        const translateX = -(this.currentSlide * (slideWidth + gap));
        
        this.slider.style.transform = `translateX(${translateX}px)`;
      }

      updateNavigation() {
        if (this.prevButton) {
          this.prevButton.disabled = this.currentSlide === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentSlide >= this.totalSlides;
        }
      }
    }

    customElements.define('image-text-slider-{{ ai_gen_id }}', ImageTextSlider{{ ai_gen_id }});
  })();
</script>

