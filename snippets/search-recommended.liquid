<div class="search-recommendation-container">
    <a href="{{ settings.product_1.url }}" class="search-recommendation-item">
        <img loading="lazy" src="{{ settings.product_1.selected_or_first_available_variant.image | img_url: 'master' }}" class="search-recommend-img" alt="{{ settings.product_1.alt | escape }}">
        <div class="product-details">
            {% if settings.product_1.metafields.custom.status != blank %}
              <p class="mx-0 f-f-bold main-color p-small">{{ settings.product_1.metafields.custom.status }}</p>
            {% endif %}
            <p class="mx-0 f-f-regular black-f p-small">{{ settings.product_1_title }}</p>
        </div>
    </a>
