{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="f-f-medium t-up h2 menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      >
                        {{ link.title | escape }}
                        {% render 'icon-arrow-next' %}
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset h5" aria-expanded="true">
                            <span class="svg-wrapper">
                              {% render 'icon-arrow-prev' %}
                            </span>
                            {{ link.title | escape }}
                          </button>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              {% if childlink.object.products != blank %}
                                  <div class="product-grid-list-container">
                                    {%- for product in childlink.object.products -%}
                                          <a href="{{ product.url }}" class="container-item">
                                              <img loading="lazy" class="fet-product-image" 
                                              {% if product.metafields.custom.custom_featured_product_image != blank %}
                                                  src="{{ product.metafields.custom.custom_featured_product_image | img_url: '2048x2048' }}"
                                              {% else %}
                                                  {% if product.selected_or_first_available_variant.featured_image %}
                                                      src="{{ product.selected_or_first_available_variant.featured_image | img_url: '2048x2048' }}"
                                                  {% else %}
                                                      src="{{ product.featured_image | img_url: '2048x2048' }}"
                                                  {% endif %}
                                              {% endif %}
                                                width="100%"
                                                height="100%"
                                              >
                                            <h5 class="f-f-medium mx-0 center">
                                                {% if product.metafields.custom.custom_title != blank %}
                                                  {{ product.metafields.custom.custom_title }}
                                                {% else %}
                                                  {{ product.title }}
                                                {% endif %}
                                            </h5>
                                          </a>
                                    {% endfor %}
                                  </div>
                                  {% for block in section.blocks %}
                                    {% if block.settings.mega_menu_title == childlink.title %}
                                      {% if block.settings.featured_image_mobile != blank %}
                                      <a href="{{ block.settings.featured_url }}" class="mobile-view-all-container">
                                         <img loading="lazy" src="{{ block.settings.featured_image_mobile | img_url: 'master' }}" class="mobile-view-all"> 
                                          <h3 class="f-f-semibold mx-0 white-f">View All</h3>
                                      </a>
                                        {% endif %}
                                    {% endif %}
                                  {% endfor %}
                              {% elsif childlink.title == 'About Us' %}

                                <!-- MEGA MENU - DISPLAY 3  -->
                                <details id="Details-menu-drawer-qcy-technology">
                                    <summary
                                      id="HeaderDrawer-qcy-technology"
                                      class="f-f-medium t-up h2 menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                                    >
                                        QCY Technology
                                      {% render 'icon-arrow-next' %}
                                    </summary>
                                    <div id="childlink-qcy-technology" class="menu-drawer__submenu has-submenu gradient motion-reduce">
                                      <button class="menu-drawer__close-button link link--text focus-inset h5" aria-expanded="true">
                                        <span class="svg-wrapper">
                                          {% render 'icon-arrow-prev' %}
                                        </span>
                                        QCY Technology
                                      </button>

                                      <div class="tab-container-list">
                                          <div class="row" style="--bs-gutter-y:1rem;">
                                            
                                              <div class="col-12">
                                                  <a href="/pages/audio-technologies" class="tab-item">
                                                      <img src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/40106_2x_8066e5de-3a3c-4c35-bccb-7bd6e86ff167.png?v=1750778256" class="img-container" width="100%" height="100%">
                                                      <h3 class="white-f f-f-bold mx-0">Audio</h3>
                                                  </a>
                                              </div>
                                              {% if block.settings.tab_1_heading_2 != blank %}
                                              <div class="col-12">
                                                  <a href="{{ block.settings.tab_1_link_2 }}" class="tab-item">
                                                      <img src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/40006_2x_fa7a7338-6e24-4031-b10b-ed248ca1e26b.png?v=1750778256" class="img-container" width="100%" height="100%">
                                                      <h3 class="white-f f-f-bold mx-0">{{ block.settings.tab_1_heading_2 }}</h3>
                                                  </a>
                                              </div>
                                              {% endif %}
                                            
                                          </div>
                                      </div>
                                      
                                    </div>
                                </details>
                                <details id="Details-menu-drawer-about-us">
                                    <summary
                                      id="HeaderDrawer-about-us"
                                      class="f-f-medium t-up h2 menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                                    >
                                        About Us
                                      {% render 'icon-arrow-next' %}
                                    </summary>
                                    <div id="childlink-qcy-technology" class="menu-drawer__submenu has-submenu gradient motion-reduce">
                                      <button class="menu-drawer__close-button link link--text focus-inset h5" aria-expanded="true">
                                        <span class="svg-wrapper">
                                          {% render 'icon-arrow-prev' %}
                                        </span>
                                        About Us
                                      </button>
                                      
                                      <div class="tab-container-list">
                                          <div class="tab-item">
                                              <img src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/40009_2x_538879b1-c466-43fd-abf0-659f1d05c6fb.png?v=1750779646" class="img-container" width="100%" height="100%">
                                          </div>
                                          <div class="pt-3">
                                              <p class="h4 f-f-medium black-f text-center">
                                                About Us，Launched By Tech-Savvy Audio Enthusiasts And Engineers, QCY Has Grown Into Oneof The Largest Bluetooth Headphone Manufacturers. 
                                              </p>
                                              <a href="{{ block.settings.url }}" class="btn s-main f-f-regular p white-f ">
                                                <h5 class="mx-0">
                                                  Learn More
                                                </h5>
                                              </a>
                                          </div>
                                      </div>
                                      
                                    </div>
                                </details>
                                <details id="Details-menu-drawer-blog">
                                    <summary
                                      id="HeaderDrawer-blog"
                                      class="f-f-medium t-up h2 menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                                    >
                                        Blog
                                      {% render 'icon-arrow-next' %}
                                    </summary>
                                    <div id="childlink-qcy-technology" class="menu-drawer__submenu has-submenu gradient motion-reduce">
                                      <button class="menu-drawer__close-button link link--text focus-inset h5" aria-expanded="true">
                                        <span class="svg-wrapper">
                                          {% render 'icon-arrow-prev' %}
                                        </span>
                                        Blog
                                      </button>
                                      
                                      <div class="tab-container-list">
                                          <div class="tab-item">
                                              <img src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/40008_2x_e5f1747c-afbe-4803-9ad1-a9865cd6c3d2.png?v=1750781316" class="img-container" width="100%" height="100%">
                                          </div>
                                          <div class="pt-3">
                                              <p class="h4 f-f-medium black-f text-center">
                                                 Blog, a place where you can discover the latest updates, in-depth reviews, and expert tips to guide you in selecting the ideal headset that suits your needs perfectly. 
                                              </p>
                                              <a href="{{ block.settings.url }}" class="btn s-main f-f-regular p white-f ">
                                                <h5 class="mx-0">
                                                  Learn More
                                                </h5>
                                              </a>
                                          </div>
                                      </div>
                                      
                                    </div>
                                </details>
                                <details id="Details-menu-drawer-sustainability">
                                    <summary
                                      id="HeaderDrawer-sustainability"
                                      class="f-f-medium t-up h2 menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                                    >
                                        Sustainability
                                      {% render 'icon-arrow-next' %}
                                    </summary>
                                    <div id="childlink-qcy-technology" class="menu-drawer__submenu has-submenu gradient motion-reduce">
                                      <button class="menu-drawer__close-button link link--text focus-inset h5" aria-expanded="true">
                                        <span class="svg-wrapper">
                                          {% render 'icon-arrow-prev' %}
                                        </span>
                                        Sustainability
                                      </button>
                                      
                                      <div class="tab-container-list">
                                          <div class="tab-item">
                                              <img src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/40010_2x_88674a43-1ed0-4740-bace-0588a72e0080.png?v=1750781335" class="img-container" width="100%" height="100%">
                                          </div>
                                          <div class="pt-3">
                                              <p class="h4 f-f-medium black-f text-center">
                                                 Sustainability, We adhere to environmental principles, using energy-saving technologies and recycled materials to reduce environmental impact, providing green and efficient Bluetooth headset solutions to protect the Earth.
                                              </p>
                                              <a href="{{ block.settings.url }}" class="btn s-main f-f-regular p white-f ">
                                                <h5 class="mx-0">
                                                  Learn More
                                                </h5>
                                              </a>
                                          </div>
                                      </div>
                                      
                                    </div>
                                </details>
                                
                                
                              {% elsif childlink.title == 'Blog' or childlink.title == 'Sustainability' %}
                                 <!-- NEED TO REMOVE MENU NAV in BACKEND -->
                            
                              {% else %}
                                <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{ childlink.title | escape }}
                                    {% render 'icon-arrow-next' %}
                                  </a>
                                {%- else -%}
                                  <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary
                                      id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                    >
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-caret.svg' | inline_asset_content -}}
                                      </span>
                                    </summary>
                                    <div
                                      id="childlink-{{ childlink.handle | escape }}"
                                      class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                    >
                                      <button
                                        class="menu-drawer__close-button link link--text focus-inset"
                                        aria-expanded="true"
                                      >
                                        <span class="svg-wrapper">
                                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                                        </span>
                                        {{ childlink.title | escape }}
                                      </button>
                                      <ul
                                        class="menu-drawer__menu list-menu"
                                        role="list"
                                        tabindex="-1"
                                      >
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                              {% endif %}
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
          <div class="menu-drawer__utility-links">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="h5 menu-drawer__account link focus-inset h5 medium-hide large-up-hide"
                rel="nofollow"
              >
                {%- if section.settings.enable_customer_avatar -%}
                  <account-icon>
                    {%- if customer and customer.has_avatar? -%}
                      {{ customer | avatar }}
                    {%- else -%}
                      <span class="svg-wrapper">
                        {{- 'icon-account.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}
                  </account-icon>
                {%- else -%}
                  <span class="svg-wrapper">
                    {{- 'icon-account.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
