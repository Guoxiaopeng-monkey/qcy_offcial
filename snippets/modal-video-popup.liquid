<style>

  /* MODAL */
  
  .custom-modal-section{
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    z-index: 100;
    opacity: 0;
    visibility:hidden;
    transition: opacity 0.3s;
  }
  .custom-modal-section.open{
    visibility:visible;
    opacity:1;
  }
  .custom-modal-section .overlay{
    position: fixed;
    top: 0;
    background-color: rgba(0, 0, 0, 0.6);
    width: 100%;
    height: 100%;
  }
  .custom-model-inner-section{
    height:100%;
    display:flex;
  }
  .custom-modal-container{
    max-width: 850px;
    max-height:600px;
    border-radius: 4px;
    border: 2rem;
    transition: opacity 0.5s ease 0.5s, transform 0.5s ease 0.6s;
    margin: auto;
    height:fit-content;
    z-index:3;
    display:flex;
  }
  .custom-modal-container iframe,
  .custom-modal-container video{
    width:50vw;
    height:50vh;
  }
  .custom-modal-container.form-success .feedback-info-form{
      display:none;
  }
  .custom-modal-section.open .custom-modal-container{
    opacity:1;
    transform: translateY(0);
  }
  .custom-info-form::-webkit-scrollbar {
    width: 0px;
  }
  .custom-info-form::-webkit-scrollbar-track {
    background: #f1f1f1; 
  }
  .custom-info-form::-webkit-scrollbar-thumb {
    background: #F89320;
  }
  .custom-info-form::-webkit-scrollbar-thumb:hover {
    background: #555; 
  }
  
  .custom-close{
    position:absolute;
    top:10px;
    right:12px;
    border-radius: 4px;
    width: 35px;
    height: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background-color:#464444;
  }
  .custom-close svg{
    width:14px;
  }
  .custom-close svg path{
    stroke: #fff;
    stroke-width: 1px;
  }
  body.no-scroll{
    overflow:hidden;
  }

  
  .modal-heading{
    padding-bottom:1rem;
  }

  
  .feedback-info-form{
    padding-top:20px;
  }
  .custom-input-box{
    display:flex;
    gap:10px;
    padding-bottom:2.5rem;
  }
  .custom-input-box.bottom-input{
    gap:10px;
  }
  .input-box-item{
    display:flex;
    flex-direction:column;
    gap:0.5rem;
  }
  .custom-input-box select .placeholder{
    color:#A8A8A8;
  }
  .custom-input-box select,
  .custom-input-box input,
  .custom-input-box textarea{
    border: 1px solid #D7D7D7;
    padding: 1.5rem 15px;
    border-radius: 4px;
    font-family: 'Mulish-Regular';
    -webkit-appearance: none;
    color: #A8A8A8;
    width:100%;
    transition: all 0.3s ease;
  }
  .hover-input:hover select,
  .hover-input:hover input,
  .hover-input:hover textarea{
    border-color:#FF8832;
    box-shadow: #ff88321c 0px 8px 24px;
  }
  .custom-input-box .input-name,
  .custom-input-box .input-email{
    position:relative;
  }
  .custom-input-box .input-name svg,
  .custom-input-box .input-email svg{
    position:absolute;
    bottom: 20%;
    left: 10px;
    left: 10px;
    width: 30px;
    height: 28px;
  }
  .custom-input-box .input-name input,
  .custom-input-box .input-email input{
    padding-left:45px;
  }
  .btn-submit-container{
    display:flex;
    padding-top:10px;
  }
  .btn-submit-container button{
    background-color: #FF8832;
    border: none;
    color: white;
    border-radius: 50px;
    margin: auto;
    padding:1.5rem 0px;
    cursor:pointer;
  }
  .two-column{
    display:flex;
    gap:10px;
  }

  .select-tag-option{
    display: flex;
    flex-direction: column;
    position: absolute;
    background: white;
    top: 70%;
    padding: 10px 0px;
    z-index: 1;
    width: 100%;
    max-height: 350px; /* Set maximum height instead of fixed height */
    overflow-y: auto; /* Enable scrolling when content exceeds max height */
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
    opacity:0;
    visibility:hidden;
  }
  .select-tag-option::-webkit-scrollbar {
    width: 5px;
  }
  .select-tag-option::-webkit-scrollbar-track {
    background: #f1f1f1; 
  }
  .select-tag-option::-webkit-scrollbar-thumb {
    background: #F89320;
  }
  .select-tag-option::-webkit-scrollbar-thumb:hover {
    background: #555; 
  }
  .select-tag-option p{
    padding:5px 10px;
    transition: all 0.3s ease;
    cursor:pointer;
  }
  .select-tag-option p:hover{
    background-color:#aaaaaa26;
  }
  .custom-input-box.select-tag{
    position:relative;
  }
  .custom-input-box input:focus + .select-tag-option{
    opacity:1;
    visibility:visible;
  }
  .input-form-fields h5{
    padding-bottom:1rem;
  }
  .input-close {
     width: 20px;
    height: 20px;
    position: absolute;
    right: 1rem;
    top: 20%;
    background-color: #ff883233;
    border-radius: 50px;
    display: flex;
    padding: 7px;
    visibility:hidden;
  }
  .custom-input-box input:not([value=""]) + .input-close {
    visibility:visible;
  }
  /* ENDMODAL */
  
  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
    .contact-us-information-container{
      row-gap:40px;
      column-gap: 30px;
      grid-template-columns:100%;
    }
    .feedback-modal-container{
        padding: 30px 20px;
        width: 100%;
        height: 100vh;
        margin: 0;
    }
    .two-column{
      flex-direction:column;
    }
    .custom-input-box{
      flex-direction:column;
    }
    .select-tag-option{
      max-height: 200px; /* Set maximum height instead of fixed height */
    }
    
    .custom-modal-container iframe,
    .custom-modal-container video{
       width: 90vw;
      height: 50vh;
    }
  }
  
  /* ipad Air */
  @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
    .contact-us-information-container{
      row-gap:40px;
      column-gap: 30px;
    }
    .feedback-modal-container{
        padding: 30px 20px;
        width: 100%;
        height: 100vh;
        margin: 0;
    }
    .custom-input-box{
      flex-direction:column;
    }
    .select-tag-option{
      max-height: 200px; /* Set maximum height instead of fixed height */
    }
    .custom-modal-container iframe,
    .custom-modal-container video{
       width: 90vw;
      height: 50vh;
    }
  }
  /* TABLETS  */ 
  @media only screen and (min-width: 768px) {
    .contact-us-information-container{
      row-gap:40px;
      column-gap: 30px;
    }
  }
   @media only screen and (min-width: 800px) {
    .contact-us-information-container{
      row-gap:40px;
      column-gap: 30px;
    }
  }
  @media (min-width: 1024px) and (orientation: portrait) {
    .contact-us-information-container{
      row-gap:40px;
      column-gap: 30px;
    }
  }
  
   /* COMPUTERS */
  @media (min-width: 1024px) and (orientation: landscape) {
    .contact-us-information-container{
      row-gap:40px;
      column-gap: 30px;
    }
  }
  @media only screen and (min-width: 1280px) {
    .contact-us-information-container{
      row-gap:40px;
      column-gap: 40px;
    }
  }
  @media only screen and (min-width: 1366px) {
    .contact-us-information-container{
      row-gap:40px;
      column-gap: 40px;
    }
  }
  @media only screen and (min-width: 1440px) {
    .contact-us-information-container{
      row-gap:50px;
      column-gap: 50px;
    }
  }
  @media only screen and (min-width: 1536px) {
    .contact-us-information-container{
      row-gap:50px;
      column-gap: 10%;
    }
  }
  @media only screen and (min-width: 1600px) {
    .contact-us-information-container{
      row-gap:60px;
      column-gap: 13%;
    }
  }
  @media only screen and (min-width: 1920px) {
    .contact-us-information-container{
      row-gap:60px;
      column-gap: 15%;
    }
  }

</style>

<div class="custom-modal-section">
        <div class="overlay">
        </div>
    <span class="custom-close">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-close" viewBox="0 0 18 17">
            <path fill="currentColor" d="M.865 15.978a.5.5 0 0 0 .707.707l7.433-7.431 7.579 7.282a.501.501 0 0 0 .846-.37.5.5 0 0 0-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 1 0-.707-.708L8.991 7.853 1.413.573a.5.5 0 1 0-.693.72l7.563 7.268z"></path>
        </svg>
    </span>
    <div class="custom-model-inner-section">
        <div class="custom-modal-container">
          <video playsinline controls poster="">
              <source src="" type="video/mp4">
              Your browser does not support the video tag.
          </video>
        </div>
    </div>
</div>