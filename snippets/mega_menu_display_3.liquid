<div class="mega_menu_display mega-menu-tab-list">
    <div class="row mega-menu-row">
        <div class="col-3">
            <div class="tab-menu-container">
                <span class="tab-span active" data-tab="qcy-technology">
                    QCY Technology
                </span>
                <span class="tab-span" data-tab="about-us">
                    About Us
                </span>
                <span class="tab-span" data-tab="blog">
                    Blog
                </span>
                <span class="tab-span" data-tab="sustainability">
                    Sustainability
                </span>
            </div>
        </div>
        <div class="col-9">
            <div class="tab-container-list row" data-tab="qcy-technology">
                {% if block.settings.tab_1_heading != blank %}
                    <div class="col-6">
                        <a href="{{ block.settings.tab_1_link }}" class="tab-item">
                            <img src="{{ block.settings.tab_1_image | img_url: 'master' }}" class="img-container" width="100%" height="100%">
                            <h3 class="white-f f-f-bold mx-0">{{ block.settings.tab_1_heading }}</h3>
                        </a>
                    </div>
                {% endif %}
                {% if block.settings.tab_1_heading_2 != blank %}
                    <div class="col-6">
                        <a href="{{ block.settings.tab_1_link_2 }}" class="tab-item">
                            <img src="{{ block.settings.tab_1_image_2 | img_url: 'master' }}" class="img-container" width="100%" height="100%">
                            <h3 class="white-f f-f-bold mx-0">{{ block.settings.tab_1_heading_2 }}</h3>
                        </a>
                    </div>
                {% endif %}
            </div>
            <div class="tab-container-list row" data-tab="about-us" style="display:none;">
                <div class="col-5">
                    <div class="d-flex flex-column justify-content-between align-items-start h-100 pb-5">
                        <p class="f-f-medium black-f">
                            {{ block.settings.tab_2_desciprtion }}
                        </p>
                        <a href="{{ block.settings.tab_2_link }}" class="f-f-medium black-f">
                            <span class="text-decoration-underline">{{ block.settings.tab_2_link_label }}</span> >
                        </a>
                    </div>
                </div>
                <div class="col-7">
                    <div class="img-container-tab">
                        <img src="{{ block.settings.tab_2_image | img_url: 'master' }}" class="img-container" width="100%" height="100%">
                    </div>
                </div>
            </div>
            <div class="tab-container-list row" data-tab="blog" style="display:none;">
                <div class="col-5">
                    <div class="d-flex flex-column justify-content-between align-items-start h-100 pb-5">
                        <p class="f-f-medium black-f">
                            {{ block.settings.tab_3_desciprtion }}
                        </p>
                        <a href="{{ block.settings.tab_3_link }}" class="f-f-medium black-f">
                            <span class="text-decoration-underline">{{ block.settings.tab_3_link_label }}</span> >
                        </a>
                    </div>
                </div>
                <div class="col-7">
                    <div class="img-container-tab">
                        <img src="{{ block.settings.tab_3_image | img_url: 'master' }}" class="img-container" width="100%" height="100%">
                    </div>
                </div>
            </div>
            <div class="tab-container-list row" data-tab="sustainability" style="display:none;">
                <div class="col-5">
                    <div class="d-flex flex-column justify-content-between align-items-start h-100 pb-5">
                        <p class="f-f-medium black-f">
                            {{ block.settings.tab_4_desciprtion }}
                        </p>
                        <a href="{{ block.settings.tab_4_link }}" class="f-f-medium black-f">
                            <span class="text-decoration-underline">{{ block.settings.tab_4_link_label }}</span> >
                        </a>
                    </div>
                </div>
                <div class="col-7">
                    <div class="img-container-tab">
                        <img src="{{ block.settings.tab_4_image | img_url: 'master' }}" class="img-container" width="100%" height="100%">
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>