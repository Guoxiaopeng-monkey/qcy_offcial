<style>
  .promotion-product{
    height:fit-content;
    border-radius:20px;
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
    background-color:#fff;
  }
  .featured-promotion-product{
    width:100%;
    height:100%;
    object-fit: cover;
  }
  .promotion-product .product-featured{
    display:flex;
    height:400px;
    overflow:hidden;
    border-radius:20px;
    position:relative;
  }
  .product-promo-details{
    padding: 25px 30px 20px;
  }
  .product-promo-details .left-content{
    display:flex;
    flex-direction:column;
    gap:10px;
  }
  .product-promo-details .right-content{
    display:flex;
    flex-direction:column;
    gap:1rem;
  }
  .promotion-product .promotion-price{
    display:flex;
    align-items: center;
    gap:1rem;
  }
  .promotion-product .promotion-price .original-price{
    font-size:26px;
  }
  .promotion-product .promotion-price .compare-price{
    font-size:22px;
    color:#aaa;
  }
  .promotion-buy-now-btn{
    background-color:#FF8832;
    color:#fff;
    display:flex;    
    gap:0.5rem;
    align-items: center;
    justify-content: center;
    padding:0.8rem 10px;
  }
  .product-promo-details .quick-add.add-to-cart-btn,
  .product-promo-details product-page-form,
  .product-promo-details .form add_cart_form{
    display:block;
    height:fit-content;
  }
  .promotion-add-to-cart-btn{
    color:#FF8832;
    border:1px solid #FF8832;
    display:flex;    
    align-items: center;
    justify-content: center;
    padding:1rem 10px;
  }
  .loading .promotion-add-to-cart-btn{
    color:#fff;
  }
  .product-promo-details product-page-form svg circle{
    stroke:#FF8832;
  }
  .promotion-buy-now-btn,
  .promotion-add-to-cart-btn{
    width:100%;
    border-radius:50px;
  }
  .free-gift-container{
    background-color:#FFF0E4;
    position:relative;
    height:80px;
    margin-bottom:20px;
    border-radius:10px;
    display:flex;
    align-items: center;
  }
  .label-gift,
  .fee-gift-product,
  .fee-gift-product img{
    height:100%;
    mix-blend-mode: multiply;
  }
  
  .free-gift-label{
    height:100%;    
    position: relative;
    left: -10px;
    top: -10px;
  }
  .discount-banner{
    background: #FFF0E4;
    width: fit-content;
    padding: 0.5rem 1.5rem;
    text-align: center;
    position: absolute;
    top: 0;
    left: 20px;
  }
  .discount-banner:after{
    content: "";
    display: block;
    background-color: #FFF0E4;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    width: 100%;
    height: 20px;
    position: absolute;
    transform: scaleY(-1);
    left: 0;
    margin-top: 5px;
  }
  .free-gift-product-details{
    padding-left:30px;
  }

  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
      .promotion-product .product-featured{
        height:200px;
        border-radius:8px;
      }
      .discount-banner:after{
        margin-top:4px;
        height:15px;
      }
      .discount-banner p{
        font-size:11px;
      }
      .discount-banner h5{
        font-size:15px;
      }
      .product-promo-details{
        padding:15px 20px 10px;
      }
      .product-promo-details .d-flex{
          display: grid !important;
          grid-template-columns: 68% 32%;
      }
      .product-promo-details .left-content{
        gap:5px;
      }
      .product-promo-details .d-flex .left-content .description{
        font-size:11px;
      }
      .product-promo-details .d-flex .left-content .product-title{
        font-size:18px;
      }
      .product-promo-details .promotion-buy-now-btn,
      .product-promo-details  .promotion-add-to-cart-btn{
        font-size:10px;
        padding-left:5px;
        padding-right:5px;
      }
      .promotion-product .promotion-price .original-price{
        font-size:14px;
      }
      .promotion-product .promotion-price .compare-price{
        font-size:12px;
      }
      .free-gift-container{
        height:60px;
      }
      .free-gift-container .fee-gift-product{
        margin-left:-20px;
      }
      .label-gift, .fee-gift-product, .fee-gift-product img{
        height: 60px;
      }
      .free-gift-product-details h4{
        font-size:14px;
      }
      .free-gift-product-details h5{
        font-size:12px;
      }
      .free-gift-label{
        left:-6px;
        top:-6px;
      }
      .promotion-product .promotion-price{
        gap:5px;
        flex-direction:column;
        align-items: flex-start;
      }
  }
  
  /* ipad Air */
  @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
      .promotion-product .product-featured{
        height:200px;
        border-radius:8px;
      }
      .discount-banner:after{
        margin-top:4px;
        height:15px;
      }
      .discount-banner p{
        font-size:11px;
      }
      .discount-banner h5{
        font-size:15px;
      }
      .product-promo-details{
        padding:15px 20px 10px;
      }
      .product-promo-details .d-flex{
          display: grid !important;
          grid-template-columns: 68% 32%;
      }
      .product-promo-details .left-content{
        gap:5px;
      }
      .product-promo-details .d-flex .left-content .description{
        font-size:11px;
      }
      .product-promo-details .d-flex .left-content .product-title{
        font-size:18px;
      }
      .product-promo-details .promotion-buy-now-btn,
      .product-promo-details  .promotion-add-to-cart-btn{
        font-size:10px;
        padding-left:5px;
        padding-right:5px;
      }
      .promotion-product .promotion-price .original-price{
        font-size:14px;
      }
      .promotion-product .promotion-price .compare-price{
        font-size:12px;
      }
      .free-gift-container{
        height:60px;
      }
      .free-gift-container .fee-gift-product{
        margin-left:-20px;
      }
      .label-gift, .fee-gift-product, .fee-gift-product img{
        height: 60px;
      }
      .free-gift-product-details h4{
        font-size:14px;
      }
      .free-gift-product-details h5{
        font-size:12px;
      }
      .free-gift-label{
        left:-6px;
        top:-6px;
      }
      .promotion-product .promotion-price{
        gap:5px;
        flex-direction:column;
        align-items: flex-start;
      }
  }

</style>
<div class="promotion-product">
    <a href="{{ product.url }}" class="product-featured">
        {% assign amount_discount = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price %}
        {% assign percentage_discount = amount_discount | times: 100 | divided_by: product.selected_or_first_available_variant.compare_at_price | round %}
        {% if product.metafields.custom.discount_badge %}
          {% if product.selected_or_first_available_variant.compare_at_price != blank %}
              <div class="badge-discount-banner">
                <h5 class="h3 main-color f-f-bold mx-0 l-h-normal">{{ percentage_discount }}%</h5>
                <h5 class="h3 main-color f-f-bold mx-0 l-h-normal">OFF</h5>
              </div>
          {% endif %}
        {% else %}
          {% if product.selected_or_first_available_variant.compare_at_price != blank %}
              <div class="badge-discount-banner">
                  <p class="mx-0 main-color f-f-regular l-h-normal">Save</p>
                  <h5 class="h3 main-color f-f-bold mx-0 l-h-normal">{{ amount_discount | money }}</h5>
              </div>
          {% endif %}
        {% endif %}
        <img loading="lazy" src="{{ block.settings.featured_image | img_url: "master" }}" class="featured-promotion-product">
    </a>
    <div class="product-promo-details">
        {% if product.metafields.custom.free_gift %}
        <div class="free-gift-container">
          <div class="label-gift">
            <img loading="lazy" src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/43925.png?v=1729565819" class="free-gift-label">
          </div>
          <div class="fee-gift-product">
            <img loading="lazy" src="{{ product.metafields.custom.free_gift.value.featured_image | img_url: 'master' }}"> 
          </div>
            <div class="free-gift-product-details">
              <a href="{{ product.metafields.custom.free_gift.value.url }}" class="black-f">
                <h4 class="mx-0 f-f-bold">{{ product.metafields.custom.free_gift.value.title }}</h4>
              </a>
              <h5 class="mx-0 gray-f f-f-semibold">{{ product.metafields.custom.free_gift.value.price | money }}</h5>
            </div>
        </div>
        {% endif %}
        <div class="d-flex">
            <div class="col_75 left-content">
                <h3 class="product-title text-sm f-f-bold mx-0">
                  {% if product.metafields.custom.custom_title != blank %}
                    {{ product.metafields.custom.custom_title }}
                  {% else %}
                    {{ product.title }}
                  {% endif %}
                </h3>
                <h5 class="description gray-f mx-0 f-f-regular">Active noise cancellation over earheadphones.</h5>
                <div class="promotion-price">
                    <h4 class="original-price mx-0 f-f-bold">{{ product.selected_or_first_available_variant.price | money }}</h4>
                    <h5 class="compare-price mx-0">{{ product.selected_or_first_available_variant.compare_at_price | money }}</h5>
                </div>
            </div>
            <div class="col_25 right-content">
                <a href="{{ product.url }}" class="promotion-buy-now-btn p">
                    <svg class="cart-icon" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21">
                        <g transform="translate(0.72 0.889)">
                            <rect fill="none" width="21" height="21" transform="translate(-0.72 -0.889)" />
                            <path d="M28.863,36.251H20.119L17.983,24.505a.613.613,0,0,0-.6-.505H16" transform="translate(-15.021 -22.422)" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                            <circle cx="1.248" cy="1.248" r="1.248" transform="translate(5.038 13.829)" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                            <circle cx="1.248" cy="1.248" r="1.248" transform="translate(12.716 13.829)" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                            <path d="M49.11,70.125h9.617a1.217,1.217,0,0,0,1.2-1L60.863,64H48" transform="translate(-44.571 -59.359)" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                        </g>
                    </svg>
                    Buy Now
                </a>
               {% assign product_form_id = 'quick-add-' | append: section.id | append: product.id %}
                <div class="quick-add no-js-hidden add-to-cart-btn">
                    <product-page-form data-section-id="{{ section.id }}">
                        {%- form 'product', product, id: product.id, class: 'form add_cart_form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id" {% if product.selected_or_first_available_variant.available == false %} disabled {% endif %}>
                        <button id="{{ product_form_id }}-submit" type="submit" name="add" class="quick-add__submit " aria-haspopup="dialog" aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product.id }}" aria-live="polite" data-sold-out-message="true" {% if product.selected_or_first_available_variant.available == false %} disabled {% endif %}>
                            <span class="hidden">
                                {%- if product.selected_or_first_available_variant.available -%}
                                {{ 'products.product.add_to_cart' | t }}
                                {%- else -%}
                                {{ 'products.product.sold_out' | t }}
                                {%- endif -%}
                            </span>
                            <span class="sold-out-message hidden">
                                {{ 'products.product.sold_out' | t }}
                            </span>
                            {%- if horizontal_quick_add -%}
                            <span class="icon-wrap hidden">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                            </span>
                            {%- endif -%}
                            
                 
                            <span class="promotion-add-to-cart-btn p">Add To Cart</span>
                            {%- render 'loading-spinner' -%}
                        </button>
                        {%- endform -%}
                    </product-page-form>
                </div>               
            </div>
        </div>
    </div>
    
</div>