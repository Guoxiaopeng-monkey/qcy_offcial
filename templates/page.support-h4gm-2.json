    "faq-detailed": {
      "type": "faq-detailed",
      "blocks": {
        "bluetooth_connection_cWnr8r": {
          "type": "bluetooth-connection",
          "settings": {
            "question": "How to pair H3?",
            "answer": "1. Press and hold the Multi-Funtion Button for 2 seconds to power on, the headphones will enter pairing mode automatically.\n2. Turn on Bluetooth on your device.\n3. Select \"QCY H3\" from the available device list."
          }
        },
        "bluetooth_connection_jBLBhH": {
          "type": "bluetooth-connection",
          "settings": {
            "question": "What can I do if my headphones won't connect to my device?",
            "answer": "1. Clear the pairing records between the headphones and all of the previous devices. \n2. Re-pair your headphones and the device.\n\nIf that doesn’t work:\n- Try pairing with another device to check for compatibility issues.\n- Ensure there are no objects blocking the Bluetooth signal."
          }
        },
        "bluetooth_connection_8U66tH": {
          "type": "bluetooth-connection",
          "settings": {
            "question": "How can I enable multipoint connection?",
            "answer": "To connect two devices:\nStep 1. Pair the headphones with device A.\nStep 2. Disable Bluetooth on device A, and the headphones will enter pairing mode.\nStep 3. Pair the headphone with device B.\nStep 3. Re-enable Bluetooth on device A and reconnect to the headphones.\n\nAfter this initial setup, the headphones will automatically connect to both devices next time."
          }
        },
        "bluetooth_connection_w4wqWb": {
          "type": "bluetooth-connection",
          "settings": {
            "question": "How to reset headphones?",
            "answer": "To reset H3:\n1. Press and hold both VOL+ and VOL- buttons for 10 seconds\n2. The headphones' LED will flash red 3 times, indicating a successful reset."
          }
        },
        "battery_charging_BzAgpk": {
          "type": "battery-charging",
          "settings": {
            "question": "My headphones' battery runs out too quickly. What can I do?",
            "answer": "To get more battery life from your headphones, try these tips:\n- Lower the volume.\n- Turn off ANC \n- Disable smart features and Spatial Audio.\n- Power off the headphones when you're not using them."
          }
        },
        "app_control_wEAdG4": {
          "type": "app-control",
          "settings": {
            "question": "Why does the QCY app ask for location access?",
            "answer": "The app itself doesn’t normally need location access. However, when Bluetooth Low Energy (BLE) is used to find your earbuds, Android requires location permission.\nIf you prefer not to share your location, close the app and try pairing again."
          }
        },
        "app_control_qyeyxU": {
          "type": "app-control",
          "settings": {
            "question": "What should I do if my earbuds are not found on the QCY App?",
            "answer": "1. Pair the earbuds with your phone.\n2. Open the QCY app, scroll to the bottom, and click \"Add Devices.\"\n3. If \"H3 Pro\" pops up, select it to connect.\n4. If not, click \"Set Up Manually\" and choose \"H3 Pro\" from the list to connect."
          }
        },
        "sound_anc_RmMjNH": {
          "type": "sound-anc",
          "settings": {
            "question": "What can I do if the volume is low when connecting to my phone?",
            "answer": "Try to re-pair your headphones: Clear the pairing records on your phone, then re-pair the earbuds to your device."
          }
        },
        "sound_anc_EwCNkw": {
          "type": "sound-anc",
          "settings": {
            "question": "Why can't the person on the other end of the call hear me, or why is my voice unclear?",
            "answer": "We recommend trying the following steps:\n\n\n- Verify that the audio output device on your phone is set to \"QCY H3\"\n\n- If you're making the call through an app, try making a direct call using your phone's regular calling feature to check if the issue persists.\n\n- Test your earbuds with a different Bluetooth device in a different environment to see if the problem improves."
          }
        },
        "sound_anc_aPKtMM": {
          "type": "sound-anc",
          "settings": {
            "question": "What can I do if the headphones have poor sound quality?",
            "answer": "You can try the following troubleshooting steps:\n\n- Check the audio source: Test different types of music and make sure the audio source is clear and free of distortion or noise.\n\n- Customize the EQ settings: Use the QCY app to try different EQ modes or customize the sound profile to suit your preferences."
          }
        },
        "sound_anc_aegt3G": {
          "type": "sound-anc",
          "settings": {
            "question": "What is adaptive noise canceling?",
            "answer": "Real-time monitoring of changes in the environment and audio leakage to adjust noise-cancellation capabilities. With adaptive noise canceling, you can experience the optimal effect of noise reduction and maximum tranquility. Please note that this feature is off by default and can be enabled via the QCY app."
          }
        },
        "care_others_BFPLg9": {
          "type": "care-others",
          "settings": {
            "question": "How do I update the firmware?",
            "answer": "Update the fireware on the QCY App, Before updating:\n1. Ensure your headphones have at least 20% battery.\n2. Make sure both earbuds are connected to the QCY app.\n3. Don’t use the earbuds during the update.\n4. Keep the earbuds in the charging case with the lid open."
          }
        },
        "bluetooth_connection_NApiLG": {
          "type": "bluetooth-connection",
          "settings": {
            "question": "What's the difference between connecting the H3 Pro via AUX cable and using Bluetooth?",
            "answer": "There is no microphone on the supplied AUX cable, but you can use the microphone on the connected device while using QCY H3 in AUX mode."
          }
        }
      },
