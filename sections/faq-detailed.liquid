<section class="faq" data-anchor="faq">
    <div class="page-width section-content">
        <div class="row">
            <div class="col-lg-10 col-md-12 col-sm-12 ms-auto text-center">
                <h2 class="title">
                    {{ section.settings.title }}
                </h2>
                <div class="toggles">

                    {% assign counter_1 = 0 %}
                    {% assign counter_2 = 0 %}
                    {% assign counter_3 = 0 %}
                    {% assign counter_4 = 0 %}
                    {% assign counter_5 = 0 %}
                    {% assign counter_6 = 0 %}
                    {% assign counter_7 = 0 %}
                    {% assign counter_8 = 0 %}

                    {% for block in section.blocks %}
                        {% if block.type == 'app-control' %}
                            {% assign counter_1 = counter_1 | plus: 1 %}
                        {% endif %}
                        {% if block.type == 'battery-charging' %}
                            {% assign counter_2 = counter_2 | plus: 1 %}
                        {% endif %}
                        {% if block.type == 'bluetooth-connection' %}
                            {% assign counter_3 = counter_3 | plus: 1 %}
                        {% endif %}
                        {% if block.type == 'care-others' %}
                            {% assign counter_4 = counter_4 | plus: 1 %}
                        {% endif %}
                        {% if block.type == 'software-firmware' %}
                            {% assign counter_5 = counter_5 | plus: 1 %}
                        {% endif %}
                        {% if block.type == 'sound-anc' %}
                            {% assign counter_6 = counter_6 | plus: 1 %}
                        {% endif %}
                        {% if block.type == 'watch-application' %}
                            {% assign counter_7 = counter_7 | plus: 1 %}
                        {% endif %}
                        {% if block.type == 'wearing' %}
                            {% assign counter_8 = counter_8 | plus: 1 %}
                        {% endif %}
                    {% endfor %}

                    {% if counter_1 > 0 %}
                        <span data-toggle="app-control">
                            App & Control
                        </span>
                    {% endif %}
                    {% if counter_2 > 0 %}
                        <span data-toggle="battery-charging">
                            Battery & Charging
                        </span>
                    {% endif %}
                    {% if counter_3 > 0 %}
                        <span data-toggle="bluetooth-connection">
                            Bluetooth & Connection
                        </span>
                    {% endif %}
                    {% if counter_4 > 0 %}
                        <span data-toggle="care-others">
                            Care & Others
                        </span>
                    {% endif %}
                    {% if counter_5 > 0 %}
                        <span data-toggle="software-firmware">
                            Software & Firmware
                        </span>
                    {% endif %}
                    {% if counter_6 > 0 %}
                        <span data-toggle="sound-anc">
                            Sound & ANC
                        </span>
                    {% endif %}
                    {% if counter_7 > 0 %}
                        <span data-toggle="watch-application">
                            Watch Application
                        </span>
                    {% endif %}
                    {% if counter_8 > 0 %}
                        <span data-toggle="wearing">
                            Wearing
                        </span>
                    {% endif %}

                </div>
            </div>
            <div class="col-lg-10 col-md-12 col-sm-12 ms-auto">
                <div class="nav-toggles">
                    <div class="nav-toggle" data-toggle="app-control">
                        <div class="row">

                            <div class="col-12">
                                <div class="accordion" id="accordion-1">
                                    {% assign index_1 = 0 %}
                                    {% for block in section.blocks %}
                                        {% if block.type == 'app-control' %}
                                            {% assign index_1 = index_1 | plus: 1 %}
                                            <div class="accordion-item" data-page="{{ index_1 | minus: 1 | divided_by: 5 | plus: 1 }}">
                                                <h2 class="accordion-header" id="headingOne-{{ forloop.index }}">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne-{{ forloop.index }}" aria-expanded="false" aria-controls="collapseOne-{{ forloop.index }}">
                                                        {{ block.settings.question }}
                                                    </button>
                                                </h2>
                                                <div id="collapseOne-{{ forloop.index }}" class="accordion-collapse collapse" aria-labelledby="headingOne-{{ forloop.index }}" data-bs-parent="#accordion-howto">
                                                    <div class="accordion-body">
                                                        {{ block.settings.answer | newline_to_br }}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>

                            {% if counter_1 > 5 %}

                                {% assign items_per_page = 5 %}
                                {% assign total_items = counter_1 %}
                                {% assign total_pages = total_items | divided_by: items_per_page %}
                                {% assign remainder = total_items | modulo: items_per_page %}

                                {% assign page_total = total_pages %}
                                {% if remainder != 0 %}
                                    {% assign page_total = page_total | plus: 1 %}
                                {% endif %}

                                <div class="paginate custom" data-total="{{ page_total }}">
                                    <a class="page disable" href="javascript:void(0)">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </a>

                                    {% if remainder != 0 %}
                                        {% assign total_pages = total_pages | plus: 1 %}
                                    {% endif %}

                                    {% for i in (1..total_pages) %}
                                        <a class="page {% if i == 1 %}active{% endif %}" href="javascript:void(0)" data-i="{{ i }}">{{ i }}</a>
                                    {% endfor %}

                                    <a class="page" href="javascript:void(0)" data-i="2">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </a>
                                </div>
                            {% endif %}
                        </div>

