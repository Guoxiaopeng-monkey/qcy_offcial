                {{ block.settings.sub_heading }}
              </h2>
              <h2
                class="heading-font-size {{ block.settings.heading_weight }} mx-0"
                data-aos="fade-up"
                data-aos-easing="ease"
                data-aos-duration="600"
                data-aos-once="true"
                style="--base-heading-font-size: {{ block.settings.heading_font_size }}px; --color:{{ block.settings.heading_color }};--base-heading-font-size-mb: {{ block.settings.heading_font_size_mb }}px; --color-mb:{{ block.settings.heading_color_mb }};"
