<style>
  .homepage-section {
    background-color: #202020;
    position: relative;
  }
  .hide-announcement .homepage-section {
    height: 100vh;
  }
  .homepage-section .inner-container-section {
    overflow: hidden;
    height: 100%;
    display: flex;
  }
  .banner-item.slick-slide {
    position: relative;
  }
  .banner-item.video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner-item.image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner-item.countdown img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text-container {
    overflow: hidden;
  }
  .banner-item .h3 {
    transition: opacity 0.3s cubic-bezier(0.26, 0.54, 0.32, 1), transform 0.5s cubic-bezier(0.26, 0.54, 0.32, 1);
  }
  .banner-item .heading {
    transition: opacity 0.3s cubic-bezier(0.26, 0.54, 0.32, 1), transform 0.9s cubic-bezier(0.26, 0.54, 0.32, 1);
  }
  .banner-item .h4,
  .banner-item .sub__heading {
    transition: opacity 0.3s cubic-bezier(0.26, 0.54, 0.32, 1), transform 1.2s cubic-bezier(0.26, 0.54, 0.32, 1);
    width: fit-content;
  }
  .banner-item a.btn {
    transition: all 0.3s ease;
    width: fit-content;
    display: block;
    background-color: #ff8832;
    padding: 1.2rem 3rem;
    border-radius: 30px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .banner-item a.btn h5 {
    display: flex;
    gap: 1rem;
    align-items: center;
    transition: all 0.3s ease;
    transform: translateX(10px);
  }
  .banner-item a.btn i {
    transition: all 0.3s ease;
    opacity: 0;
  }
  .banner-item a.btn h5 img {
    filter: invert(1);
    object-fit: contain;
    transition: all 0.3s ease;
    opacity: 0;
  }
  .banner-item a.btn:hover i {
    opacity: 1;
  }
  .banner-item a.btn:hover h5 {
    transform: translateX(0px);
  }
  .banner-item .h3,
  .banner-item h1,
  .banner-item .heading,
  .banner-item .h4,
  .banner-item .sub__heading,
  .banner-item a.btn {
    opacity: 0;
    transform: translatey(120px);
  }
  .banner-item.swiper-slide-active .h3,
  .banner-item.swiper-slide-active h1,
  .banner-item.swiper-slide-active .heading,
  .banner-item.swiper-slide-active .h4,
  .banner-item.swiper-slide-active .sub__heading,
  .banner-item.swiper-slide-active a.btn {
    opacity: 1;
    transform: translatey(0px);
  }
  .homepage-content {
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
    padding: 100px 50px;
  }
  .homepage-content .page-width {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .homepage-content a {
    margin-top: 2rem;
  }
  .homepage-section .swiper-pagination {
    display: flex;
    justify-content: center;
    gap: 1rem;
    bottom: 40px;
  }
  .homepage-section .swiper-pagination .swiper-pagination-bullet {
    width: 1.2rem;
    height: 1.2rem;
    background: transparent !important;
    border: 1px solid #fff;
    opacity: 1 !important;
  }
  .homepage-section .swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active {
    background: #fff !important;
    border-color: #fff;
  }
  .homepage-section .swiper-button-next:after,
  .homepage-section .swiper-button-prev:after {
    display: none !important;
  }
  .homepage-section .swiper-button-next,
  .homepage-section .swiper-button-prev {
    position: absolute;
    width: fit-content;
    height: fit-content;
    margin: 0px;
    transition: all 0.5s ease;
    background-image: unset;
    background: #dbdbdb66;
    border-radius: 50px;
    opacity: 1;
    transition: all 0.3s ease;
  }
  .homepage-section .swiper-button-next:hover,
  .homepage-section .swiper-button-prev:hover {
    background: #ff8832;
  }
  .homepage-section .slider-arrows {
    position: absolute;
    top: 50%;
    width: 100%;
    height: fit-content;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0px;
    flex-direction: row-reverse;
    z-index: 1;
  }
  .homepage-section .swiper-button-next {
    right: 2%;
  }
  .homepage-section .swiper-button-prev {
    left: 2%;
  }
  .vertical-line {
    height: 60px;
    width: 1px;
    background: #ffffff7d;
    position: relative;
    z-index: 1;
    display: block !important;
  }

  .homepage-section .swiper-container {
    background: url(https://cdn.shopify.com/s/files/1/0630/1951/6082/files/loading-preload.gif?v=1722603712);
    background-size: 20vh;
    background-repeat: no-repeat;
    background-position: center;
  }
  .vertical-line:empty {
    display: none !important;
  }
  .homepage-section .banner-swiper-pagination {
    display: flex;
    gap: 1rem;
    justify-content: center;
    position: relative;
    top: unset;
    bottom: 50px !important;
    z-index: 1;
  }
  .homepage-section .banner-swiper-pagination .swiper-pagination-bullet {
    background: transparent;
    border-radius: 50px;
    opacity: 1;
    border: 1px solid #fff;
    width: 13px;
    height: 13px;
  }
  .homepage-section .banner-swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active {
    background: #fff;
  }
  .content-desktop-y-top {
    justify-content: flex-start;
  }
  .content-desktop-y-center {
    justify-content: center;
  }
  .content-desktop-y-bottom {
    justify-content: flex-end;
  }

  .content-desktop-x-left {
    align-items: flex-start;
  }
  .content-desktop-x-center {
    align-items: center;
  }
  .content-desktop-x-right {
    align-items: flex-end;
  }

  .banner-item.countdown .day-box,
  .banner-item.countdown .hour-box,
  .banner-item.countdown .minutes-box,
  .banner-item.countdown .second-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .banner-item.countdown .day-box span,
  .banner-item.countdown .hour-box span,
  .banner-item.countdown .minutes-box span,
  .banner-item.countdown .second-box span {
    background-color: #fff;
    padding: 1rem 1.5rem;
    border-radius: 4px;
    position: relative;
  }
  .banner-item.countdown .day-box span:before,
  .banner-item.countdown .hour-box span:before,
  .banner-item.countdown .minutes-box span:before {
    content: ':';
    color: #fff;
    position: absolute;
    right: -48%;
  }
  .count-down-container {
    display: flex;
    flex-direction: column;
    padding-top: 30px;
    gap: 1.5rem;
  }
  .count-down-list {
    display: flex;
    gap: 50px;
  }

  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
    .homepage-content {
      width: 90%;
      left: 0;
