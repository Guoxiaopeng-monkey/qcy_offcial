                style="--base-description-font-size: {{ block.settings.description_font_size }}px; --color:{{ block.settings.description_color }};--base-description-font-size-mb: {{ block.settings.description_font_size_mb }}px; --color-mb:{{ block.settings.description_color_mb }};"
              >
                {{ block.settings.description | strip_html }}
              </div>
              <a
                href="{{ block.settings.url }}"
                class="btn s-main f-f-regular p white-f "
                style="background-color:{{ block.settings.btn_bg_color }}"
              >
                <h5 class="mx-0 text-up">{{ block.settings.btn_heading }}</h5>
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        {% endif %}
        {% if block.settings.content_display %}</a>{% else %}</div>{% endif %}
      {% else %}
