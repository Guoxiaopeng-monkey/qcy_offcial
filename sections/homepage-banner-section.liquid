<div class="swiper-container inner-container-section">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      {% if block.type == 'Banner_Video' %}
        <div class="swiper-slide banner-item video">
          <video
            autoplay
            loop
            muted
            playsinline
            {% if block.settings.bg_video_mobile != blank %}
              class="h-desktop"
            {% endif %}
          >
            <source src="{{ block.settings.bg_video.sources[1].url }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
          {% if block.settings.bg_video_mobile != blank %}
            <video autoplay loop muted playsinline class="h-mobile">
              <source src="{{ block.settings.bg_video_mobile.sources[1].url }}" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          {% endif %}
          {% if block.settings.content_display %}
          {% else %}
            <div
              class="homepage-content "
              {% if block.settings.overlay %}
                style="background-color:rgb(0 0 0 / {{ block.settings.overlay_opacity }}%)"
              {% endif %}
            >
              <div class="page-width {{ block.settings.content_position_y }}  {{ block.settings.content_position_x }} {{ block.settings.content_position_y_mobile }}">
                <div
                  class="sub-heading-font-size m-0 {{ block.settings.sub_heading_weight }}"
                  style="--base-sub-heading-font-size: {{ block.settings.sub_heading_font_size }}px; --color:{{ block.settings.sub_heading_color }};--base-sub-heading-font-size-mb: {{ block.settings.sub_heading_font_size_mb }}px; --color-mb:{{ block.settings.sub_heading_color_mb }};"
                >
                  {{ block.settings.sub_heading | strip_html }}
                </div>
                <h2
                  class="heading-font-size t-up {{ block.settings.heading_weight }} m-0 text-lg f-f-extra-bold mx-0"
                  style="--base-heading-font-size: {{ block.settings.heading_font_size }}px; --color:{{ block.settings.heading_color }};--base-heading-font-size-mb: {{ block.settings.heading_font_size_mb }}px; --color-mb:{{ block.settings.heading_color_mb }};"
                >
                  {{ block.settings.heading }}
                </h2>
                <div
                  class="description-font-size {{ block.settings.description_weight }} m-auto-r-l "
                  style="--base-description-font-size: {{ block.settings.description_font_size }}px; --color:{{ block.settings.description_color }};--base-description-font-size-mb: {{ block.settings.description_font_size_mb }}px; --color-mb:{{ block.settings.description_color_mb }};"
                >
                  {{ block.settings.description | strip_html }}
                </div>
                <a
                  href="{{ block.settings.url }}"
                  class="btn s-main f-f-regular p white-f "
                  style="background-color:{{ block.settings.btn_bg_color }}"
                >
                  <h5 class="mx-0 text-up">{{ block.settings.btn_heading }}</h5>
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          {% endif %}
        </div>

      {% elsif block.type == 'Banner_Image' %}
        {% if block.settings.content_display -%}
          <a href="{{ block.settings.url }}" class="swiper-slide banner-item image">
        {%- else %}
          <div class="swiper-slide banner-item image">
        {% endif %}
        {% if template.name == 'index' %}
          <img
            loading="lazy"
            src="{{ block.settings.image | img_url: 'master' }}"
            alt="{{ block.settings.image.alt | default: block.settings.image.src | split: '/' | last | split: '?' | first | split: '.' | first | escape }}"
            {% if block.settings.bg_image != blank %}
              class="h-desktop"
            {% endif %}
            width="100%"
            height="auto"
          >
        {% else %}
          <img
            loading="lazy"
            src="{{ block.settings.image | img_url: 'master' }}"
            alt="{{ block.settings.image.alt | default: block.settings.image.src | split: '/' | last | split: '?' | first | split: '.' | first | escape }}"
            {% if block.settings.bg_image != blank %}
              class="h-desktop"
            {% endif %}
            width="100%"
            height="auto"
          >
        {% endif %}
        {% if block.settings.bg_image != blank %}
