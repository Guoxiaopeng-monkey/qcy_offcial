                >
                  {{ block.settings.description | replace: '<p>', '' | replace: '</p>', '' }}
                </h4>
                {% if block.settings.countdown_display %}
                  <div class="count-down-list">
                    <div class="day-box">
                      <span
                        class="day-sec text-sm f-f-medium mx-0 center"
                        style="color:{{ block.settings.secondary_color }};"
                        >00</span
                      >
                      <p class="mx-0 f-f-regular center" style="color: {{ block.settings.primary_color }};">Days</p>
                    </div>
                    <div class="hour-box">
                      <span
                        class="hour-sec text-sm f-f-medium mx-0 center"
                        style="color:{{ block.settings.secondary_color }};"
                        >00</span
                      >
                      <p class="mx-0 f-f-regular center" style="color: {{ block.settings.primary_color }};">Hours</p>
                    </div>
                    <div class="minutes-box">
                      <span
                        class="minute-sec text-sm f-f-medium mx-0 center"
                        style="color:{{ block.settings.secondary_color }};"
                        >00</span
                      >
                      <p class="mx-0 f-f-regular center" style="color: {{ block.settings.primary_color }};">Minutes</p>
                    </div>
                    <div class="second-box">
                      <span
                        class="second-sec text-sm f-f-medium mx-0 center"
                        style="color:{{ block.settings.secondary_color }};"
                        >00</span
                      >
                      <p class="mx-0 f-f-regular center" style="color: {{ block.settings.primary_color }};">Seconds</p>
                    </div>
                  </div>
                {% endif %}
              </div>

              <a
