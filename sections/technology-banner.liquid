{% style %}
    .technology-banner-section{
        {% if section.settings.adapt_bg_image_size %}
        {% else %}
            height:60vh;
        {% endif %}
        position:relative;
    }
    .technology-banner-section .background-img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .technology-banner-section .text-container{
        position:absolute;
        top:0;
        left:0;
        width:100%;
        height:100%;
    }
    .technology-banner-section .description p a{
        text-decoration: underline;
        text-decoration-color: #FF8832;
        text-underline-offset: 3px;
        text-decoration-thickness: 3px;
    }
    /* MOBILES ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 0px) {
        .technology-banner-section .description p{
            font-size:16px;
        }
    }
    @media only screen and (min-width: 375px) {
        .technology-banner-section .description p{
            font-size:16px;
        }
    }
    @media only screen and (min-width: 390px) {
        .technology-banner-section .description p{
            font-size:18px;
        }
    }
    @media only screen and (min-width: 414px) {
        .technology-banner-section .description p{
            font-size:18px;
        }
    }
    @media only screen and (min-width: 428px) {
        .technology-banner-section .description p{
            font-size:18px;
        }
    }
    @media only screen and (min-width: 480px) {
        .technology-banner-section .description p{
            font-size:18px;
        }
    }
    
    /* TABLETS ----------------------------------------------------------------------------------- */
    
    @media only screen and (min-width: 768px) {
        .technology-banner-section .description p{
            font-size:18px;
        }
    }
    
    
    /* LAPTOPS --------------------------------------------------------------------------------- */
    
    @media only screen and (min-width: 1280px) {
        .technology-banner-section .description p{
            font-size:16px;
        }
    }
    @media only screen and (min-width: 1366px) {
        .technology-banner-section .description p{
            font-size:16px;
        }
    }
    @media only screen and (min-width: 1440px) {
        .technology-banner-section .description p{
            font-size:16px;
        }
    }
    @media only screen and (min-width: 1536px) {
        .technology-banner-section .description p{
            font-size:16px;
        }
    }
    @media only screen and (min-width: 1600px) {
        .technology-banner-section .description p{
            font-size:18px;
        }
    }
    
    /* COMPUTERS --------------------------------------------------------------------------------- */
    @media only screen and (min-width: 1920px) {
        .technology-banner-section .description p{
            font-size:18px;
        }
    }
    @media only screen and (min-width: 2560px) {
        .technology-banner-section .description p{
            font-size:18px;
        }
    }
{% endstyle %}
<img src="{{ section.settings.background_image_desktop | img_url: 'master' }}" width="100%" height="100%" class="background-img d-lg-block d-md-block d-sm-none">
<img src="{{ section.settings.background_image_mobile | img_url: 'master' }}" width="100%" height="100%" class="background-img d-lg-none d-md-none d-sm-block">
<div class="text-container d-flex justify-content-center align-items-center">
    <div class="container">
        {% if section.settings.display_heading %}
            <h2 class="f-f-bold white-f text-center text-lg my-4" data-aos="fade-up" data-aos-easing="ease" data-aos-duration="500" data-aos-once="true" data-aos-delay="200">
                {% if section.settings.custom_heading != blank %}
                {{ section.settings.custom_heading }}
                {% else %}
                {{ page.title }}
                {% endif %}
            </h2>
        {% endif %}
        {% if section.settings.display_description %}
        <div class="description white-f f-f-regular text-center h4 d-lg-block d-md-block d-sm-none col-lg-7 col-md-10 col-sm-12 mx-auto my-0 px-lg-3 px-md-0 px-sm-0 " data-aos="fade-up" data-aos-easing="ease" data-aos-duration="500" data-aos-once="true" data-aos-delay="250">
            {{ page.metafields.custom.description | metafield_tag }}
        </div>
        <div class="description white-f f-f-light text-center h3 d-lg-none d-md-none d-sm-block  col-lg-7 col-md-10 col-sm-12 mx-auto my-0" data-aos="fade-up" data-aos-easing="ease" data-aos-duration="500" data-aos-once="true" data-aos-delay="250">
            {{ page.metafields.custom.description | metafield_tag }}
        </div>
        {% endif %}
    </div>
</div>
{% schema %}
    {
        "class": "technology-banner-section",
        "name": "Technology Banner",
        "templates": ["page"],
        "settings": [
            {
                "type": "checkbox",
                "id": "display_heading",
                "label": "Display Heading",
                "default": true
            },
            {
                "type": "checkbox",
                "id": "display_description",
                "label": "Display Description",
                "default": true
            },
            {
                "type": "checkbox",
                "id": "adapt_bg_image_size",
                "label": "Adapt Background Image Size",
                "default": false
            },
            {
                "type": "image_picker",
                "id": "background_image_desktop",
                "label": "Background Image - Desktop"
            },
            {
                "type": "image_picker",
                "id": "background_image_mobile",
                "label": "Background Image - Mobile"
            },
            {
                "type": "text",
                "id": "custom_heading",
                "label": "Custom Heading",
                "info": "If the input field is empty, the heading will use the page title."
            }
        ]
    }
{% endschema %} 