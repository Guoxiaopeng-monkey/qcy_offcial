<style>
    #shopify-section-{{ section.id }}{
      background-color:{{ section.settings.background }};
    }
    .collection-banner-list-container{
      display:flex;
      flex-direction:column;
      gap:30px;
      padding-top:50px;
    }
    .collection-banner-row{
      display:flex;
      gap:30px;
    }
    .collection-banner-row .collection-banner-item{
      display:flex;
      position:relative;
      cursor:pointer;
      overflow:hidden;
      border-radius:10px;
    }
    .collection-banner-row .collection-banner-item:hover img{
      scale:1.2;
    }
    .collection-banner-row .collection-details h4:after{
      content: "";
      width: 100%;
      height: 2px;
      background-color: #FF8832;
      border-radius: 50px;
      opacity: 0;
      transition: all 0.3s ease;
      display: block;
      position: relative;
      bottom: 0px;
    }
    .collection-banner-row .collection-details h4:hover:after{
      opacity: 1;
    }
    .collection-banner-row .collection-banner-item .collection-details{
      position:absolute;
      bottom:2rem;
      padding:0px 3rem;
    }
    .collection-banner-row .collection-banner-item img{
      width:100%;
      height:100%;
      object-fit:cover;
      transition: all 0.5s ease;
    }
  
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
      .collection-banner-row{
          flex-direction: column;
      }
      .collection-banner-list-container{
        padding-top:30px;
      }
      .collection-banner-row .collection-banner-item .collection-details h4{
        font-size:16px;
      }
    }
    
    /* ipad Air */
    @media only screen 
        and (min-device-width : 768px) 
        and (max-device-width : 1024px){
        .collection-banner-row{
            flex-direction: column;
        }
        .collection-banner-list-container{
          padding-top:30px;
        }
        .collection-banner-row .collection-banner-item .collection-details h4{
          font-size:16px;
        }
    }
</style>
<div class="page-width">
    <h2 class="heading section-heading black-f f-f-bold mx-0 center">{{ section.settings.heading }}</h2>
    <div class="collection-banner-list-container">
      <div class="collection-banner-row">
          {% for block in section.blocks %}
            {% if forloop.index == 1 or forloop.index == 2 %}
              <a href="{{ block.settings.collection.url }}" class="collection-banner-item">
                <img loading="lazy" src="{{ block.settings.featured_image | img_url: 'master' }}" width="100%" height="100%"
                {% if block.settings.featured_image_mobile != blank %}
                  class="h-desktop"
                {% endif %}
                >
                {% if block.settings.featured_image_mobile != blank %}
                  <img loading="lazy" src="{{ block.settings.featured_image_mobile | img_url: 'master' }}" width="100%" height="100%" class="h-mobile">
                {% endif %}
                <div class="collection-details">
                  <h4 class="text-sm mx-0 f-f-semibold white-f">
                    {% if block.settings.custom_label != blank %}
                      {{ block.settings.custom_label }}
                    {% else %}
                      {{ block.settings.collection.title }}
                    {% endif %}
                  </h4>
                </div>
              </a>
            {% endif %}
          {% endfor %}
      </div>
      <div class="collection-banner-row">
        {% for block in section.blocks %}
          {% if forloop.index == 3 %}
              <a href="{{ block.settings.collection.url }}" class="collection-banner-item">
                <img src="{{ block.settings.featured_image | img_url: 'master' }}" width="100%" height="100%"
                {% if block.settings.featured_image_mobile != blank %}
                  class="h-desktop"
                {% endif %}
                >
                {% if block.settings.featured_image_mobile != blank %}
                  <img src="{{ block.settings.featured_image_mobile | img_url: 'master' }}" width="100%" height="100%" class="h-mobile">
                {% endif %}
                <div class="collection-details">
                  <h4 class="text-sm mx-0 f-f-semibold white-f">
                    {% if block.settings.custom_label != blank %}
                      {{ block.settings.custom_label }}
                    {% else %}
                      {{ block.settings.collection.title }}
                    {% endif %}
                  </h4>
                </div>
              </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  
</div>
{% schema %}
  {
      "class": "collection-banner",
      "name": "Collection List Banner",
      "templates": ["page"],
      "max_blocks": 3,
      "settings": [
          {
              "type": "text",
              "id": "heading",
              "label": "Heading",
              "default":"Explore Our Exclusive Collection"
          },
          {
              "type": "color",
              "id": "background",
              "label": "Background",
              "default":"#fff"
          },
          {
              "type": "color",
              "id": "primary_color",
              "label": "Primary Color",
              "default":"#1a1a1a"
          }
    ],
    "blocks": [
        {
            "type": "collection",
            "name": "Collection",
            "settings": [
                {
                    "type": "collection",
                    "id": "collection",
                    "label": "Collection"
                },
                {
                    "type": "image_picker",
                    "id": "featured_image",
                    "label": "Featured Image"
                },
                {
                    "type": "image_picker",
                    "id": "featured_image_mobile",
                    "label": "Featured Image - Mobile"
                },
                {
                    "type": "text",
                    "id": "custom_label",
                    "label": "Custom Label"
                }
            ]
        }
    ],
      "presets" :[{
          "name" : "Collection List Banner"
      }]
  }
{% endschema %} 