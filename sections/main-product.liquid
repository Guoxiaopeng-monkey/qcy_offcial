                           height="24">
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </div>
           {% endif %}                                         
          <a href="{{ product.url }}" class="link product__view-details animate-arrow">
            {{ 'products.product.view_full_details' | t }}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </a>
                                                        
          <div class="support-center-section h-g-mobile">
            <div class="support-center-item" support-index="1">
            
              <img loading="lazy" src="{{ section.settings.support_Icon_1 |  img_url: 'master' }}" class="support-icon-img">
              <p class="mx-0 text-small center f-f-semibold line-height-normal">{{ section.settings.support_heading_1 }}</p>
            </div>
                    
            <div class="support-center-item" support-index="2">
              <img loading="lazy" src="{{ section.settings.support_Icon_2 |  img_url: 'master' }}" class="support-icon-img">
              <p class="mx-0 text-small center f-f-semibold line-height-normal">{{ section.settings.support_heading_2 }}</p>
            </div>
                    
            <div class="support-center-item" support-index="3">
              <img loading="lazy" src="{{ section.settings.support_Icon_3 |  img_url: 'master' }}" class="support-icon-img">
              <p class="mx-0 text-small center f-f-semibold line-height-normal">{{ section.settings.support_heading_3 }}</p>
            </div>

            <div class="support-center-item"  support-index="4">
              <img loading="lazy" src="{{ section.settings.support_Icon_4 |  img_url: 'master' }}" class="support-icon-img">
              <p class="mx-0 text-small center f-f-semibold line-height-normal">{{ section.settings.support_heading_4 }}</p>
            </div>
          </div>
        </section>
      </div>
    </div>

    {% render 'product-media-modal', variant_images: variant_images %}

    {% assign popups = section.blocks | where: 'type', 'popup' %}
    {%- for block in popups -%}
      <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
        <div
          role="dialog"
          aria-label="{{ block.settings.text }}"
          aria-modal="true"
