{% javascript %}
function actionMoreLess(){
    var boxOuter = ".data_more_less",
        boxInner = ".data_more_less_inner",
        boxBody = ".data_more_less_body",
        showMore = $(".action_more"),
        showLess = $(".action_less");
        
    $(boxInner).each(function(){
        var $this = $(this),
            bodyDataH = $this.find(boxBody).height();
        
        // Set the initial height to 80px
        $this.css("max-height", "100%");
        
        if(bodyDataH > 80){
            $this.closest(boxOuter).addClass("less_active").removeClass("action_disabled");
        } else {
            $this.closest(boxOuter).addClass("action_disabled");
        }
    });
    
    showLess.click(function(e){
        e.preventDefault();
        var $this = $(this);
        
        // Set the max-height back to 80px when 'show less' is clicked
        $this.closest(boxOuter).removeClass("less_active").find(boxInner).css("max-height", "80px");
    });
    
    showMore.click(function(e){
        e.preventDefault();
        var $this = $(this);
        
        // Set max-height to 100% (show all content) when 'show more' is clicked
        $this.closest(boxOuter).addClass("less_active").find(boxInner).css("max-height", "none");
    });
}

actionMoreLess();


  $('.support-center-section').each(function(){
      var $container = $(this); 

      $container.find('.support-center-item').click(function(){
          var supportIndex = $(this).attr('support-index');
          console.log(supportIndex); 
          $('.support-model').addClass('show');
          $('.support-model-content-box[support-index="'+ supportIndex +'"]').addClass('active');
      });
    
  });
  $('.support-model.show').click(function(){
    console.log('here');
  })
  $('.support-model-content-box .support-close').click(function(){
          $('.support-model').removeClass('show');
          $('.support-model-content-box').removeClass('active');
  })

    $('.copy-discount-section').on('click', function() {
        var codeToCopy = $(this).attr('data-discount-code');
        var $tempTextarea = $('<textarea>');
        $('body').append($tempTextarea);
        $tempTextarea.val(codeToCopy).select();
        try {
            var successful = document.execCommand('copy');
            var msg = successful ? 'Code copied successfully!' : 'Failed to copy code';
  
            alert(msg);
        } catch (err) {
        }
  
        $tempTextarea.remove();
    });
  
