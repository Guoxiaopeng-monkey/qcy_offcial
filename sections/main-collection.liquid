{{ 'collection.aio.min.js' | asset_url | script_tag }}
{% schema %}
    {
        "name": "Main Collection",
        "templates": ["collection"],
        "limit": 1, 
        "presets" :[{
            "name" : "Main Collection"
        }]
    }
  {% endschema %} 