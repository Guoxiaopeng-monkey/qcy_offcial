<style>
    .best-seller-section{
        padding:60px 0px 80px;
        position:relative;
        overflow:hidden;  

    }
    .best-seller-section .heading{
        padding-bottom:20px;
    }
    .collection-product-list-slider{ 
        overflow: hidden;
    }
    .collection-product-list-slider .swiper-wrapper{
        padding:30px 0px;
    }
    .collection-product-list-slider .product-item{
        transition: all 0.3s ease;
    }
    .collection-product-list-slider .product-item:hover{
        box-shadow: rgb(100 100 111 / 10%) 0px 7px 29px 0px;
    }
    .best-seller-slider-arrows{
        position:absolute;
        top:50%;
        left:0;
        right:0;
        margin:auto;
        width:100%;
        max-width:var(--page-width);
        padding:0px 20px;
        display:flex;
        flex-direction:row-reverse;
        justify-content: space-between;
    }
    .best-seller-slider-arrows .best-seller-button-prev, 
    .best-seller-slider-arrows .best-seller-button-next{
        background: #DBDBDB;
        border-radius: 50px;
        display: flex;
        cursor: pointer;
        z-index: 2;
        width:fit-content;
        transition: all 0.3s ease;
    }
    .best-seller-slider-arrows .best-seller-button-prev:hover, 
    .best-seller-slider-arrows .best-seller-button-next:hover{
        background: #FF8832;
    }
    .best-seller-section .page-width{
    }
    .see-all-collection {
        display:flex;
        justify-content: flex-end;
    }
    .see-all-collection a,
    .see-all-collection p{
        display:block;
        width:fit-content;
    }
    .best-seller-section .best-seller-swiper-pagination{
        display:none;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .best-seller-section{
            padding-bottom:50px;
        }
        .tab-list-container{
            justify-content: space-between;
            gap:unset;
        }
        .collection-slider .slick-list.draggable{
            padding-right:18%;
            padding-left:20px;
        }
        .explore-btn {
            display:none;
        }
        .best-seller-section  .content-heaher{
            flex-direction:column;
            align-items: center;
            justify-content: center;
        }
        .best-seller-section  .content-heaher .heading,
        .best-seller-section  .content-heaher .description{
            text-align:center;
        }
        .best-seller-section .see-all-collection{
            margin-top:20px;
            justify-content: center;
        }
        .best-seller-section .best-seller-swiper-pagination{
            display:flex;
        }
        .best-seller-section .product-image-img{
            height:150px;
        }
        .best-seller-section .collection-product-list-slider .product-title{
            font-size:15px;
        }
        .best-seller-section .collection-product-list-slider .product-short-description{
            font-size:12px;
        }
        .best-seller-section .collection-product-list-slider .original-price{
            font-size:14px;
        }
        .best-seller-section .collection-product-list-slider .compare-price,
        .best-seller-section .collection-product-list-slider .product-item .sale-tag{
            font-size:12px;
        }
        .best-seller-slider-arrows{
            padding:0px 10px;
            top:45%;
        }
        .best-seller-slider-arrows .best-seller-button-prev svg, .best-seller-slider-arrows .best-seller-button-next svg{
            width:40px;
            height:40px;
        }
        .best-seller-section .swiper-pagination-long{
            margin-top:10px;
        }
    }

    /* ipad Air */
    @media only screen 
        and (min-device-width : 768px) 
        and (max-device-width : 1024px){
        .best-seller-section{
            padding-bottom:50px;
        }
        .tab-list-container{
            justify-content: space-between;
            gap:unset;
        }
        .collection-slider .slick-list.draggable{
            padding-right:18%;
            padding-left:20px;
        }
        .explore-btn {
            display:none;
        }
        .best-seller-section  .content-heaher{
            flex-direction:column;    
            align-items: center;
            justify-content: center;
        }
        .best-seller-section  .content-heaher .heading,
        .best-seller-section  .content-heaher .description{
            text-align:center;
        }
        .best-seller-section .see-all-collection{
            margin-top:20px;    
            justify-content: center;
        }
        .best-seller-section .best-seller-swiper-pagination{
            display:flex;
        }
        .best-seller-section .product-image-img{
            height:150px;
        }
        .best-seller-section .collection-product-list-slider .product-title{
            font-size:15px;
        }
        .best-seller-section .collection-product-list-slider .product-short-description{
            font-size:12px;
        }
        .best-seller-slider-arrows{
            padding:0px 10px;
            top:45%;
        }
        .best-seller-slider-arrows .best-seller-button-prev svg, .best-seller-slider-arrows .best-seller-button-next svg{
            width:40px;
            height:40px;
        }
        .best-seller-section .swiper-pagination-long{
            margin-top:10px;
        }
    }

</style>
{{ 'component-product-variant-picker.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.aio.min.css' | asset_url | stylesheet_tag }}

{{ 'variant-button.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'custom-product-card.aio.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.aio.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-page-form.aio.min.js' | asset_url }}" defer="defer"></script>
<div class="page-width">
    <div class="content-heaher d-flex">
        <div class="col_50">
            <h2 class="heading text-md f-f-bold mx-0 h-desktop">{{ section.settings.heading }}</h2>
            <h2 class="heading text-md f-f-bold mx-0 h-mobile">{{ section.settings.heading_mobile }}</h2>
            <h4 class="description f-f-regular gray-f mx-0">{{ section.settings.description | replace: '<p>', '' | replace: '</p>', '' }}</h4>
        </div>
        <div class="col_50">
            <div class="see-all-collection">
                <a href="{{ section.settings.collection.url }}" class="" aria-label="See all products in {{ section.settings.collection.title }} collection">
                    <p class="mx-0 f-f-regular gray-f text-underline ">{{ section.settings.btn_title }}</p>
                </a>
            </div>
        </div>
    </div>
    <div class="collection-product-list-slider">
        <div class="swiper-wrapper">
            {% for product in section.settings.collection.products limit: 8 %}
                  {% render 'custom-card-product', product: product, forloop: forloop %}
            {% endfor %}
        </div>
    </div>
    
    <div class="best-seller-slider-arrows">
        <div class="best-seller-button-next" aria-label="Next product" role="button">
             <svg xmlns="http://www.w3.org/2000/svg" width="53" height="52" viewBox="0 0 53 52">
                <g id="right_normal" transform="translate(-1835 -559)">
                    <rect id="矩形_5" data-name="矩形 5" width="53" height="52" rx="5" transform="translate(1835 559)" fill="transparent"></rect>
                    <path id="路径_4" data-name="路径 4" d="M253.944,103.831a.906.906,0,0,1-.7-.3.97.97,0,0,1,.1-1.4l6.385-5.786a.748.748,0,0,0,0-1.2l-6.485-5.487a.99.99,0,0,1,1.3-1.5l6.385,5.487a2.808,2.808,0,0,1,1,2.1,2.871,2.871,0,0,1-.9,2.1l-6.385,5.786a1.85,1.85,0,0,1-.7.2Z" transform="translate(1604.091 489.128)" fill="#fff"></path>
                </g>
            </svg>
        </div>
        <div class="best-seller-button-prev" aria-label="Next product" role="button">
            <svg xmlns="http://www.w3.org/2000/svg" id="left_normal" width="53" height="52" viewBox="0 0 53 52">
                <rect id="矩形_5" data-name="矩形 5" width="53" height="52" rx="5" fill="transparent"></rect>
                <path id="路径_4" data-name="路径 4" d="M260.873,103.831a.906.906,0,0,0,.7-.3.97.97,0,0,0-.1-1.4l-6.385-5.786a.748.748,0,0,1,0-1.2l6.485-5.487a.99.99,0,0,0-1.3-1.5l-6.385,5.487a2.808,2.808,0,0,0-1,2.1,2.871,2.871,0,0,0,.9,2.1l6.385,5.786a1.85,1.85,0,0,0,.7.2Z" transform="translate(-230.909 -69.872)" fill="#fff"></path>
            </svg>
        </div>
    </div>
    <div class="best-seller-swiper-pagination swiper-pagination-long"></div>

</div>
<script src="{{ 'custom-product-card-variant.aio.min.js' | asset_url }}" defer="defer"></script>
{% schema %}
    {
      
        "class": "best-seller-section",
        "name": "Best Seller",
        "templates": ["index", "product"],
        "limit": 1, 
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Best Seller"
            },
            {
                "type": "text",
                "id": "heading_mobile",
                "label": "Heading ( Mobile )",
                "default": "You May Also Like"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p>Whether it’s fitness or commuting, QCY can meet your needs.</p>"
            },
            {
                "type": "text",
                "id": "btn_title",
                "label": "See All"
            },
            {
                "type": "collection",
                "id": "collection",
                "label": "Collection"
            }
        ],
        "presets" :[{
            "name" : "Best Seller"
        }]
    }
  {% endschema %} 