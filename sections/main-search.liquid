<script>
    
  $('.object-item-type-menu').each(function(){
      var $container = $(this); 
  
      $container.on('click', '.object-item-link', function(){
          // Remove 'active' class from all links and add to the clicked one
          $('.object-item-link').removeClass('active');
          $(this).addClass('active');
          // Hide all product grids, then show the one with the matching data-tab
          $('.tab-container').hide(); // Using .hide() instead of setting CSS
          $('.tab-container[data-tab="' + $(this).attr('data-tab') + '"]').css('display', 'block');
          console.log($(this).attr('data-tab'));
          if($(this).attr('data-tab') == 'pages' || $(this).attr('data-tab') == 'blogs'){
            $('.facets__form.main-search .facet-filters').css('display','none');
          }else{
            $('.facets__form.main-search .facet-filters').css('display','block');
          }
      });
  });
  
    var product_initialItems = 8;  // Always show 8 items initially
    var product_loadItems = 4;     // Number of items to load/hide on each click


    // Click event for Load More/Show Less button
    $('.product.view_more_btn').on('click', function(e) {
        e.preventDefault();
        console.log('here')

        // Check if we're in "Show Less" mode
        if ($(this).hasClass('showing-less')) {
            // Hide items so only 8 remain visible
            var visibleItems = $('.product-grid li.product-li:visible');
            visibleItems.slice(product_initialItems).slideUp();

            // Switch button text back to "Load More"
            $(this).removeClass('showing-less').find('span').text('Load More');
        } else {
            // Show 3 more items
            var hiddenItems = $('.product-grid li.product-li:hidden');
            hiddenItems.slice(0, product_loadItems).slideDown();

            // If all items are shown, change button to "Show Less"
            if (hiddenItems.length <= product_loadItems) {
                $(this).addClass('showing-less').find('span').text('Show Less');
            }
        }
    });

    var page_initialItems = 6;  // Always show 8 items initially
    var page_loadItems = 3;     // Number of items to load/hide on each click
  
    // Click event for Load More/Show Less button
    $('.page.view_more_btn').on('click', function(e) {
        e.preventDefault();
        console.log('here')

        // Check if we're in "Show Less" mode
        if ($(this).hasClass('showing-less')) {
            // Hide items so only 8 remain visible
            var visibleItems = $('.page-grid li.page-li:visible');
            visibleItems.slice(page_initialItems).slideUp();

            // Switch button text back to "Load More"
            $(this).removeClass('showing-less').find('span').text('Load More');
        } else {
            // Show 3 more items
            var hiddenItems = $('.page-grid li.page-li:hidden');
            hiddenItems.slice(0, page_loadItems).slideDown();

            // If all items are shown, change button to "Show Less"
            if (hiddenItems.length <= page_loadItems) {
                $(this).addClass('showing-less').find('span').text('Show Less');
            }
        }
    });

    var article_initialItems = 6;  // Always show 8 items initially
    var article_loadItems = 3;     // Number of items to load/hide on each click
  
    // Click event for Load More/Show Less button
    $('.article.view_more_btn').on('click', function(e) {
        e.preventDefault();
        console.log('here')

        // Check if we're in "Show Less" mode
        if ($(this).hasClass('showing-less')) {
            // Hide items so only 8 remain visible
            var visibleItems = $('.article-grid li.article-li:visible');
            visibleItems.slice(article_initialItems).slideUp();

            // Switch button text back to "Load More"
            $(this).removeClass('showing-less').find('span').text('Load More');
        } else {
            // Show 3 more items
            var hiddenItems = $('.article-grid li.article-li:hidden');
            hiddenItems.slice(0, article_loadItems).slideDown();

            // If all items are shown, change button to "Show Less"
            if (hiddenItems.length <= article_loadItems) {
                $(this).addClass('showing-less').find('span').text('Show Less');
            }
        }
    });

</script>
