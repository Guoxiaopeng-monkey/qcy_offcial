{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{{ 'variant-button.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'custom-product-card.aio.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.aio.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-page-form.aio.min.js' | asset_url }}" defer="defer"></script>
{% paginate search.results by 100 %}
  <div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">
    <div class="template-search__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <h1 class="h3 f-f-bold text-cap">
        {%- if search.performed -%}
          {{- 'templates.search.title' | t -}}
        {%- else -%}
          {{- 'general.search.search' | t -}}
        {%- endif -%}
      </h1>
      <div class="template-search__search">
        <main-search  
        {% if search.results_count != 0 %}
          class="col_75"
        {% else %}
         class="col_100"
        {% endif %}
          >
          <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
              <input
                class="search__input field__input"
                id="Search-In-Template"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.search' | t }}"
                >
              <label class="field__label" for="Search-In-Template">Find What You Seek</label>
              <input name="options[prefix]" type="hidden" value="last">

              <button
                type="reset"
                class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                aria-label="{{ 'general.search.reset' | t }}"
              >
                {{- 'reset-icon.svg' | inline_asset_content -}}
              </button>
              <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                <span class="svg-wrapper">
                  {{- 'search-icon.svg' | inline_asset_content -}}
                </span>
              </button>
          </form>
        </main-search>
        {% if search.results_count != 0 %}
          <div class="object-item-type-container col_25">
            <div class="object-item-type-menu">
              <p class="object-item-link mx-0 f-f-regular active" data-tab="products">Products</p>
              <p class="object-item-link mx-0 f-f-regular" data-tab="pages">Pages</p>
              <p class="object-item-link mx-0 f-f-regular" data-tab="blogs">Blogs</p>
            </div>
          </div>
        {% endif %}
      </div>
      {%- if search.performed -%}
        {%- if search.results_count == 0 and search.filters == empty -%}
          <div class="search-empty-container">
              <img loading="lazy" src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/search_2x_bbde19a3-3ee7-43e4-9c0c-d5782d88db7f.png?v=1730293690" class="search-empty-img" width="100%" height="100%">
              <div class="empty-content-description">
                <h3 class="mx-0 f-f-regular text-cap center">No results could be found</h3>
                <p class="mx-0 text-cap center">Please try again</p>
              </div>
          </div>
          <div class="search-recommendation">
            <h4 class="f-f-bold mx-0">Recommendations</h4>
            {% render 'search-recommended' %}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if search.performed -%}
        {%- if search.filters != empty -%}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            <aside
              aria-labelledby="verticalTitle"
              class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="main-search-filters"
              data-id="{{ section.id }}"
              >
              {% render 'facets',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: section.settings.filter_type,
                paginate: paginate,
                search_page: 'main-search'
              %}
            </aside>
          {%- endif -%}
        {%- endif -%}
        <div class="product-grid-container" id="ProductGridContainer">
          {%- if search.results.size == 0 and search.filters != empty -%}
            <div
              class="template-search__results collection collection--empty{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: search_url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            
          <div class="template-search__results collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}" id="product-grid" data-id="{{ section.id }}" >
            <div class="loading-overlay gradient"></div>
            {%- assign product_count = 0 -%}
            {%- assign page_count = 0 -%}
            {%- assign article_count = 0 -%}
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {%- assign product_count = product_count | plus: 1 -%}
              {% elsif item.object_type == 'page' %}
                  {%- assign page_count = page_count | plus: 1 -%}
              {% elsif item.object_type == 'article' %}
                  {%- assign article_count = article_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}

              
              <!-- Product Items -->
              {%- assign product_counter = 0 -%}
              <div class="tab-container" data-tab="products">
                <ul class="product-grid  {% if product_count == 0 %} tab-is-empty {% endif %}" role="list">
                {%- for item in search.results -%}
                  {%- if item.object_type == 'product' -%}
                    {%- assign lazy_load = false -%}
                    {%- if product_counter > 1 -%}
                      {%- assign lazy_load = true -%}
                    {%- endif -%}
                      <li class="product-li scroll-trigger animate--slide-in" style="--animation-order: {{ product_counter }}; {% if product_counter > 7 %} display:none;{% endif %}">
                        {% render 'custom-card-product', product: item %}
                      </li>
                    {%- assign product_counter = product_counter | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                
                  {% if product_count == 0 %}
                  {%- if search.results_count != 0  -%}
                    <div class="search-empty-container">
                      <img src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/search_2x_bbde19a3-3ee7-43e4-9c0c-d5782d88db7f.png?v=1730293690" class="search-empty-img" width="100%" height="100%">
                      <div class="empty-content-description">
                        <h3 class="mx-0 f-f-regular text-cap center">No results could be found</h3>
                        <p class="mx-0 text-cap center">Please try again</p>
                      </div>
                    </div>
                  {%- endif -%}
                  {%- endif -%}
  
                </ul>
                {% if product_counter > 8 %}
                    <h5 class="product view_more_btn mx-0 f-f-regular center">
                      <span>View More</span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="13.551" height="11.997" viewBox="0 0 13.551 11.997">
                        <g data-name="组 43926" stroke="#000" stroke-width=".5">
                          <path d="M.163 12.835a.566.566 0 0 1 0-.795l4.889-4.889a.923.923 0 0 0 0-1.3L.163.958A.562.562 0 0 1 .958.163l4.889 4.889a2.04 2.04 0 0 1 .6 1.447 2 2 0 0 1-.6 1.447L.958 12.835A.6.6 0 0 1 .56 13a.56.56 0 0 1-.397-.165Z" transform="rotate(90 3.975 9.275)" style="isolation:isolate"/>
