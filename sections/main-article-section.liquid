<style>
  .main-article-section{
    padding:50px 0px ;
    background-color:#FBFBFB;
    overflow:hidden;
  }
  .main-article-section .inner-article-section{
    background-color:#fff;
    padding:2rem 4rem;
  }
  @media screen and (min-width: 750px) {
    .main-article-section .article-container{
      padding:0px 3rem;
    }
  }
  .main-article-section .inner-article-section{
    display:flex;
    gap:5rem;
  }
  .main-article-section .article-upper-content{
    border-bottom: 1px solid #D7D7D7;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom:20px;
  }
  .main-article-section .article-except-container{
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .main-article-section .article-except-container .social-share{
    display: flex;
    gap: 10px; 
  }
  .main-article-section .article-except-container .social-link{
    cursor:pointer;
    display:flex;
  }
  .main-article-section .article-except-container .social-link:hover svg circle,
  .main-article-section .article-except-container .social-link:hover svg ellipse{
    fill:#FF8832 !important;
  }
  .main-article-section .article-except-container .social-link:hover svg path{
    fill:#fff !important;
    stroke:#fff;
  }
  .main-article-section .side-content{
    border-bottom: 1px solid #D7D7D7;
  }
  .main-article-section .article-main-content .article-content img{
    height:auto;
  }
  .product-article .featured-image-column img{
    height:300px;
    object-fit:contain;
  }
  .main-article-section .article-main-content {
    padding-bottom:30px;
    border-bottom: 1px solid #D7D7D7;
  }
  .main-article-section .article-main-content ul{
    list-style:inside;
    padding:0px;
  }
  .main-article-section .promotion-deals{
     margin: 16px 0px 0px;
    border-bottom: 1px solid #D7D7D7;
    padding-bottom: 24px;
    display: flex;
  }
  .main-article-section .subscription-exclusive-container{
    padding: 24px 0px;
    border-bottom: 1px solid #D7D7D7;
  }
  .main-article-section .recommended-products-container{
  }
  .main-article-section .subscription-exclusive{
    display: flex;
    flex-direction: column;
    gap:5px;
    background: #F8F8F8;
    padding: 20px;
    box-shadow: 0px 3px 6px 1px rgba(0, 0, 0, 0.12);
    border-radius: 20px;
  }
  .main-article-section .side-bar-sticky{
    position:sticky;
    top:90px;
  }
  .modal-copy-link{
    transition: visibility 0.2s ease 0.2s, opacity 0.3s ease 0.3s, transform 0.2s ease 0.4s;
    position: fixed;
    max-width: 300px;
    bottom: 30px;
    visibility: hidden;
    opacity: 0;
    background: #EEF1F3;
    display: flex;
    padding: 20px 30px;
    border-radius: 50px;
    margin: auto;
    left: 0;
    right: 0;
    justify-content: space-between;
    transform: translateY(100%);
  }
  .modal-copy-link.active{
    visibility:visible;
    opacity:1;
    transform: translateY(0);
  }
  .modal-copy-link span{
    width:20px;
    display:flex;
    cursor:pointer;
  }
  
  .article-recommended-section .recommended-article-list-container{
    padding-top:30px;
  }
  .article-recommended-section .recommended-article-list-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap:25px;
    row-gap:40px;
  }
  .article-recommended-section .recommended-article-list-container .article-featured-image{
    height:280px;
    overflow:hidden;
  }
  .article-recommended-section .recommended-article-list-container .article-featured-image img{
    object-fit:cover;
  }
  .article-recommended-section .recommended-article-list-container .article-item{
    box-shadow: 0px 3px 6px 1px rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    overflow: hidden;
    display: grid;
    grid-template-rows: 280px;
  }
  .article-recommended-section .recommended-article-list-container .article-item .article-featured-image img,
  .article-recommended-section .recommended-article-list-container .article-item .article-details .article-title{
    transition: all 0.5s ease;
  }
  .article-recommended-section .recommended-article-list-container .article-item:hover .article-featured-image img{
    scale:1.1;
  }
  .article-recommended-section .recommended-article-list-container .article-item:hover .article-details .article-title{
    color:#FF8832;
  }
  .article-recommended-section .recommended-article-list-container .article-item .article-details{
    padding: 20px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: -webkit-fill-available;
  }
  .article-recommended-section .article-except{
    padding-top: 10px;
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .subscription-exclusive .validation-checkbox{
      align-items: center;
      gap:6px;
  }
  .subscription-exclusive .validation-input p{
    font-size:10px;
    line-height:normal;
  }
  .subscription-exclusive .custom-exclusive{
     border: 1px solid #FFF0E4;
    position: relative;
    display: flex;
    align-items: center;
    border-radius:50px;
    overflow:hidden;
  }
  .subscription-exclusive .custom-exclusive input{
    width:100%;
    width: 100%;
    padding: 15px;
    border: none;
  }
  .subscription-exclusive .custom-exclusive input:focus~label,
  .subscription-exclusive .custom-exclusive input:not(:placeholder-shown)~label{
      opacity:0;
  }
  .subscription-exclusive .custom-exclusive input::placeholder{
      color:transparent;
  }
  .subscription-exclusive .custom-exclusive label{
    position:absolute;
    left:15px;
  }
  .subscription-exclusive .btn-subscript-exclusive{
    width:100%;
    background:#000;
    border-radius:50px;
    color:#fff;
    padding: 14px;
    margin-top:10px;
    border:none;
  }
  .subscription-exclusive .checkmark{
    width: 15px;
    height: 15px;
    top: 0;
    background-color: #fff;
    border: 1px solid #979797;
  }
  .subscription-exclusive .validation-input .checkmark:after{
    left: 4px;
    top: 2px;
    width: 4px;
    height: 8px;
    border-width: 0 2px 2px 0;
  }
  .recommended-product-list-container{
    display:grid;
    grid-template-columns:1fr;
    row-gap:25px;
    column-gap:10px;
    padding-top:20px;
  }
  .recommended-product-list-container .product-image-container{
    padding-top:0px;
    padding-bottom:0px;
  }
  .price-n-button .price .original-price{
    font-size:16px;
  }
  .price-n-button .price .compare-price{
    font-size:14px;
  }
  .price-n-button .learn-more-btn p{
    font-size:10px;
  }
  .main-article-section .badge-discount-banner h5{
    font-size:18px;
  }
  
  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
    .main-article-section{
      padding-top:20px;
    }
    .main-article-section .inner-article-section{
      flex-direction:column;
      gap:30px;
      padding:2rem;
    }
    .main-article-section .page-width{
      padding:0px;
    }
    .main-article-section .side-content{
      display:none;
    }
    .article-recommended-section{
      padding-bottom:20px;
      position:relative;
    }
    .article-recommended-section .recommended-article-list-container{
      grid-template-columns: 1fr;
      row-gap:0px;
    }
    .recommended-product-list-container{
      grid-template-columns: 1fr 1fr;
      gap:10px;
    }
    .main-article-section .article-main-content{
      padding-bottom:0px;
    }
    .product-article .featured-image-column img{
      height:250px;
    }
  }
  
  /* ipad Air */
  @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
    .main-article-section{
      padding-top:30px;
    }
    .main-article-section .inner-article-section{
      flex-direction:column;
      gap:30px;
    }
    .main-article-section .side-content{
      display:none;
    }
    .article-recommended-section{
      padding-bottom:20px;
      position:relative;
    }
    .article-recommended-section .recommended-article-list-container{
      grid-template-columns: 1fr;
      row-gap:0px;
    }
    .recommended-product-list-container{
      grid-template-columns: 1fr 1fr;
      gap:15px;
    }
    .main-article-section .article-main-content{
      padding-bottom:0px;
    }
    .product-article .featured-image-column img{
      height:280px;
    }
  }

  .product-article{
    background:#FCF9F6;
    border-radius:10px;
    padding:15px 45px;
    display:flex;
    gap:50px;
    align-items: center;
  }
  .product-article .featured-image-column{
    display:flex;
  }
  .product-article .featured-image-column img{
    mix-blend-mode: multiply;
  }
  .product-detail-price,
  .product-detail-buttons{
    display:flex;    
    align-items: center;
    gap:10px;
  }
  .product-detail-buttons{
    padding-top:10px;
  }
  .product-detail-buttons .add-to-cart-btn{
    background-color: #f1f1f1;
    padding: 1.2rem;
    border-radius: 50px;
    height: fit-content;
    width: fit-content;
    display: flex;
    cursor: pointer;
    border: none;
    position: relative;
    align-items: center;
    justify-content: center;
  }
  .product-detail-buttons .add-to-cart-btn:hover{
    background-color: #000;
  }
  .product-detail-buttons .add-to-cart-btn:hover svg path,
  .product-detail-buttons .add-to-cart-btn:hover svg circle{
    stroke:#fff;
  }
  .product-detail-buttons .learn-more-btn{
    border-radius: 50px;
    padding: 1.2rem 2rem;
    background-color: #f1f1f1;
    color:#000;
  }
  .product-detail-buttons .learn-more-btn:hover{
    background-color: #FF8832;
    color:#fff;
  }
  .product-detail-content{
    display:flex;
    flex-direction:column;
    gap:15px;
  }
  .main-article-section .product-detail-content ul{
    list-style: none;
    margin:0px;
    
  }
  .product-detail-content ul strong{
    font-weight:normal;
  }

  
  .mobile-blogs-slider-arrows{
      position:absolute;
      top:50%;
      left:0;
      right:0;
      margin:auto;
      width:100%;
      max-width:var(--page-width);
      padding:0px 0px;
      display:flex;
      flex-direction:row-reverse;
      justify-content: space-between;
  }
  .mobile-blogs-slider-arrows .mobile-blogs-button-prev, 
  .mobile-blogs-slider-arrows .mobile-blogs-button-next{
      background: #DBDBDB;
      border-radius: 50px;
      display: flex;
      cursor: pointer;
      z-index: 2;
      width:fit-content;
      transition: all 0.3s ease;
      position:relative;
  }
  .mobile-blogs-slider-arrows .mobile-blogs-button-prev{
    left:-15px;
  }
  .mobile-blogs-slider-arrows .mobile-blogs-button-next{
    right:-15px;
  }
  .mobile-blogs-slider-arrows .mobile-blogs-button-prev:hover, 
  .mobile-blogs-slider-arrows .mobile-blogs-button-next:hover{
      background: #FF8832;
  }

  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
    .product-article{
      flex-direction:column;
      gap:20px;
      padding: 20px 20px;
    }
    .product-detail-content{
      gap:10px;
    }
    .mobile-blogs-slider-arrows .mobile-blogs-button-prev, 
    .mobile-blogs-slider-arrows .mobile-blogs-button-next{
          background: #dbdbdb6e;
    }
    .mobile-blogs-slider-arrows .mobile-blogs-button-prev svg, 
    .mobile-blogs-slider-arrows .mobile-blogs-button-next svg{
        width:45px;
        height:45px;
    }
  }
  
  /* ipad Air */
  @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
    .product-article{
      flex-direction:column;
      gap:20px;        
      padding: 20px 20px;
    }
    .product-detail-content{
      gap:10px;
    }
    .mobile-blogs-slider-arrows .mobile-blogs-button-prev, 
    .mobile-blogs-slider-arrows .mobile-blogs-button-next{
          background: #dbdbdb6e;
    }
    .mobile-blogs-slider-arrows .mobile-blogs-button-prev svg, 
    .mobile-blogs-slider-arrows .mobile-blogs-button-next svg{
        width:45px;
        height:45px;
    }
  }

/* TABLETS  */ 
@media only screen and (min-width: 768px) {
}
 @media only screen and (min-width: 800px) {
}
@media (min-width: 1024px) and (orientation: portrait) {
}

 /* COMPUTERS */
@media (min-width: 1024px) and (orientation: landscape) {
}
@media only screen and (min-width: 1280px) {
  .main-article-section .article-container{
      padding: 0px 5rem;
  }
}
@media only screen and (min-width: 1366px) {
  .main-article-section .article-container{
      padding: 0px 5rem;
  }
}
@media only screen and (min-width: 1440px) {
  .main-article-section .article-container{
      padding: 0px 5rem;
  }
}
@media only screen and (min-width: 1536px) {
  .main-article-section .article-container{
      padding: 0px 8rem;
  }
}
@media only screen and (min-width: 1600px) {
  .main-article-section .article-container{
      padding: 0px 15rem;
  }
}
@media only screen and (min-width: 1920px) {
  .main-article-section .article-container{
      padding: 0px 20rem;
  }
}

</style>
{{ 'variant-button.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'custom-product-card.aio.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.aio.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-page-form.aio.min.js' | asset_url }}" defer="defer"></script>
<div class="page-width article-container">
  <div class="inner-article-section">
    <div class="article-upper-content col_75">
      
      <div class="breadcrumbs-list">
          <p class="mx-0 text-breadcrumb">
            <a href="{{ shop.url }}
              {%- if localization.language.iso_code == 'en' -%}
              {%- else -%}
                /{{- localization.language.iso_code -}}
              {%- endif -%}
              " class="text-breadcrumb">Home</a>
            >
            <a href="
            {%- if localization.language.iso_code == 'en' -%}
            {%- else -%}
              /{{- localization.language.iso_code -}}
            {%- endif -%}
              /pages/blogs" class="text-breadcrumb">Blog</a> 
            >
            <span class="black-f">{{ blog.title }}</span>
          </p>
      </div>
      
      <h1 class="text-md f-f-bold article-title mx-0">{{ article.title }}</h1>
      
      <div class="article-except-container">
          <h5 class="f-f-regular mx-0">{{ article.published_at | date: "%^b %d, %Y" }}</h5>
          <div class="social-share">
            {%- assign share_url = shop.url | append: article.url -%}
            <a href="https://www.facebook.com/sharer.php?u={{ share_url }}" class="social-link" target="_blank">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30">
                <circle cx="15" cy="15" r="15" style="fill:#f5f5f5"/>
