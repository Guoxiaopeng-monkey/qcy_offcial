                    <path class="c" d="M10.771 22.893c-3.102 0-4.887-1.785-4.887-4.887v-5.95c0-3.102 1.785-4.887 4.887-4.887h8.5c3.1 0 4.887 1.785 4.887 4.887v5.95c0 3.1-1.785 4.887-4.887 4.887ZM7.159 12.056v5.95c0 2.431 1.181 3.612 3.612 3.612h8.5c2.431 0 3.612-1.181 3.612-3.612v-5.95c0-2.431-1.181-3.612-3.612-3.612h-8.5c-2.431 0-3.612 1.181-3.612 3.612Z"/>
