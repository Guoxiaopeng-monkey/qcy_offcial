                    <path class="c" d="M10.5 15.033a4.405 4.405 0 1 0 4.405-4.405 4.406 4.406 0 0 0-4.405 4.405m1.548 0a2.857 2.857 0 1 1 2.857 2.858 2.86 2.86 0 0 1-2.857-2.858m7.436-3.551a1.028 1.028 0 1 1 1.029-1.029 1.03 1.03 0 0 1-1.029 1.029"/>
                  </g>
                </g>
              </svg>
            </a>
            <a href="mailto:?&subject={{ article.title | escape }}&body={{ share_url }}" class="social-link" target="_blank">
              <svg xmlns="http://www.w3.org/2000/svg" width="31" height="30" viewBox="0 0 31 30">
                <defs>
                  <style>
                    .c{isolation:isolate;fill:#484848;stroke:#484848;stroke-width:.2px}
                  </style>
                </defs>
                <g transform="translate(.479 -.031)">
                  <ellipse cx="15.5" cy="15" rx="15.5" ry="15" transform="translate(-.479 .031)" style="fill:#f5f5f5"/>
