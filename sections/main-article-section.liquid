                  </g>
                </g>
              </svg>
              </a>
              <span class="social-link copy-link" data-share-link="{{ share_url }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30">
                  <defs>
                    <style>
                      .c{isolation:isolate;fill:#484848;stroke:#484848;stroke-width:.2px}
                    </style>
                  </defs>
                  <g transform="translate(-.031 -.031)">
                    <circle cx="15" cy="15" r="15" transform="translate(.031 .031)" style="fill:#f5f5f5"/>
                    <g style="isolation:isolate">
                      <path class="c" d="M9.104 20.95a5.07 5.07 0 0 1 0-7.157.584.584 0 0 1 .822.823 3.886 3.886 0 1 0 5.51-.005.584.584 0 0 1 .825-.826 5.077 5.077 0 0 1 0 7.165 5 5 0 0 1-3.575 1.48 5.05 5.05 0 0 1-3.582-1.48Z"/>
                      <path class="c" d="M20.124 16.543a.59.59 0 0 1 0-.826 4.089 4.089 0 1 0-5.779 0 .584.584 0 0 1-.826.826 5.256 5.256 0 1 1 7.438.008.62.62 0 0 1-.421.164.58.58 0 0 1-.412-.172Z"/>
                    </g>
                  </g>
                </svg>
              </span>
              <div class="modal-copy-link">
                <h4 class="f-f-regular mx-0">Link Copied!</h4>
                <span class="btn-close">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-close" viewBox="0 0 18 17">
                      <path fill="currentColor" d="M.865 15.978a.5.5 0 0 0 .707.707l7.433-7.431 7.579 7.282a.501.501 0 0 0 .846-.37.5.5 0 0 0-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 1 0-.707-.708L8.991 7.853 1.413.573a.5.5 0 1 0-.693.72l7.563 7.268z"></path>
                  </svg>
                </span>
              </div>
          </div>
      </div>
    </div>
    <div class="side-content col_25">
    </div>
  </div>
  <div class="inner-article-section">
    <div class="article-main-content col_75">
      <div class="article-content">
        {{ article.content | replace: '<img', '<img loading="lazy"' }}
      </div>
      
      <div class="article-recommended-section h-mobile">
        <h3 class="f-f-semibold mx-0 black-f">Recommend Posts</h3>
        <div class="recommended-article-list-container mobile-blogs-slider">
