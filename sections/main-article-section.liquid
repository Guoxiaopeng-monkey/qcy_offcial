              </svg>
            </a>
            <a href="{{ settings.social_instagram_link }}" class="social-link" target="_blank">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30">
                <defs>
                  <style>
                    .c{isolation:isolate;fill:#484848}
                  </style>
                </defs>
                <g transform="translate(.1 -.031)">
                  <circle cx="15" cy="15" r="15" transform="translate(-.1 .031)" style="fill:#f5f5f5"/>
