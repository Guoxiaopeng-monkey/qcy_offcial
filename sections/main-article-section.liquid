<script>
  var products_judgeme = [
    {% for product in collections['all'].products %}
      {
        "handle": "{{ product.handle }}",
       "judgeme_badge": {{ product.metafields.judgeme.badge | json }}
      }{% if forloop.last == false %},{% endif %}
    {% endfor %}
  ];

  console.log(products_judgeme);
  
$('.product-article').each(function() {
    var productHandle = $(this).data('product-handle'); // Get the product handle from the data attribute
    var $productArticle = $(this); // Store reference to the product-article element
    var productBadge = products_judgeme.find(function(product) {
      return product.handle === productHandle;
    });
    $.ajax({
        url: `/products/${productHandle}.js`,  // Endpoint using the handle
        method: 'GET',
        dataType: 'json',
        success: function(product) {
            // Append HTML to the correct .product-article element
          
         
            // Limit the description to 200 characters
            var limitedDescription = product.description.length > 150
                ? product.description.substring(0, 150) + '...' 
                : product.description;
          
            $productArticle.html(`
              <div class="col_40 featured-image-column">
                <img loading="lazy" src="${product.featured_image}" width="100%" height="100%">
              </div>
              <div class="col_60 product-detail-content">
                <h2 class="text-sm mx-0 black-f f-f-bold">${product.title}</h2>
                <div class="judgeme-badge-container">
                ${productBadge.judgeme_badge}
                </div>
                <div class="product-detail-price">
                  <h3 class="f-f-bold mx-0">${formatMoney(product.variants[0].price, "{{ shop.money_format }}")}</h3> 
                  <h3 class="compare-price-color mx-0 f-f-light text-strike">${formatMoney(product.variants[0].compare_at_price, "{{ shop.money_format }}")}</h3> 
                </div>
                <div class="mx-0 text-gray-f">${limitedDescription}</div>
                <div class="product-detail-buttons">
                  <button class="add-to-cart-btn" data-variant-id="${product.variants[0].id}">
                      <svg class="cart-icon" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21">
                          <g transform="translate(0.72 0.889)">
                              <rect fill="none" width="21" height="21" transform="translate(-0.72 -0.889)" />
                              <path d="M28.863,36.251H20.119L17.983,24.505a.613.613,0,0,0-.6-.505H16" transform="translate(-15.021 -22.422)" stroke="#000" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                              <circle cx="1.248" cy="1.248" r="1.248" transform="translate(5.038 13.829)" stroke="#000" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                              <circle cx="1.248" cy="1.248" r="1.248" transform="translate(12.716 13.829)" stroke="#000" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                              <path d="M49.11,70.125h9.617a1.217,1.217,0,0,0,1.2-1L60.863,64H48" transform="translate(-44.571 -59.359)" stroke="#000" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                          </g>
                      </svg>
                      <div class="loading__spinner hidden">
                        <svg xmlns="http://www.w3.org/2000/svg" class="spinner" viewBox="0 0 66 66"><circle stroke-width="6" cx="33" cy="33" r="30" fill="none" class="path"/></svg>
                      </div>
                  </button>
                  <a href="${product.url}" target="_blank" class="p learn-more-btn mx-0 line-height-normal">Learn More</a>
                </div>
            </div>
            `);

            // Initialize the Add to Cart button functionality for this product
            reloadFunction($productArticle);

          
          
        },
        error: function(error) {
            console.error("Error fetching product:", error);
        }
    });

    function reloadFunction($productElement) {
        $productElement.find('.add-to-cart-btn').click(function() {
            var $button = $(this); // Store reference to the clicked button
            var variantId = $button.data('variant-id'); // Get variant ID from the data attribute
            var formData = `id=${variantId}&quantity=1`; // Form data as URL-encoded string
        
            // Disable button to prevent multiple clicks
            $button.prop('disabled', true);
            $button.find('.cart-icon').css('visibility', 'hidden');
            $button.find('.loading__spinner').removeClass('hidden');
        
            $.ajax({
                type: 'POST',
                url: '/cart/add.js',
                data: formData,
                dataType: 'json',
                success: function(response) {
                    // Fetch the updated cart contents
                    $.ajax({
                        type: 'GET',
                        url: '/cart',
                        dataType: 'html',
                        success: function(data) {
                            var parser = new DOMParser();
                            var doc = parser.parseFromString(data, 'text/html');
                            var cartDrawerContent = doc.querySelector('#CartDrawer .drawer__inner');
                            document.querySelector('#CartDrawer .drawer__inner').innerHTML = cartDrawerContent.innerHTML;
                            $('cart-drawer').removeClass('is-empty');
                            document.querySelector('cart-drawer').open();
        
                            // Re-enable button after cart update
                            $button.prop('disabled', false);
                            $button.find('.cart-icon').css('visibility', 'visible');
                            $button.find('.loading__spinner').addClass('hidden');
                        },
                        error: function(error) {
                            console.log('Error fetching cart:', error);
                            $button.prop('disabled', false); // Re-enable on error
                            $button.find('.cart-icon').css('visibility', 'visible');
                            $button.find('.loading__spinner').addClass('hidden');
                        }
                    });
                },
                error: function(xhr) {
                    alert('Error adding item to cart: ' + (xhr.responseJSON ? xhr.responseJSON.description : 'Unknown error'));
                    $button.prop('disabled', false); // Re-enable on error
                }
            });
        });

    }

});

function formatMoney(cents, format) {
  if (typeof cents == 'string') { cents = cents.replace('.',''); }
  var value = '';
  var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
  var formatString = (format || this.money_format);

  function defaultOption(opt, def) {
     return (typeof opt == 'undefined' ? def : opt);
  }

  function formatWithDelimiters(number, precision, thousands, decimal) {
    precision = defaultOption(precision, 2);
    thousands = defaultOption(thousands, ',');
    decimal   = defaultOption(decimal, '.');

    if (isNaN(number) || number == null) { return 0; }

    number = (number/100.0).toFixed(precision);

    var parts   = number.split('.'),
        dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands),
        cents   = parts[1] ? (decimal + parts[1]) : '';

    return dollars + cents;
  }

  switch(formatString.match(placeholderRegex)[1]) {
    case 'amount':
      value = formatWithDelimiters(cents, 2);
      break;
    case 'amount_no_decimals':
      value = formatWithDelimiters(cents, 0);
      break;
    case 'amount_with_comma_separator':
      value = formatWithDelimiters(cents, 2, '.', ',');
      break;
    case 'amount_no_decimals_with_comma_separator':
      value = formatWithDelimiters(cents, 0, '.', ',');
      break;
  }

  return formatString.replace(placeholderRegex, value);
};

  
