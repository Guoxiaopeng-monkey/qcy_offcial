<section class="support-services" data-anchor="support-service">
    <div class="page-width section-content">
        <div class="row">
            <div class="col-lg-10 col-md-12 col-sm-12 mx-auto">
                
                <div class="row">
                    <div class="col-12 text-center">
                        <h2 class="title">
                            {{ section.settings.title }}
                        </h2>
                    </div>
                </div>
                <div class="row services-row">
                    <div class="col-lg-4 col-md-12 col-sm-12">
                        <a class="service" href="https://{{ request.host }}{% if localization.language.iso_code == 'es' %}/es{% endif %}{{ section.settings.url_1 }}">
                            <div class="service-image">
                                <img loading="lazy" src="{{ section.settings.image_1 | img_url: 'master' }}">
                                <span class="d-lg-none d-md-block d-sm-block">
                                    Track My Order
                                </span>
                                <i class="fa-solid fa-chevron-right d-lg-none d-md-block d-sm-block"></i>
                            </div>
                            <span class="d-lg-block d-md-none d-sm-none">
                                Track My Order
                            </span>
                        </a>
                    </div>
                    <div class="col-lg-4 col-md-12 col-sm-12">
                        <a class="service" href="{{ section.settings.url_2 }}">
                            <div class="service-image">
                                <img loading="lazy" src="{{ section.settings.image_2 | img_url: 'master' }}">
                                <span class="d-lg-none d-md-block d-sm-block">
                                    Anti-Fake Verification
                                </span>
                                <i class="fa-solid fa-chevron-right d-lg-none d-md-block d-sm-block"></i>
                            </div>
                            <span class="d-lg-block d-md-none d-sm-none">
                                Anti-Fake Verification
                            </span>
                        </a>
                    </div>
                    <div class="col-lg-4 col-md-12 col-sm-12">
                        <a class="service" href="javascript:void(0)" data-modal="warranty-claim">
                            <div class="service-image">
                                <img loading="lazy" src="{{ section.settings.image_3 | img_url: 'master' }}">
                                <span class="d-lg-none d-md-block d-sm-block">
                                    Warranty Claim
                                </span>
                                <i class="fa-solid fa-chevron-right d-lg-none d-md-block d-sm-block"></i>
                            </div>
                            <span class="d-lg-block d-md-none d-sm-none">
                                Warranty Claim
                            </span>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

{% render 'modal-warranty' %}

{% schema %}
{
    "name": "Support Service",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "image_picker",
            "id": "image_1",
            "label": "Track My Order - Icon"
        },
        {
            "type": "image_picker",
            "id": "image_2",
            "label": "Anti-Fake Verification - Icon"
        },
        {
            "type": "image_picker",
            "id": "image_3",
            "label": "Warranty Claim - Icon"
        },
        {
            "type": "url",
            "id": "url_1",
            "label": "Track My Order - URL"
        },
        {
            "type": "url",
            "id": "url_2",
            "label": "Anti-Fake Verification - URL"
        }
    ]
}
{% endschema %}