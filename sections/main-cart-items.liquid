{{ 'component-cart.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'component-price.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.aio.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .main-cart-df{
    display:flex;
    gap:80px;
  }
  .cart__footer>*+*{
    margin:0px !important;
  }
  .main-cart-df .cart__footer{
    display:flex;
    flex-direction:column;
    padding: 3rem 2rem;
    background:#F8F8F8;
    border-radius:8px;
    gap:20px;
  }
  .main-cart-df .cart__footer .js-contents, .main-cart-df .cart__footer .cart__blocks{
    width:100%;
  }
  .main-cart-df .cart__footer .totals{
    justify-content: space-between;
    padding-top:1.5rem;
  }
  .main-cart-df .cart-item td{
    border-bottom: 2px solid #c8c8c830;
  }
  .main-cart-df .cart-item:last-child td{
    border-bottom:unset;
  }
  .main-cart-df quantity-input.cart-quantity{
    border: 1px solid #0000004a;
    border-radius: 6px;
  }
  .main-cart-df .cart-item__quantity-wrapper{
    display:block;
  }
  .main-cart-df .quantity{
    width:100%;
  }
  .main-cart-container .cart-item__image-container{
    border:none;
  }
  @media screen and (min-width: 750px){
    .main-cart-container .page-width {
        padding: 0 3rem;
    }
    .main-cart-container .col_30{
      margin-top:-35px;
    }
    .main-cart-footer{
      margin-top: 1rem;
    }
    .main-cart-container .cart-item__image-container{
      width: 200px;
      height: 150px;
    }
  }
  .main-cart-container .cart__ctas button{
    max-width:unset;
    background:#000;
    color:#fff;
    border-radius:50px;
    padding: 15px 0px;
    margin-top:20px;
    transition: all 0.3s ease;
  }
  .main-cart-container .cart__ctas button:hover{
    background:#FF8832;
  }
  .main-cart-container .cart__ctas button:before,
  .main-cart-container .cart__ctas button:after{
    display:none;
  }
  .main-cart-container .payment-methods-icons{
    padding:2rem 1rem 0px;
  }
  .main-cart-container .payment-methods-icons, .main-cart-container .payment-icons-img{
    width:100%;
    height:100%;
    object-fit:contain;
  }
  .main-cart-container .sub-total-container{
    border-top: 2px solid #7070701f;
    padding-top: 1.3rem;
    width:100%;
  }
  .main-cart-container .sub-total-container #apply-discount-btn{
      background-color: #FF8832;
      color: #fff;
  }
  .main-cart-container .order-total-details{
    display:flex;
    flex-direction:column;
    gap:1rem;
    width:100%;
  }
  .main-cart-container .sub-content{
    display:flex;
    justify-content: space-between;
  }
  .main-cart-container .quantity-popover-container{
    max-width:12rem;
    margin:0px auto;
  }
  .main-cart-container .quantity__button{
    width:25%;
  }
  .main-cart-container .cart-item__image{
    width: 100%;
    height: 100%;
    object-fit: contain;
    border:1px solid #EEEEEE;
  }
  .checkout-aggrement{
    width:100% !important;
    display: flex;
    align-items: flex-start;
    gap: 2px;
  }
  .checkout-aggrement label{
    text-align:justify;
  }
  .is-empty.main-cart-container{
    padding:50px 0px 120px;
  }
  .is-empty.main-cart-container .col_30{
    display:none;
  }
  .is-empty.main-cart-container .col_70{
    width:100%;
  }
  .is-empty.main-cart-container .cart__warnings .col_80{
    display:flex;
    justify-content: space-between;
  }
  .is-empty.main-cart-container .cart__warnings .col_40{
    display:flex;
    flex-direction:column;
    gap:1rem;
    align-items: flex-start;
  }
  .cart-item-details-container{
    display:flex;
    flex-direction:column;
    height:100%;
    padding-left:2rem;
  }
  .cart__footer .component-side-cart-details{
    width:100%;
  }
  .con-shopping-btn{
    position: relative;
    top: 40px;
    width: fit-content;
    text-decoration:underline !important;
    color:#000;
  }
  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
      .main-cart-df{
        flex-direction:column;
      }
      .main-cart-container .cart__ctas button{
        padding:unset;
      }
      .empty-container{
        flex-direction:column;
        gap:50px;
      }
      .is-empty.main-cart-container{
        padding:50px 0px;
      }
      cart-items .title-wrapper-with-link h4{
        position:relative;
        top:-10px;
      }
      .main-cart-df{
        gap:50px;
      }
      .cart-items th.header-product-image{
        padding-left:0px;
      }
      .cart-items thead tr{
        margin-bottom:0px;
      }
      .cart-item-details-container a{
        font-size:18px;
      }
      .con-shopping-btn.h-desktop{
          display:none;
      }
      .con-shopping-btn.h-mobile{
          display:block;
          top:0;
          margin-top:2rem;
      }
      .main-cart-container .quantity-popover-container{
        max-width:8rem;
      }
      .main-cart-container .quantity-popover-container quantity-input{
        min-height:30px;
      }
      .main-cart-container .quantity-popover-container quantity-input .quantity__input{
        width:30px;
      }
      #main-cart-items .cart-items__headings, 
      #main-cart-items .cart-item{
        display:grid;
        grid-template-columns:50% 25% 25%;
      }
      #main-cart-items .cart-items .price{
        font-size:18px;
      }
      .cart-item__image-container{
        width:40%;
      }
      .cart-item-details-container{
        width:60%;
      }
      .cart-items__headings .header-product-image,
      .cart-items__headings .cart-items__heading--quantity,
      .cart-items__headings .header-price{
          font-size:14px;
      }
  }
  /* ipad Air */
  @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
      .main-cart-df{
        flex-direction:column;
      }
      .main-cart-container .cart__ctas button{
        padding:unset;
      }
      .empty-container{
        flex-direction:column;
        gap:50px;
      }
      .is-empty.main-cart-container{
        padding:50px 0px;
      }
      cart-items .title-wrapper-with-link h4{
        position:relative;
        top:-10px;
      }
      .main-cart-df{
        gap:50px;
      }
      .cart-items th.header-product-image{
        padding-left:0px;
      }
      .cart-items thead tr{
        margin-bottom:0px;
      }
      .cart-item-details-container a{
        font-size:18px;
      }
      .con-shopping-btn.h-desktop{
          display:none;
      }
      .con-shopping-btn.h-mobile{
          display:block;
      }
      .main-cart-container .quantity-popover-container{
        max-width:8rem;
      }
      .main-cart-container .quantity-popover-container quantity-input{
        min-height:30px;
      }
      .main-cart-container .quantity-popover-container quantity-input .quantity__input{
        width:30px;
      }
      #main-cart-items .cart-items__headings, 
      #main-cart-items .cart-item{
        display:grid;
        grid-template-columns:50% 25% 25%;
      }
      #main-cart-items .cart-items .price{
        font-size:18px;
      }
      .cart-item__image-container{
        width:40%;
      }
      .cart-item-details-container{
        width:60%;
      }
      .cart-items__headings .header-product-image,
      .cart-items__headings .cart-items__heading--quantity,
      .cart-items__headings .header-price{
          font-size:14px;
      }
  }

  /* TABLETS  */ 
  @media only screen and (min-width: 768px) {
      .main-cart-df{
        flex-direction:column;
      }
      .main-cart-container .col_70,
      .main-cart-container .col_30{
        width:100%;
      }
      .con-shopping-btn.h-desktop{
          display:none;
      }
      .con-shopping-btn.h-mobile{
          display:block;
      }
  }
   @media only screen and (min-width: 800px) {
      .main-cart-df{
        flex-direction:column;
      }
      .main-cart-container .col_70,
      .main-cart-container .col_30{
        width:100%;
      }
      .con-shopping-btn.h-desktop{
          display:none;
      }
      .con-shopping-btn.h-mobile{
          display:block;
      }
  }
  @media (min-width: 1024px) and (orientation: portrait) {
      .main-cart-df{
        flex-direction:column;
      }
      .main-cart-container .col_70,
      .main-cart-container .col_30{
