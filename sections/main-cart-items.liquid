  #main-cart-items .quantity-popover__info-button{
    display:none;
  }
  #main-cart-items .quantity-popover__info-button:before,
  #main-cart-items .quantity-popover__info-button:after{
    display:none;
  }
  @media only screen and (min-width: 1536px) {
      .main-cart-df{
        flex-direction:row;
      }
      .main-cart-container .col_70{
