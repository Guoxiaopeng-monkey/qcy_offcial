{% stylesheet %}
  .featured-product-image-section{
    background-color:#f9f9f9;
    height: calc(100vh - 100px);
    display: flex;
    flex-direction: column;
    justify-content: center;    
    align-items: center;
    position:relative;
    padding:0px 50px;
    overflow:hidden;
  }
  .featurd-product-image{
    width:100%;
    height:90%;
    object-fit:contain;
    position:absolute;
    z-index:1;
  }
  .featured-product-title {
      white-space: nowrap; /* Force text to stay on one line */
    overflow: hidden; /* Prevent overflow */
    text-overflow: ellipsis; /* Optional: if you want the text to cut off */
    font-size: 23vw; /* Start with large text */
    transition: font-size 0.2s ease-in-out; /* Smooth transition */
  }

{% endstylesheet %}
  <img loading="lazy" src="
    {% if section.settings.featured_image != blank  %}
      {{ section.settings.featured_image | img_url: 'master' }}
    {% else %}
    https://cdn.shopify.com/s/files/1/0639/3492/2809/files/39910_2x_99949133-4fe9-4dbb-86b4-4355549a30b5.png?v=1727930317
    {% endif %}
    " class="featurd-product-image" data-aos="fade-up">
<h2 class="featured-product-title f-f-extra-bold mx-0 main-color" data-aos="fade-down">{%- if section.settings.heading != blank -%}{{- section.settings.heading -}}{%- else -%}{{- product.title | replace: '(Development)',''  -}}{%- endif -%}</h2>
    
{% javascript %}
function adjustFontSize() {
    var containerWidth = $('.featured-product-image-section').width();
    var title = $('.featured-product-title');
    var textLength = title.text().length;
    console.log(textLength);

    var baseFontSize = 23;
    var adjustedFontSize = baseFontSize;

    // Adjust font size only when text length exceeds 6 characters
    if (textLength > 6) {
        adjustedFontSize = baseFontSize - (textLength * 0.8);
    }

    adjustedFontSize = Math.max(adjustedFontSize, 2); // Ensure font size does not go below 2vw

    title.css('font-size', adjustedFontSize + 'vw');
}

adjustFontSize();

$(window).resize(function() {
    adjustFontSize();
});


{% endjavascript %}
{% schema %}
    {
      
        "class": "featured-product-image-section",
        "name": "Featured Product Image",
        "templates": ["index", "product"],
        "limit": 1, 
        "settings": [
            {
                "type": "image_picker",
                "id": "featured_image",
                "label": "Featured Image"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading"
            }
        ],
        "presets" :[{
            "name" : "Featured Product Image"
        }]
    }
  {% endschema %} 