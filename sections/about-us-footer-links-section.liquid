{% stylesheet %}
  .about-us-footer-links-section{
    padding:50px 0px 80px;
  }
  .about-us-footer-links-section .footer-links-section{
    display:flex;
    gap:30px;
  }
  .about-us-footer-links-section .footer-links-item{
    border-radius:25px;
    overflow:hidden;
    position:relative;
  }
  .about-us-footer-links-section .footer-links-section .footer-links-img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition: all 0.3s ease;
  }
  .about-us-footer-links-section .footer-links-item .footer-link-tag{
    position:absolute;
    bottom:20px;
    z-index:1;
    width:fit-content;
    left:0;
    padding:0px 30px;
  }
  .about-us-footer-links-section .footer-links-item .footer-link-tag:after{
    content: "";
    width: 100%;
    height: 2px;
    background-color: #FF8832;
    border-radius: 50px;
    opacity: 0;
    transition: all 0.3s ease;
    display: block;
    position: relative;
    bottom: 5px;
  }
  .about-us-footer-links-section .footer-links-item .footer-link-tag:hover:after{
    opacity:1;
  }
  
  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
    .about-us-footer-links-section{
      padding-bottom:20px;
    }
    .about-us-footer-links-section .footer-links-section{
      flex-direction:column;
    }
  }
  
  /* ipad Air */
  @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
    .about-us-footer-links-section{
      padding-bottom:20px;
    }
    .about-us-footer-links-section .footer-links-section{
      flex-direction:column;
    }
  }

{% endstylesheet %}
<div class="page-width">
  <div class="footer-links-section">
    {% for block in section.blocks %}
      <div class="footer-links-item">
        <img loading="lazy" class="footer-links-img" src="{{ block.settings.image | img_url: 'master' }}">
        <a href="{{ block.settings.link }}" class="footer-link-tag white-f text-sm f-f-semi-bold mx-0">
          {{ block.settings.heading }}
        </a>
      </div>
    {% endfor %}
{% comment %}   
    <div class="footer-links-item">
      <img loading="lazy" class="footer-links-img" src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/39974_2x_dff7c4b8-dc95-40ab-b525-5438015ea0cc.png?v=1729100465">
      <a href="/pages/contact-us" class="footer-link-tag white-f text-sm f-f-semi-bold mx-0">
        Blog
      </a>
    </div>
{% endcomment %}
  </div>
</div>
{% schema %}
    {
        "class": "about-us-footer-links-section",
        "name": "About Us Footer Links",
        "templates": ["page"],
        "limit": 1, 
        "max_blocks": 2,
        "blocks": [
          {
              "type": "Link",
              "name": "Link",
              "settings": [
                  {
                      "type": "image_picker",
                      "id": "image",
                      "label": "Background"
                  },
                  {
                      "type": "text",
                      "id": "heading",
                      "label": "Heading"
                  },
                  {
                      "type": "url",
                      "id": "link",
                      "label": "Link"
                  }
              ]
          }
        ],
        "presets" :[{
            "name" : "About Us Footer Links"
        }]
    }
{% endschema %} 