                  <img loading="lazy" src="{{ block.settings.featured_image | img_url: "master" }}" class="bg-featured-product-image">
                </a>
              </div>
            {% else %}
              <div class="right-product-container">
                <a href="{{ block.settings.product.url }}" class="col_50 product-bg-featured-image">


