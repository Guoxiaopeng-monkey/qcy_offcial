                  <div class="side-content-price">
                    <div class="price-container">
                      <h3 class="original-price text-sm mx-0 f-f-bold" style="color:{{ section.settings.secondary_color }};">{{ block.settings.product.selected_or_first_available_variant.price | money }}</h3>
                      <h3 class="compare-price mx-0 price-gray-f">{{ block.settings.product.selected_or_first_available_variant.compare_at_price | money }}</h3>
                    </div>
                    {% if block.settings.discount_note != blank %}
                      <div class="discount-note-section" style="background-color:{{ block.settings.background_badge }};">
                        <p class="mx-0 f-f-semibold" style="color:{{ block.settings.secondary_color }};">{{ block.settings.discount_note }}</p>
                      </div>
                    {% endif %}
                  </div>
                  <p class="text-gray-f mx-0" style="color:{{ section.settings.description_color }};">Experience every frequency with superior precision and clarity. Maximize your immersion with lossless streaming, spatial audio with dynamic head tracking, and world-class Active Noise Cancellation. </p>                
                  {% render 'promotion-card-time-offer', data_date: block.settings.date_picker %}
                  <div class="product-buttons">
                    <a href="{{ block.settings.product.url }}" class="h5 buy-now-btn f-f-semibold">Buy now</a>
                    
                  {% assign product_form_id = 'quick-add-' | append: section.id | append: block.settings.product.id %}
                      <div class="quick-add no-js-hidden add-to-cart-btn">
                          <product-page-form data-section-id="{{ section.id }}">
                              {%- form 'product', block.settings.product, id: block.settings.product.id, class: 'form add_cart_form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                              <input type="hidden" name="id" value="{{ block.settings.product.selected_or_first_available_variant.id }}" class="product-variant-id" {% if block.settings.product.selected_or_first_available_variant.available == false %} disabled {% endif %}>
                              <button id="{{ product_form_id }}-submit" type="submit" name="add" class="quick-add__submit " aria-haspopup="dialog" aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ block.settings.product.id }}" aria-live="polite" data-sold-out-message="true" {% if block.settings.product.selected_or_first_available_variant.available == false %} disabled {% endif %}>
                                  <span class="hidden">
                                      {%- if block.settings.product.selected_or_first_available_variant.available -%}
                                      {{ 'products.product.add_to_cart' | t }}
                                      {%- else -%}
                                      {{ 'products.product.sold_out' | t }}
                                      {%- endif -%}
                                  </span>
                                  <span class="sold-out-message hidden">
                                      {{ 'products.product.sold_out' | t }}
                                  </span>
                                  {%- if horizontal_quick_add -%}
                                  <span class="icon-wrap hidden">
                                      {{- 'icon-plus.svg' | inline_asset_content -}}
                                  </span>
                                  {%- endif -%}
                                  <span class="h5 add-to-cart-btn f-f-semibold">Add To Cart</span>
                                  {%- render 'loading-spinner' -%}
                              </button>
                              {%- endform -%}
                          </product-page-form>
                      </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
    </div>
  </div>
</div>
{% javascript %}
  
$(document).ready(function() {
    $('.countdown-list-container').each(function() {
        // Get the data-time-offer attribute
        var timeOffer = $(this).data('time-offer');

        // Check if the timeOffer value exists
        if (!timeOffer) {
            $(this).addClass('hide-countdown'); // Add class if no data-time-offer value
            return; // Skip further processing for this card
        }

        // Convert DD/MM/YYYY HH:MM:SS to YYYY-MM-DDTHH:MM:SS
        var parts = timeOffer.split(' '); // Split date and time
        var dateParts = parts[0].split('/'); // Split date by '/'
        var timeParts = parts[1].split(':'); // Split time by ':'

        // Construct the new date string
        var formattedDate = `${dateParts[2]}-${dateParts[1]}-${dateParts[0]}T${timeParts[0]}:${timeParts[1]}:${timeParts[2]}`;
        
        // Create a target date object
        var targetDate = new Date(formattedDate).getTime();
        console.log("Target Date:", targetDate); // Check the output

        // Update the countdown every 1 second
        var countdownInterval = setInterval(() => {
            // Get the current time
            var now = new Date().getTime();

            // Calculate the difference
            var timeDifference = targetDate - now;

            // Calculate days, hours, minutes, and seconds
            var days = Math.floor(timeDifference / (1000 * 60 * 60 * 24));
            var hours = Math.floor((timeDifference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            var minutes = Math.floor((timeDifference % (1000 * 60 * 60)) / (1000 * 60));
            var seconds = Math.floor((timeDifference % (1000 * 60)) / 1000);

            // Add leading zeros if the value is less than 10
            days = days < 10 ? '0' + days : days;
            hours = hours < 10 ? '0' + hours : hours;
            minutes = minutes < 10 ? '0' + minutes : minutes;
            seconds = seconds < 10 ? '0' + seconds : seconds;

            // Display the result in the respective HTML elements within the current card
            $(this).find('.card-day-sec').text(days);
            $(this).find('.card-hour-sec').text(hours);
            $(this).find('.card-minute-sec').text(minutes);
            $(this).find('.card-second-sec').text(seconds);

            // Check if the countdown is finished
            if (timeDifference < 0) {
                clearInterval(countdownInterval);
                $(this).find('.card-day-sec, .card-hour-sec, .card-minute-sec, .card-second-sec').text('00');
                
                // Remove class when the countdown ends
                $(this).addClass('hide-countdown'); // Add a class to hide the element
            } else {
                // Check if the current date and time equals the target date
                var currentDate = new Date();
                if (currentDate.getFullYear() === dateParts[2] && 
                    currentDate.getMonth() + 1 === parseInt(dateParts[1]) && 
                    currentDate.getDate() === parseInt(dateParts[0]) &&
                    currentDate.getHours() === parseInt(timeParts[0]) &&
                    currentDate.getMinutes() === parseInt(timeParts[1])) {
                    
                    $(this).removeClass('hide-countdown'); // Remove class if the current date matches
                }
            }
        }, 1000);
    });
});


{% endjavascript %}
