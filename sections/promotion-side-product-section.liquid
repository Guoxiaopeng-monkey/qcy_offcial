<style>
  #shopify-section-{{ section.id }}{
    background-color:{{ section.settings.background }};
  }
  .side-product-section{
    padding:80px 0px;
  }
  .side-product-section .side-product-container-list{
    display:flex;
    flex-direction:column;
    gap: 80px;
  }
  .side-product-section .left-product-container, 
  .side-product-section .right-product-container{
    display:flex;
  }
  .side-product-section .bg-featured-product-image{
    width:100%;
    height:100%;
    object-fit:cover;
  }
  .side-product-section .product-details-content{
      padding:0px 80px;
      display:flex;
      flex-direction:column;    
      justify-content: center;
      gap:1.5rem;
  }
  .side-content-price{
    display:flex;
    gap:1rem;
    align-items: center;
  }
  .side-content-price .price-container{
    display:flex;
    gap:1rem;
    align-items: center;
  }
  .discount-note-section{
    background-color: #FFF0E4;
    padding: 5px 2rem;
    border-radius: 5px;
  }
  .product-bg-featured-image{
    position:relative;
    overflow:hidden;
  }
  .left-product-container .product-bg-featured-image{
      border-top-right-radius:20px;
      border-bottom-right-radius:20px;
  }
  .right-product-container .product-bg-featured-image{
      border-top-left-radius:20px;
      border-bottom-left-radius:20px;
      display:flex;
  }
  .discount-banner{
    background: #FFF0E4;
    width: fit-content;
    padding: 0.5rem 1.5rem;
    text-align: center;
    position: absolute;
    top: 0;
    left: 20px;
  }
  .discount-banner:after {
      content: "";
      display: block;
      background-color: #FFF0E4;
      clip-path: polygon(50% 0, 100% 100%, 0 100%);
      width: 100%;
      height: 20px;
      position: absolute;
      transform: scaleY(-1);
      left: 0;
      margin-top: 5px;
  }
  .left-product-container .discount-banner,
  .right-product-container .discount-banner{
      padding:0.5rem 2.5rem;
  }
  .left-product-container .discount-banner:before,
  .right-product-container .discount-banner:before{
      height:30px;
    
  }
  .left-product-container .discount-banner{
    left:unset;
    right:50px;
  }
  .right-product-container .discount-banner{
    left:50px;
    right:unset;
  }
  .side-product-section .product-buttons{
    display:flex;
    gap:20px;
    padding-top:20px;
  }
  .product-buttons .buy-now-btn,
  .product-buttons .add-to-cart-btn{
    padding:1rem 2rem;
    width:100%;
    display:flex;
    align-items: center;
    justify-content: center;
    border-radius:50px;
  }
  .product-buttons .loading .add-to-cart-btn{
    color:#F1F1F1;
  }
  .product-buttons .buy-now-btn{
    background-color:#FF8832;
    color:#fff;
  }
  .product-buttons .add-to-cart-btn{
    background-color:#F1F1F1;
    color:#000;
  }
  .side-product-section .featured-specs-content{
      display: flex;
      column-gap: 15px;
      position: absolute;
      bottom: 50px;
      max-width: 1150px;
      margin: auto;
      left: 0;
      right: 0;
      justify-content: center;
  }
  .side-product-section .featured-specs-item{
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
  }
  .side-product-section .feat-specs-icon{
      height:30px;
      width:40px;
      object-fit:contain;
  }
  .side-product-section .product-buttons .add-to-cart-btn span{
    padding:0px;
  }

  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
      .side-product-section{
        padding:50px 0px;
      }
      .right-product-container{
        flex-direction:column;
        box-shadow: 0px 3px 6px 1px rgba(0,0,0,0.1);
        border-radius:10px;
        overflow:hidden;
      }
      .left-product-container{
        flex-direction:column-reverse;
        box-shadow: 0px 3px 6px 1px rgba(0,0,0,0.1);
        border-radius:10px;
        overflow:hidden;
      }
      .side-product-section .product-details-content{
        padding:0px 20px;
      }
      .side-product-section .product-details-content .short-description{
        display:none;
      }
      .side-product-section .product-details-content{
        padding:20px 20px;
        gap:5px;
      }
      .discount-note-section{
        padding:5px 10px;
      }
      .discount-note-section p{
        font-size:10px;
      }
      .side-content-price{
        flex-direction:column;
        align-items:flex-start;
      }
      .side-content-price .original-price{
        font-size:22px;
      }
      .side-content-price .compare-price{
        font-size:18px;
      }
      .side-product-section .featured-specs-content{
        display:none;
      }
      .right-product-container .discount-banner{
        left:20px;
      }
      .countdown-list-container.hide-countdown{
        display:none;
      }
      .side-product-section .product-buttons{
        flex-direction:column;
        gap:10px;
      }
      .side-product-section .side-product-container-list{
        gap:50px;
      }
      .right-product-container .product-bg-featured-image{
        border-radius:20px;
      }
  }
  
  /* ipad Air */
  @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
      .side-product-section{
        padding:50px 0px;
      }
