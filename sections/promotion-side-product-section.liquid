<div class="{{ section.settings.product_header | handleize }}-section side-product-section section-scroll">
  <div class="page-width">
    <div class="side-product-container-list">
        {% for block in section.blocks %}
            {% if block.type == 'left_product' %}
              <div class="left-product-container">
                <div class="col_50 product-details-content">
                  <a href="{{ block.settings.product.url }}" class="black-f">
                      <h2 class="text-md mx-0 f-f-bold" style="color:{{ section.settings.primary_color }};">{{ block.settings.product.title }}</h2>
                  </a>
                  <h4 class="short-description f-f-semibold text-cap mx-0" style="color:{{ section.settings.primary_color }};">{{ block.settings.product.metafields.custom.short_description }}</h4>
                  <div class="side-content-price">
                    <div class="price-container">
                      <h3 class="original-price text-sm mx-0 f-f-bold" style="color:{{ section.settings.secondary_color }};">{{ block.settings.product.selected_or_first_available_variant.price | money }}</h3>
                      <h3 class="compare-price mx-0 price-gray-f">{{ block.settings.product.selected_or_first_available_variant.compare_at_price | money }}</h3>
                    </div>
                    {% if block.settings.discount_note != blank %}
                      <div class="discount-note-section" style="background-color:{{ block.settings.background_badge }};">
                        <p class="mx-0 f-f-semibold" style="color:{{ block.settings.secondary_color }};">{{ block.settings.discount_note }}</p>
                      </div>
                    {% endif %}
                  </div>
                  <p class="text-gray-f mx-0" style="color:{{ section.settings.description_color }};">Experience every frequency with superior precision and clarity. Maximize your immersion with lossless streaming, spatial audio with dynamic head tracking, and world-class Active Noise Cancellation. </p>
                  {% render 'promotion-card-time-offer', data_date: block.settings.date_picker %}
                  <div class="product-buttons">
                    <a href="{{ block.settings.product.url }}" class="h5 buy-now-btn f-f-semibold">Buy now</a>
                    {% assign product_form_id = 'quick-add-' | append: section.id | append: block.settings.product.id %}
                        <div class="quick-add no-js-hidden add-to-cart-btn">
                            <product-page-form data-section-id="{{ section.id }}">
                                {%- form 'product', block.settings.product, id: block.settings.product.id, class: 'form add_cart_form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                                <input type="hidden" name="id" value="{{ block.settings.product.selected_or_first_available_variant.id }}" class="product-variant-id" {% if block.settings.product.selected_or_first_available_variant.available == false %} disabled {% endif %}>
                                <button id="{{ product_form_id }}-submit" type="submit" name="add" class="quick-add__submit " aria-haspopup="dialog" aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ block.settings.product.id }}" aria-live="polite" data-sold-out-message="true" {% if block.settings.product.selected_or_first_available_variant.available == false %} disabled {% endif %}>
                                    <span class="hidden">
                                        {%- if block.settings.product.selected_or_first_available_variant.available -%}
                                        {{ 'products.product.add_to_cart' | t }}
                                        {%- else -%}
                                        {{ 'products.product.sold_out' | t }}
                                        {%- endif -%}
                                    </span>
                                    <span class="sold-out-message hidden">
                                        {{ 'products.product.sold_out' | t }}
                                    </span>
                                    {%- if horizontal_quick_add -%}
                                    <span class="icon-wrap hidden">
                                        {{- 'icon-plus.svg' | inline_asset_content -}}
                                    </span>
                                    {%- endif -%}
                                    <span class="h5 add-to-cart-btn f-f-semibold">Add To Cart</span>
                                    {%- render 'loading-spinner' -%}
                                </button>
                                {%- endform -%}
                            </product-page-form>
                        </div>
                  </div>
                </div>
                <a href="{{ block.settings.product.url }}" class="col_50 product-bg-featured-image">

                  {% assign amount_discount = block.settings.product.selected_or_first_available_variant.compare_at_price | minus: block.settings.product.selected_or_first_available_variant.price %}
                  {% assign percentage_discount = amount_discount | times: 100 | divided_by: block.settings.product.selected_or_first_available_variant.compare_at_price | round %}
                  {% if block.settings.product.metafields.custom.discount_badge %}
                    {% if block.settings.product.selected_or_first_available_variant.compare_at_price != blank %}
                        <div class="discount-banner">
                            <h5 class="h3 main-color f-f-bold mx-0 l-h-normal">{{ percentage_discount }}%</h5>
                            <h5 class="h3 main-color f-f-bold mx-0 l-h-normal">OFF</h5>
                        </div>
                    {% endif %}
                  {% else %}
                    {% if block.settings.product.selected_or_first_available_variant.compare_at_price != blank %}
                        <div class="discount-banner">
                            <p class="mx-0 main-color f-f-regular l-h-normal">Save</p>
                            <h5 class="h3 main-color f-f-bold mx-0 l-h-normal">{{ amount_discount | money }}</h5>
                        </div>
                    {% endif %}
                  {% endif %}
                  
                  {% if block.settings.enabled_icons_list  %}
                    {% if block.settings.heading_1 == blank %}
                    <div class="featured-specs-content">
                      <div class="featured-specs-item col_25" >
                          <img loading="lazy" src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/330381_cloud_music_sound_soundcloud_icon_2x_ff0d97f5-0394-4128-9321-8f4042ddcc38.png?v=1728315164" alt="" class="feat-specs-icon">
