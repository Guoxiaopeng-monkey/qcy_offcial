<style>
.affiliate-hero {
  position: relative;
  width: 100%;
  height: 80vh;
  overflow: hidden;
}
.affiliate-hero .hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url('{{ section.settings.hero_image_desktop | img_url: 'master' }}');
  background-size: cover;
  background-position: center;
  display: block;
}
.affiliate-hero .hero-bg-mobile {
  display: none;
}
.affiliate-hero .container {
  position: relative;
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  padding: 0 20px;
  height: 100%;
}
.affiliate-hero .hero-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  max-width: 600px;
  padding-left: 6.25rem;
}
.affiliate-hero .hero-text {
  color: #000;
}
.affiliate-hero .hero-title-line {
  display: block;
  font-size: {{ section.settings.title_size }}px;
  font-weight:700;
}
.affiliate-hero p {
  font-size: {{ section.settings.description_size }}px;
  margin: 0 0 1.875rem;
  line-height: 1.5;
}
.affiliate-hero .cta-button {
  display: inline-block;
  background-color: #FF8832;
  color: #fff;
  padding: 0.75rem 2.5rem;
  text-decoration: none;
  border-radius: 3.125rem;
  font-weight: 500;
  transition: all 0.3s ease;
}
.affiliate-hero .cta-button:hover {
  background-color: #000000;
}

@media screen and (max-width: 768px) {
  .affiliate-hero {
    height: aoto;
  }
  .affiliate-hero .hero-bg {
    display: none;
  }
  .affiliate-hero .hero-bg-mobile {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('{{ section.settings.hero_image_mobile | img_url: 'master' }}');
    background-size: cover;
    background-position: center;
    display: block;
  }
  .affiliate-hero .container {
    padding: 0 1rem;
  }
  .affiliate-hero .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    text-align: center;
    max-width: 100%;
    padding-top: 1.25rem;
    padding-left: 0;
  }
  .affiliate-hero .hero-title-line {
    font-size: calc({{ section.settings.title_size }}px * 0.6) !important;
  }
  .affiliate-hero p {
    font-size: calc({{ section.settings.description_size }}px * 0.8) !important;
    margin-bottom: 1.25rem;
  }
  .affiliate-hero .cta-button {
    padding: 0.625rem 1.5rem;
  }
}
</style>

<section class="affiliate-hero">
  <div class="hero-bg"></div>
  <div class="hero-bg-mobile"></div>
  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-title">
          <span class="hero-title-line">{{ section.settings.title_line1 }}</span>
          <span class="hero-title-line">{{ section.settings.title_line2 }}</span>
        </h1>
        <p>{{ section.settings.description }}</p>
        <a href="{{ section.settings.cta_link }}" class="cta-button">
          {{ section.settings.cta_text }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Affiliate Hero",
  "settings": [
    {
      "type": "text",
      "id": "title_line1",
      "label": "Title Line 1",
      "default": "BLUETTI"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Title Line 2",
      "default": "Affiliate Program"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Share the power, earn up to 10% commission"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Join Now"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Font Size",
      "min": 16,
      "max": 72,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Font Size",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "image_picker",
      "id": "hero_image_desktop",
      "label": "Hero Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero Background Image (Mobile)"
    }
  ],
  "presets": [
    {
      "name": "Affiliate Hero",
      "category": "Affiliate"
    }
  ]
}
{% endschema %}