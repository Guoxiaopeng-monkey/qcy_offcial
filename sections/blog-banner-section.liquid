<style>
    .blog-banner-section{
        height:60vh;
        {% if page.metafields.custom.featured_image_desktop != blank %}
            background-image:url({{ page.metafields.custom.featured_image_desktop | img_url: 'master' }});
        {% else %}
            
            {% if section.settings.image != blank %}
                background-image:url({{ section.settings.image | img_url: 'master' }});
            {% else %}
                background-image:url(https://cdn.shopify.com/s/files/1/0639/3492/2809/files/134_2x_ea9497ac-8bb7-4f60-9759-d792c62e139c.png?v=1728361463);
            {% endif %}
        {% endif %}
        background-size:cover;
        background-position:center;
    }
    .blog-banner-section .inner-container-section{
        height:100%;
        width:100%;
        display: flex;
        gap:1rem;
        flex-direction:column;
        justify-content: center;
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .blog-banner-section{
            height: calc(75vh - 44px);
            
            {% if section.settings.image_mobile != blank %}
                background-image:url({{ section.settings.image_mobile | img_url: 'master' }});
            {% elsif section.settings.image != blank %}
                background-image:url({{ section.settings.image | img_url: 'master' }});
            {% else %}
            
                {% if page.metafields.custom.featured_image_mobile != blank %}
                    background-image:url({{ page.metafields.custom.featured_image_mobile | img_url: 'master' }});
                {% elsif page.metafields.custom.featured_image_desktop != blank %}
                    background-image:url({{ page.metafields.custom.featured_image_desktop | img_url: 'master' }});
                {% else %}
                    background-image:url(https://cdn.shopify.com/s/files/1/0639/3492/2809/files/134_2x_1.png?v=1728361530);
                {% endif %}
            {% endif %}
        }
        .hide-announcement .blog-banner-section{
            height: 65vh;
        }
        .blog-banner-section .inner-container-section h1,
        .blog-banner-section .inner-container-section .h4{
          text-align:center
        }
    }
  
    /* ipad Air */
    @media only screen 
        and (min-device-width : 768px) 
        and (max-device-width : 1024px){
        .blog-banner-section{
            height: calc(75vh - 44px);
            
            {% if section.settings.image_mobile != blank %}
                background-image:url({{ section.settings.image_mobile | img_url: 'master' }});
            {% elsif section.settings.image != blank %}
                background-image:url({{ section.settings.image | img_url: 'master' }});
            {% else %}
            
                {% if page.metafields.custom.featured_image_mobile != blank %}
                    background-image:url({{ page.metafields.custom.featured_image_mobile | img_url: 'master' }});
                {% elsif page.metafields.custom.featured_image_desktop != blank %}
                    background-image:url({{ page.metafields.custom.featured_image_desktop | img_url: 'master' }});
                {% else %}
                    background-image:url(https://cdn.shopify.com/s/files/1/0639/3492/2809/files/134_2x_1.png?v=1728361530);
                {% endif %}
            {% endif %}
        }
        .hide-announcement .blog-banner-section{
            height:65vh;
        }
        .blog-banner-section .inner-container-section h1,
        .blog-banner-section .inner-container-section .h4{
          text-align:center
        }
    }


</style>
<div class="inner-container-section page-width">
    <h1 class="f-f-bold white-f text-lg mx-0" data-aos="fade-up" data-aos-easing="ease" data-aos-delay="150" data-aos-duration="500">
    
        {% if page.title %}
            {{ page.title }}
        {% elsif collection.title != blank %}
            {{ collection.title }}
        {% elsif section.settings.custom_title != blank %}
            {{ section.settings.custom_title }}
        {% else %}

        {% endif %}
    </h1>
    <div class="h4 white-f mx-0 f-f-extralight col_35" data-aos="fade-up" data-aos-easing="ease" data-aos-delay="200" data-aos-duration="500">
      {% if section.settings.custom_description != blank %}
        {{ section.settings.custom_description | replace: '<p>','' | replace: '</p>','' }}
      {% else %}
        {% if page.description %}
            {{ page.metafields.custom.short_description }}
        {% else %}
            {{ collection.description }}
        {% endif %}
      {% endif %}
    </div>
    <div class="search-nav-container col_20 h-mobile" data-aos="fade-up" data-aos-easing="ease" data-aos-delay="250" data-aos-duration="500">
      <div class="search-input ">
          <input name="search" placeholder="Enter your keywords" class="article-search f-f-regular" id="search-input-mobile">
          <label class="search-label">Enter your keywords</label>
          <button class="btn-search">
              <span class="svg-wrapper">
                {{- 'search-icon.svg' | inline_asset_content -}}
              </span>
          </button>
      </div>
    </div>
</div>
{% schema %}
    {
        "class": "blog-banner-section",
        "name": "Blog Banner Section",
        "templates": ["blog","page"],
        "settings": [
            
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Background Image - Desktop"
                },
            
                {
                    "type": "image_picker",
                    "id": "image_mobile",
                    "label": "Background Image - Mobile"
                },
                {
                    "type": "text",
                    "id": "custom_title",
                    "label": "Custom Title"
                },
                {
                    "type": "richtext",
                    "id": "custom_description",
                    "label": "Custom Description"
                }
        ],
        "presets" :[{
          "name" : "Blog Banner Section"
        }]
    }
{% endschema %} 