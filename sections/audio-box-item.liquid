{% style %}
    .audio-box-row{
        --bs-gutter-x:3rem;
        --bs-gutter-y:2rem;
    }
    .box-item {
        display:flex;
        flex-direction:column;
        align-items:center;
        justify-content:center;
    }
    .box-item .image-container{
        background: linear-gradient( 180deg, #313131 0%, #0F0D10 100%);
        border-radius: 24px 24px 24px 24px;
        max-height:500px;
        overflow:hidden;
    }
    .box-item .image-container img{
        width:100%;
        height:100%;
    }
    .box-item a{
        color:#000;
        text-decoration:underline;
    }
    .box-item a:hover{
        color:#FF8832;
    }
    .box-item a svg{
        width: 12px;
        height: 12px;
        margin-left:7px;
    }
    .box-item a:hover svg path{
        fill:#FF8832;
    }
{% endstyle %}
<div class="page-width section-content"> 
    <div class="row audio-box-row">
      {% for block in section.blocks %}
          <div class="col-lg-4 col-md-4 col-sm-12">
              <div class="box-item">
                  <a href="{{ block.settings.link }}" class="image-container mb-5">
                      <img src="{{ block.settings.image | img_url: 'master' }}" width="100%" height="100%">
                  </a>
                  <h4 class="f-f-extra-bold text-center my-0 pb-4 d-lg-block d-md-block d-sm-none">{{ block.settings.heading }}</h4>
                  <h2 class="f-f-extra-bold text-center my-0 pb-4 d-lg-none d-md-none d-sm-block">{{ block.settings.heading }}</h2>
                
                  <p class="f-f-regular text-center my-0 l-h-normal pb-4">{{- block.settings.description -}}</p>
                  <a href="{{ block.settings.link }}" class="">{{- block.settings.btn_label -}}<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="#000000" height="800px" width="800px" version="1.1" id="Layer_1" viewBox="0 0 330 330" xml:space="preserve">
                        <path id="XMLID_222_" d="M250.606,154.389l-150-149.996c-5.857-5.858-15.355-5.858-21.213,0.001  c-5.857,5.858-5.857,15.355,0.001,21.213l139.393,139.39L79.393,304.394c-5.857,5.858-5.857,15.355,0.001,21.213  C82.322,328.536,86.161,330,90,330s7.678-1.464,10.607-4.394l149.999-150.004c2.814-2.813,4.394-6.628,4.394-10.606  C255,161.018,253.42,157.202,250.606,154.389z" fill="#000"></path>
                    </svg>
                  </a>
              </div>
          </div>
      {% endfor %}
    </div>
</div>
{% schema %}
    {
        "class": "audio-box-item-section",
        "name": "Audio Box Item",
        "templates": ["page"],
        "blocks": [
            {
                "type": "box",
                "name": "Box",
                "settings": [
                   {
                       "type": "image_picker",
                       "id": "image",
                       "label": "Image"
                   },
                   {
                       "type": "text",
                       "id": "heading",
                       "label": "Heading"
                   },
                   {
                       "type": "textarea",
                       "id": "description",
                       "label": "Description"
                   },
                   {
                       "type": "text",
                       "id": "btn_label",
                       "label": "Button Label",
                       "default": "Learn More"
                   },
                   {
                       "type": "url",
                       "id": "link",
                       "label": "Link"
                   }
                ]
            }
        ]
    }
{% endschema %} 