{% style %}
  .featured-products-section {
    padding: 80px 0px;
  }
  .featured-products-section .btn-learn-more {
    background-color: #fff;
    border-radius: 50px;
    padding: 8px 2rem;
    transition: all 0.3s ease;
  }
  .featured-products-section .btn-learn-more p {
    color: #000;
  }
  .featured-products-section .btn-learn-more:hover {
    background-color: #ff8832;
  }
  .featured-products-section .btn-learn-more:hover p {
    color: #fff;
  }
  .btn-buy-now {
    background-color: #000;
    border-radius: 50px;
    padding: 8px 3rem;
    transition: all 0.3s ease;
  }
  .btn-buy-now:hover {
    background-color: #ff8832;
  }
  .btn-buy-now p {
    color: #fff;
  }
  .product-btn {
    display: flex;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .featured-full-width-product-details {
    position: relative;
    margin-top: 30px;
    border-radius: 22px;
    overflow: hidden;
    display: flex;
  }
  .featured-full-width-product-details img {
    width: 100%;
    height: 100%;
  }
  .featured-products-section .featured-full-width-content {
    position: absolute;
    top: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
    padding-left: 10vh;
  }
  .featured-product-grid-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-column-gap: 20px;
    margin-top: 20px;
  }
  .featured-product-item {
    padding: 70px 50px 50px;
    background-color: #f9f9f9;
    border-radius: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .featured-product-image img {
    width: 100%;
    height: 450px;
    object-fit: contain;
    transition: all 0.3s ease;
  }
  .featured-product-image img:hover {
    scale: 1.2;
  }
  .link-product {
    width: fit-content;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .link-product svg {
    width: 10px;
    height: 10px;
    margin-top: 1px;
  }
  .featured-product-content-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
    .featured-products-section {
      padding: 50px 0px;
    }
    .featured-products-section .heading {
      text-align: center;
    }
    .featured-products-section .featured-full-width-product-details {
      flex-direction: column;
      margin-top: 20px;
      gap: 10px;
      /* position: relative; */
    }
    .featured-products-section .featured-full-width-content {
      /* position: absolute; */
      position: relative;
      padding-left: 0px;
    }
    .featured-products-section .featured-full-width-content.top-1 {
      top: 0;
    }
    .featured-products-section .featured-full-width-content.top-2 {
      top: 30px;
    }
    .featured-products-section .featured-full-width-content.top-3 {
      top: 60px;
    }
    .featured-products-section .featured-full-width-content {
      justify-content: flex-start;
      align-items: center;
      padding-top: 20px;
      padding-left: 20px;
      padding-right: 20px;
    }
    .featured-products-section .featured-full-width-content .sub-heading,
    .featured-products-section .featured-full-width-content .heading {
      text-align: center;
    }
    .featured-product-grid-list {
      grid-template-columns: 1fr;
      grid-row-gap: 50px;
      margin-top: 50px;
    }
    .featured-product-item {
      padding: 0px;
      flex-direction: column-reverse;
      background-color: #fff;
    }
    .featured-product-item .featured-product-image {
      margin-bottom: 20px;
      padding: 20px 40px;
      background-color: #f9f9f9;
      border-radius: 12px;
    }
    .link-product {
      background-color: #ff8832;
      font-size: 14px;
      padding: 8px 3rem;
      border-radius: 50px;
    }
    .link-product svg {
      display: none;
    }
    .featured-products-section .link-product p {
      color: #fff !important;
    }
    .featured-products-section .btn-learn-more {
      background-color: #dbdbdb;
    }
    .featured-product-image img {
      height: 100%;
    }
  }

  /* ipad Air */
  @media only screen and (min-device-width: 768px) and (max-device-width: 1024px) {
    .featured-products-section {
      padding: 50px 0px;
    }
    .featured-products-section .heading {
      text-align: center;
    }
    .featured-full-width-product-details {
      margin-top: 20px;
    }
    .featured-full-width-content {
      position: relative;
      padding-left: 0px;
    }
    .featured-full-width-content {
      align-items: center;
      padding-top: 20px;
      padding-left: 20px;
      padding-right: 20px;
    }
    .featured-full-width-content .sub-heading,
    .featured-full-width-content .heading {
      text-align: center;
    }
    .featured-product-grid-list {
      grid-template-columns: 1fr;
      grid-row-gap: 50px;
      margin-top: 50px;
    }
    .featured-product-item .featured-product-image {
      margin-bottom: 20px;
      padding: 20px 40px;
      background-color: #f9f9f9;
      border-radius: 12px;
    }
    .link-product {
      background-color: #ff8832;
      font-size: 14px;
      padding: 8px 3rem;
      border-radius: 50px;
    }
    .link-product svg {
      display: none;
    }
    .featured-products-section .link-product p {
      color: #fff !important;
    }
    .featured-products-section .btn-learn-more {
      background-color: #dbdbdb;
    }
    .featured-product-image img {
      height: 100%;
    }
  }

  @media (min-width: 1024px) and (orientation: portrait) {
    .featured-product-image img {
      height: 350px;
    }
  }

  /* COMPUTERS */
  @media (min-width: 1024px) and (orientation: landscape) {
    .featured-product-image img {
      height: 350px;
    }
  }
  @media only screen and (min-width: 1280px) {
    .featured-product-image img {
      height: 350px;
    }
  }
  @media only screen and (min-width: 1366px) {
    .featured-product-image img {
      height: 350px;
    }
  }
  @media only screen and (min-width: 1440px) {
    .featured-product-image img {
      height: 380px;
    }
  }
  @media only screen and (min-width: 1536px) {
    .featured-product-image img {
      height: 400px;
    }
  }
  @media only screen and (min-width: 1600px) {
    .featured-product-image img {
      height: 430px;
    }
  }
  @media only screen and (min-width: 1920px) {
    .featured-product-image img {
      height: 450px;
    }
  }

  .featured-products-section .featured-full-width-content .sub-heading {
    font-size: var(--font-size);
    color: var(--color);
    @media (max-width: 768px) {
      font-size: var(--font-size-mobile);
      color: var(--color-mobile);
    }
  }
  .featured-products-section .featured-full-width-content .heading {
    font-size: var(--font-size);
    color: var(--color);
    @media (max-width: 768px) {
      font-size: var(--font-size-mobile);
      color: var(--color-mobile);
    }
  }
{% endstyle %}
<div class="page-width">
  <h2 class="heading text-md f-f-bold mx-0">{{ section.settings.section_heading }}</h2>
  <div class="featured-full-width-product-details">
    <img
      loading="lazy"
      src="{{ section.settings.bg_image |  img_url: 'master' }}"
      alt="{{ section.settings.bg_image.alt | default: section.settings.bg_image.src | split: '/' | last | split: '?' | first | split: '.' | first | escape }}"
      {% if section.settings.bg_image_mobile != blank %}
        class="h-desktop"
      {% endif %}
      alt="{{ section.settings.bg_image.alt | default: section.settings.bg_image.src | split: '/' | last | split: '?' | first | split: '.' | first | escape }}"
      width="100%"
      height="auto"
    >
    {% if section.settings.bg_image_mobile != blank %}
      <img
        loading="lazy"
        src="{{ section.settings.bg_image_mobile  | img_url: 'master' }}"
        alt="{{ section.settings.bg_image_mobile.alt | default: section.settings.bg_image_mobile.src | split: '/' | last | split: '?' | first | split: '.' | first | escape }}"
        class="h-mobile"
        width="100%"
        height="auto"
      >
    {% endif %}

    <div class="featured-full-width-content col_35  ">
      <h4
        class="sub-heading {{section.settings.sub_heading_weight}} {{section.settings.sub_heading_weight_mobile}} mx-0  "
        style="--font-size: {{ section.settings.sub_heading_font_size }}px; --color: {{ section.settings.sub_heading_color }}; --font-size-mobile: {{ section.settings.sub_heading_font_size_mobile }}px; --color-mobile: {{ section.settings.sub_heading_color_mobile }};"
      >
        {{ section.settings.sub_heading }}
      </h4>
      <h2
        class="heading text-md {{section.settings.heading_weight}} {{section.settings.heading_weight_mobile}} mx-0"
        style="--font-size: {{ section.settings.heading_font_size }}px; --color: {{ section.settings.heading_color }}; --font-size-mobile: {{ section.settings.heading_font_size_mobile }}px; --color-mobile: {{ section.settings.heading_color_mobile }}; "
      >
        {{ section.settings.heading }}
      </h2>
      <div class="product-btn">
        <a href="{{ section.settings.product.url }}" class="btn btn-learn-more">
          <p class="f-f-regular mx-0">
            {{ section.settings.button_learn_more }}
            <span class="visually-hidden">about {{ product.title }}</span>
          </p>
        </a>
        {%- assign prefix = '' -%}
        {%- if localization.language.root_url != '/' -%}
          {%- assign prefix = localization.language.root_url -%}
        {%- endif -%}
        <a
          href="{{ prefix }}/cart/{{ section.settings.product.selected_or_first_available_variant.id }}:1"
          class="btn btn-buy-now"
          aria-label="Buy {{ section.settings.product.title }} now"
        >
          <p class="f-f-regular mx-0">{{ section.settings.button_buy_now }}</p>
        </a>
      </div>
    </div>
  </div>
  <div class="featured-product-grid-list">
    {% for block in section.blocks %}
      <div class="featured-product-item">
        <div class="featured-product-content-container">
          <h5 class="f-f-regular center mx-0">{{ block.settings.sub_heading }}</h5>
          <h2 class="text-sm f-f-bold mx-0 center col_70 my-auto">{{ block.settings.heading }}</h2>
          <a
            href="{{  block.settings.product.url  }}"
            class="link-product center"
            aria-label="Buy {{ block.settings.product.title }} now"
          >
            <p class="mx-0 f-f-regular main-color">
              {{ block.settings.button_buy_now }}
            </p>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              fill="#000000"
              height="800px"
              width="800px"
              version="1.1"
              id="Layer_1"
              viewBox="0 0 330 330"
              xml:space="preserve"
              aria-hidden="true"
            >
              <path id="XMLID_222_" d="M250.606,154.389l-150-149.996c-5.857-5.858-15.355-5.858-21.213,0.001  c-5.857,5.858-5.857,15.355,0.001,21.213l139.393,139.39L79.393,304.394c-5.857,5.858-5.857,15.355,0.001,21.213  C82.322,328.536,86.161,330,90,330s7.678-1.464,10.607-4.394l149.999-150.004c2.814-2.813,4.394-6.628,4.394-10.606  C255,161.018,253.42,157.202,250.606,154.389z" fill="#f60"></path>
            </svg>
          </a>
        </div>
        <div class="featured-product-image">
          {% if block.settings.custom_featured_image != blank %}
            <img
              loading="lazy"
              src="{{ block.settings.custom_featured_image | img_url: 'master' }}"
              alt="{{ block.settings.custom_featured_image.alt | default: block.settings.custom_featured_image.src | split: '/' | last | split: '?' | first | split: '.' | first | escape }}"
              width="100%"
              height="auto"
            >
          {% else %}
            <img
              loading="lazy"
              src="{{ block.settings.product.selected_or_first_available_variant.featured_image | img_url: 'master' }}"
              alt="{{ block.settings.product.selected_or_first_available_variant.featured_image.alt | default: block.settings.product.selected_or_first_available_variant.featured_image.src | split: '/' | last | split: '?' | first | split: '.' | first | escape }}"
              width="100%"
              height="auto"
            >
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
