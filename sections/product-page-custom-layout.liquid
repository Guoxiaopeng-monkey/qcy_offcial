{% style %}
    .gallery-featured-image-section{
        padding:50px 0px 50px;
    }
    .gallery-featured-list-container{
        display:flex;
        flex-direction: column;
    }
    .gallery-featured-item{
        display:flex;
        overflow:hidden;
    }
    .gallery-featured-list-container,
    .gallery-featured-item{
        gap:25px;
    }
    .gallery-image-item{
        border-radius:10px;
        overflow:hidden;
        position:relative;
        display:flex;
    }
    .gallery-image-item:hover img{
        scale:1.03;
    }
    .gallery-image-item img{
        width:100%;
        height:100%;
        object-fit:cover;
        transition: all 0.3s ease;
    }
    .gallery-content-detail{
        position: absolute;
        top: 0;
        padding: 25px 35px;
        display: flex;
        align-items:var(--heading-position);
        width: 100%;
        height:100%;
    }
    .gallery-content-detail p{
        margin:0px;
    }
    .gallery-content-detail ul{
        list-style: disc;
        padding-left: 25px;
    }
    .gallery-content-detail strong{
        font-weight:normal;
        font-family: var(--secondary-font-weight);
        color: var(--secondary-color);
        font-size:var(--secondary-font-size);
    }
    .gallery-content-detail .arrow-down-icon{
        width:30px;
        height:30px;
        background-color:#fff;
        border-radius:50px;
    }
    .gallery-image-item:hover .gallery-content-detail .arrow-down-icon{
        background-color:#FF8832;
    }
    .gallery-image-item:hover .gallery-content-detail .arrow-down-icon .icon-path{
        fill:#fff;
    }
    .gallery-two-col{
      display:flex;
      gap:10px;
    }
    .gallery-featured-container{
      display:none;
    }
    .single-bg-image-container img{
        width:100%;
        height:100%;
        object-fit:contain;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .gallery-featured-image-section{
            padding:50px 0px;
        }
        .gallery-featured-container{
          display:flex;
          flex-direction:column;
          gap:10px;
        }
        .gallery-content-detail{
          padding:20px 20px;
        }
        .gallery-featured-list-container{
          display:none;
        }
    }

    /* ipad Air */
    @media only screen 
        and (min-device-width : 768px) 
        and (max-device-width : 1024px) {
        .gallery-featured-image-section{
            padding:50px 0px;
        }
        .gallery-featured-container{
          display:flex;
          flex-direction:column;
          gap:10px;
        }
        .gallery-content-detail{
          padding:20px 20px;
        }
        .gallery-featured-list-container{
          display:none;
        }
    }


