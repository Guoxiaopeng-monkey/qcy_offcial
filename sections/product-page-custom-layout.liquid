        "limit": 1, 
        "settings": [
            {
                "type": "text",
                "id": "header_nav",
                "label": "Header Nav",
                "default": "Features"
            },
            {
                "type": "image_picker",
                "id": "bg_image",
                "label": "Background Image"
            },
            {
                "type": "image_picker",
                "id": "bg_image_mobile",
                "label": "Background Image Mobile"
            }
        ],
        "max_blocks": 5,
        "blocks": [
            {
                "type": "item",
                "name": "Item",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "image_picker",
                        "id": "image_mobile",
                        "label": "Image - Mobile"
                    },
                    {
                        "type": "richtext",
                        "id": "heading",
                        "label": "Heading",
                        "info": "Don't update the paragraph style in this input: Need to be P- paragraph"
                    },
                    {
                        "type": "color",
                        "id": "primary_color",
                        "label": "Primary Color",
                        "default":"#fff"
                    },
                    {
                        "type": "color",
                        "id": "secondary_color",
                        "label": "Secondary Color",
                        "default":"#ff8832"
                    },
                    {
                      "type": "select",
                      "id": "primary_weight",
                      "label": "Primary - Font Weight",
                      "options": [
                          {
                            "value": "f-f-regular",
                            "label": "Regular"
                          },
                          {
                            "value": "f-f-medium",
                            "label": "Medium"
                          },
                          {
                            "value": "f-f-semibold",
                            "label": "Semi-Bold"
                          },
                          {
                            "value": "f-f-bold",
                            "label": "Bold"
                          },
                          {
                            "value": "f-f-extra-bold",
