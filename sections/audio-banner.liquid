{% style %}
    .audio-banner-section{
        height:85vh;
        position:relative;
    }
    .audio-banner-section .bg-banner{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .audio-banner-section .banner-main-content{
        height:100%;
        width:100%;
        position:absolute;
        top:0;
        left:0;
        display: flex;
        justify-content: center;
        padding-top: 80px;
    }
{% endstyle %}
<img src="{{ section.settings.Image | img_url: 'master' }}" width="100%" height="100%" class="bg-banner
  {% if section.settings.Image_mobile != blank %}
      d-lg-block d-md-block d-sm-none
  {% endif %}
  ">
{% if section.settings.Image_mobile != blank %}
  <img src="{{ section.settings.Image_mobile | img_url: 'master' }}" width="100%" height="100%" class="bg-banner d-lg-none d-md-none d-sm-block">
{% endif %}
<div class="banner-main-content">
    <div class="col-lg-5 col-md-8 col-sm-12">
          <h2 class="f-f-bold text-md white-f my-3 text-center">
              {{ section.settings.heading }}
          </h2>
          <div class="f-f-regular h5 white-f text-center">
              {{ section.settings.description }}
          </div>
    </div>
  
</div>
{% schema %}
    {
        "class": "audio-banner-section",
        "name": "Audio Banner",
        "settings": [
            {
                "type": "image_picker",
                "id": "Image",
                "label": "Image"
            },
            {
                "type": "image_picker",
                "id": "Image_mobile",
                "label": "Image - Mobile"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Wind Noise Resistance for Call Clarity"
            },
            {
                "type": "textarea",
                "id": "description",
                "label": "Description",
                "default": "With QCY's patented mic structure and wind noisereduction algorithm, your calls stay clear even inbreezy outdoor environments."
            }
        ],
        "templates": ["page"],
        "presets": [
            {
                "name": "Audio Banner",
            }
        ]
    }
{% endschema %} 