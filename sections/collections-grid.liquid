{% style %}
  .qcy-collections {
    padding: 40px 20px;
    margin: 0 auto;
    max-width: 1200px;
    text-align: left;
  }
  .qcy-collections p.description {
    margin-top: 20px;
    margin-bottom: 20px;
  }
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin: 0;
  }
  .collection-item {
    position: relative;
    background: #f9f9f9;
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }
  .collection-item img {
    width: 100%;
    aspect-ratio: 16 / 9; 
    object-fit: cover;
  }
  .collection-item .content {
    padding: 15px;
  }
  .shop-now-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #FF8832;
    color: #fff;
    padding: 10px 20px;
    border-radius: 50px;
    opacity: 0;
    transition: opacity 0.3s ease;
    text-decoration: none;
    font-weight: bold;
    text-align: center;
    white-space: nowrap;
  }
  .collection-item:hover .shop-now-btn {
    opacity: 1;
  }
  .collection-item:hover img {
    filter: brightness(70%);
  }
  .pagination {
    display: flex;
    justify-content: center;
    margin-top: 30px;
  }
  .pagination button {
    background: #ddd;
    border: none;
    padding: 10px;
    margin: 0 5px;
    border-radius: 50%;
    cursor: pointer;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pagination button.active {
    background: #FF8832;
    color: #fff;
  }
  /* Custom heading styles to match system-defined sizes */
  .qcy-collections h1.heading {
    font-size: var(--font-size-h2, 28px); /* Adjust to match your theme's h2 size */
    line-height: var(--line-height-h2, 1.2); /* Optional: match line-height */
  }
  .collection-item h2.heading {
    font-size: var(--font-size-h3, 20px); /* Adjust to match your theme's h3 size */
    line-height: var(--line-height-h3, 1.3); /* Optional: match line-height */
  }
  @media (max-width: 767px) {
    .collections-grid {
      grid-template-columns: 1fr;
    }
    .shop-now-btn {
      display: none;
    }
    .shop-all-btn {
      display: block;
      background: #FF8832;
      color: #fff;
      padding: 10px 20px;
      border-radius: 50px;
      text-align: center;
      text-decoration: none;
      margin: 10px 15px;
      font-weight: bold;
      font-size:14px;
    }
    /* Adjust heading sizes for mobile if needed */
    .qcy-collections h1.heading {
      font-size: var(--font-size-h2-mobile, 24px); /* Adjust for mobile h2 size */
    }
    .collection-item h2.heading {
      font-size: var(--font-size-h3-mobile, 18px); /* Adjust for mobile h3 size */
    }
  }
  @media (min-width: 768px) {
    .shop-all-btn {
      display: none;
    }
  }
{% endstyle %}

<div class="qcy-collections">
  <h1 class="heading t-up f-f-bph m-0 text-lg f-f-extra-bold mx-0">{{ section.settings.title }}</h1>
  <p class="description f-f-regular gray-f mx-0">{{ section.settings.description }}</p>
  
  <div class="collections-grid" id="collections-grid">
    {% for block in section.blocks %}
      {% if forloop.index0 < 8 %}
        <div class="collection-item" data-page="1" style="display: block;">
          {% if block.settings.image %}
            <img loading="lazy" src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.title }}">
          {% endif %}
          <a href="{{ block.settings.custom_url | default: block.settings.collection.url }}" class="shop-now-btn">{{ section.settings.button_text }} {{ block.settings.title }}</a>
          <div class="content">
            <h2 class="heading f-f-bold">{{ block.settings.title }}</h2>
            <p class="mx-0 f-f-regular gray-f">{{ block.settings.description }}</p>
            <a href="{{ block.settings.custom_url | default: block.settings.collection.url }}" class="shop-all-btn">{{ section.settings.button_text }} {{ block.settings.title }}</a>
          </div>
        </div>
      {% else %}
        <div class="collection-item" data-page="{{ forloop.index0 | divided_by: 8 | plus: 1 }}" style="display: none;">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.title }}">
          {% endif %}
          <a href="{{ block.settings.custom_url | default: block.settings.collection.url }}" class="shop-now-btn">{{ section.settings.button_text }} {{ block.settings.title }}</a>
          <div class="content">
            <h2 class="heading f-f-bold">{{ block.settings.title }}</h2>
            <p class="mx-0 f-f-regular gray-f">{{ block.settings.description }}</p>
            <a href="{{ block.settings.custom_url | default: block.settings.collection.url }}" class="shop-all-btn">{{ section.settings.button_text }} {{ block.settings.title }}</a>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.blocks.size > 8 %}
    <div class="pagination">
      {% assign total_pages = section.blocks.size | divided_by: 8 %}
      {% assign remainder = section.blocks.size | modulo: 8 %}
      {% if remainder > 0 %}
        {% assign total_pages = total_pages | plus: 1 %}
      {% endif %}
      {% for i in (1..total_pages) %}
        <button class="page-btn {% if forloop.first %}active{% endif %}" data-page="{{ i }}">{{ i }}</button>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const grid = document.getElementById('collections-grid');
    const items = grid.querySelectorAll('.collection-item');
    const pageButtons = document.querySelectorAll('.page-btn');

    pageButtons.forEach(button => {
      button.addEventListener('click', function() {
        const page = this.getAttribute('data-page');
        
        pageButtons.forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');

        items.forEach(item => {
          if (item.getAttribute('data-page') === page) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "QCY Collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "QCY Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Elevate your listening experience with our handpicked headphones, earbuds, and speakers."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop All",
      "info": "Text to display before the collection title on buttons (e.g., 'Shop All')"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Collection Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Collection Description"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection",
          "info": "Select a collection or enter a custom URL below"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom URL",
          "info": "Enter a custom URL to override the collection URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "QCY Collections",
      "blocks": []
    }
  ]
}
{% endschema %}