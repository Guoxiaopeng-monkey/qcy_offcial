<style>
  .promotion-banner{
    position:relative;
  }
  .promotion-banner .page-width{
    display:flex;
    flex-direction:column;
    gap:1rem;
    position:absolute;    
    top: 0;
    width: 100%;
    height:100%;
    left: 0;
    right: 0;
  }
  .promotion-banner .background-image{
    object-fit:cover;
  }
  .promotion-banner .day-box,
  .promotion-banner .hour-box,
  .promotion-banner .minutes-box,
  .promotion-banner .second-box{
    display:flex;
    flex-direction:column;
    gap:1rem;
  }
  .promotion-banner .day-box span,
  .promotion-banner .hour-box span,
  .promotion-banner .minutes-box span,
  .promotion-banner .second-box span{
    background-color:#fff;
    padding: 1rem 1.5rem;
    border-radius:4px;
    position:relative;
  }
  .promotion-banner .day-box span:before,
  .promotion-banner .hour-box span:before,
  .promotion-banner .minutes-box span:before{
    content:":";
    color:#fff;
    position:absolute;
    right:-48%;
  }
  .count-down-container{
    display:flex;
    flex-direction: column;
    padding-top:30px;
    gap:1.5rem;
  }
  .count-down-list{
    display:flex;
    gap:50px;
  }
  
  .content-desktop-y-top{
      justify-content: flex-start;
  }
  .content-desktop-y-center{
      justify-content: center;
  }
  .content-desktop-y-bottom{
      justify-content: flex-end;
  }

  .content-desktop-x-left{
