<style>
  .about-us-banner-section{
    position:relative;
  }
  .about-us-banner-section .content-section{
    position:absolute;
    top:0;
    left:0;
    height:100%;
    width:100%;
    z-index:1;
  }
  .about-us-banner-section .overlay{
    display:block;
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background-color:#000;
    opacity:0;
    transition: all 0.5s ease;
  }
  .about-us-banner-section .overlay.show{
    opacity:0.3;
  }
  .about-us-banner-section .page-width{
    height:100%;
  }
  .about-us-banner-section .content-container{
    display:flex;
    flex-direction:column;
    gap:1rem;
    height:100%;
    position:relative;
    z-index:2;
  }
  
  .about-us-banner-section .content-container .heading,
  .about-us-banner-section .content-container .description{
    width:100%;
  }
  
  .content-desktop-y-top{
      justify-content: flex-start;
  }
  .content-desktop-y-center{
      justify-content: center;
  }
  .content-desktop-y-bottom{
      justify-content: flex-end;
  }

  .content-desktop-x-left{
      align-items: flex-start;
  }
  .content-desktop-x-center{
      align-items: center;
  }
  .content-desktop-x-right{
      align-items: flex-end;
  }
  
  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
      .content-mobile-y-top{
          justify-content: flex-start;
      }
      .content-mobile-y-center{
          justify-content: center;
      }
      .content-mobile-y-bottom{
          justify-content: flex-end;
      }
  }
  
  /* ipad Air */
  @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
      .content-mobile-y-top{
          justify-content: flex-start;
      }
      .content-mobile-y-center{
          justify-content: center;
      }
      .content-mobile-y-bottom{
          justify-content: flex-end;
      }
  }

</style>
<span class="overlay">
  
</span>
<img loading="lazy" src="{{ section.settings.image | img_url: 'master' }}"  width="100%" height="100%"
  {% if section.settings.image_mobile != blank %}
  class="h-desktop"
  {% endif %}
>
{% if section.settings.image_mobile != blank %}
  <img loading="lazy" src="{{ section.settings.image_mobile | img_url: 'master' }}" class="h-mobile" width="100%" height="100%">
{% endif %}
<div class="content-section">
  <div class="page-width">
    <div class="content-container {{ section.settings.content_position_y }}  {{ section.settings.content_position_x }} {{ section.settings.content_position_y_mobile }}">
      <h1 class="heading text-lg mx-0 f-f-bold white-f {{ section.settings.text_alignment }} {% if section.settings.hide_heading %}hidden{% endif %}"  data-aos="fade-up" data-aos-easing="ease" data-aos-delay="500" data-aos-duration="600" data-aos-once="true">{{ section.settings.heading }}</h1>
      <div class="description mx-0 white-f p {{ section.settings.text_alignment }} {% if section.settings.hide_description %}hidden{% endif %}"  data-aos="fade-up" data-aos-easing="ease" data-aos-delay="700" data-aos-duration="600" data-aos-once="true">{{ section.settings.description }}</div>
    </div>
  </div> 
</div>
<script>
$(document).ready(function() {
  setTimeout(function() {
    $('.about-us-banner-section .overlay').addClass('show');
  }, 300);
});

</script>
{% schema %}
    {
        "class": "about-us-banner-section",
        "name": "About Us Banner Section",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Image Mobile"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "What is Lorem Ipsum"
          },
          {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged</p>"
          },
          {
              "type": "select",
              "id": "text_alignment",
              "label": "Text Alignment",
              "options": [
                  {
                    "value": "left",
                    "label": "Left"
                  },
                  {
                    "value": "center",
                    "label": "Center"
                  },
                  {
                    "value": "right",
                    "label": "Right"
                  }
              ],
              "default": "center"
          },
          {
            "type": "checkbox",
            "id": "hide_heading",
            "label": "Hide Heading",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "hide_description",
            "label": "Hide Description",
            "default": false
          },
          {
              "type": "header",
              "content": "Content Position"
          },
          {
              "type": "select",
              "id": "content_position_y",
              "label": "Content Position Y",
              "options": [
                  {
                    "value": "content-desktop-y-top",
                    "label": "Top"
                  },
                  {
                    "value": "content-desktop-y-center",
                    "label": "Center"
                  },
                  {
                    "value": "content-desktop-y-bottom",
                    "label": "Bottom"
                  }
              ],
              "default": "content-desktop-y-center"
          },
          {
              "type": "select",
              "id": "content_position_x",
              "label": "Content Position X",
              "options": [
                  {
                    "value": "content-desktop-x-left",
                    "label": "Left"
                  },
                  {
                    "value": "content-desktop-x-center",
                    "label": "Center"
                  },
                  {
                    "value": "content-desktop-x-right",
                    "label": "right"
                  }
              ],
              "default": "content-desktop-x-left"
          },
          {
              "type": "header",
              "content": "Content Position - Mobile"
          },
          {
              "type": "select",
              "id": "content_position_y_mobile",
              "label": "Content Position Y",
              "options": [
                  {
                    "value": "content-mobile-y-top",
                    "label": "Top"
                  },
                  {
                    "value": "content-mobile-y-center",
                    "label": "Center"
                  },
                  {
                    "value": "content-mobile-y-bottom",
                    "label": "Bottom"
                  }
              ],
              "default": "content-mobile-y-center"
          }
        ],
        "presets" :[{
            "name" : "About Us Banner Section"
        }]
    }
  {% endschema %} 