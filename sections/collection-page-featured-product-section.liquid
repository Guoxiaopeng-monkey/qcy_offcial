<style>
    .featured-products-section{
        padding:50px 0px;
    }
    .featured-products-section .btn-learn-more{
        background-color:#fff;
        border-radius:50px;
        padding:8px 3rem;
        transition: all 0.3s ease;
    }
    .featured-products-section .btn-learn-more p{
        color:#000;
    }
    .featured-products-section .btn-learn-more p{
        color:#000;
    }
    .featured-products-section .btn-learn-more:hover{
        background-color:#FF8832;
    }
    .featured-products-section .btn-learn-more:hover p{
        color:#fff;
    }
    .btn-buy-now{
        background-color:#000;
        border-radius:50px;
        padding:8px 3rem;
        transition: all 0.3s ease;
    }
    .btn-buy-now:hover{
        background-color:#FF8832;
    }
    .btn-buy-now p{
        color:#fff;
    }
    .product-btn{
        display:flex;
        gap:1.5rem;
        margin-top:1rem;
    }
    .featured-full-width-product-details{
        position:relative;
    }
    .featured-full-width-product-details img{
        width:100%;
        height:100%;
    }
    .featured-full-width-content{
        position: absolute;
        top: 0;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: center;
        padding-left: 10vh;
    }
    .featured-product-grid-list{
        display:grid;
        grid-template-columns: repeat(3, 1fr);
        grid-column-gap:20px;
        margin-top:20px;
    }
    .featured-product-item{
        padding:70px 50px 50px;
        background-color:#f9f9f9;
        border-radius:32px;
        display:flex;
        flex-direction:column;
        justify-content:center;
        align-items: center;
        gap:1rem;
    }
    .featured-product-image img{
        width:100%;
        object-fit:contain;
        transition: all 0.3s ease;
    }
    .featured-product-image img:hover{
        scale:1.2;
    }
    .link-product{
        width: fit-content;
        display: flex;
        gap: 0.5rem;
        align-items: center;
        position:relative;
        z-index:2;
    }
    .link-product svg{
        width:10px;
        height:10px;
        margin-top:1px;
    }
    
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .featured-products-section{
            padding:50px 0px;
        }
        .featured-products-section .heading{
            text-align:center;
        }
        .featured-full-width-product-details{
        }   
        .featured-full-width-content{
            position:relative;
            padding-left:0px;
        }
        .featured-full-width-content{
            align-items: center;
            padding-top:20px;        
            padding-left: 20px;
            padding-right: 20px;
        }
        .featured-full-width-content .sub-heading,
        .featured-full-width-content .heading{
            text-align:center;
        }
        .featured-product-grid-list{
            grid-template-columns: 1fr;
            grid-row-gap: 50px;
            margin-top:50px;
        }
        .featured-product-item{
            padding:0px;
            flex-direction: column-reverse;
            background-color:#fff;
        }
        .featured-product-item .featured-product-image{
            margin-bottom:20px;
            padding:20px 40px;
            background-color:#F9F9F9;
            border-radius:12px;
        }
        .link-product{
            background-color:#FF8832;
            font-size:14px;
            padding:8px 3rem;
            border-radius:50px;
        }
        .link-product svg{
            display:none;
        }
        .link-product p{
            color:#fff;
        }
        .featured-products-section .btn-learn-more{
            background-color:#DBDBDB;
        }
    }

    /* ipad Air */
    @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px) {
        .featured-products-section{
            padding:50px 0px;
        }
        .featured-products-section .heading{
            text-align:center;
        }   
        .featured-full-width-product-details{
            margin-top:20px;
        }   
        .featured-full-width-content{
            position:relative;
            padding-left:0px;
        }
        .featured-full-width-content{
            align-items: center;
            padding-top:20px;   
            padding-left: 20px;
            padding-right: 20px;
        }
        .featured-full-width-content .sub-heading,
        .featured-full-width-content .heading{
            text-align:center;
        }
        .featured-product-grid-list{
            grid-template-columns: 1fr;
            grid-row-gap: 50px;
            margin-top:50px;
        }
        .featured-product-item .featured-product-image{
            margin-bottom:20px;
            padding:20px 40px;
            background-color:#F9F9F9;
            border-radius:12px;
        }
        .link-product{
            background-color:#FF8832;
            font-size:14px;
            padding:8px 3rem;
            border-radius:50px;
        }
        .link-product svg{
            display:none;
        }
        .link-product p{
            color:#fff;
        }
        .featured-products-section .btn-learn-more{
            background-color:#DBDBDB;
        }
    }
</style>
<div class="page-width">
    <h2 class="heading text-md f-f-bold mx-0">{{ section.settings.section_heading }}</h2>
    <div class="featured-full-width-product-details">
        <img loading="lazy" src="{{ section.settings.bg_image |  img_url: 'master' }}" alt="" 
        {% if section.settings.bg_image_mobile != blank %}
        class="h-desktop"
        {% endif %}
        >
        {% if section.settings.bg_image_mobile != blank %}
            <img loading="lazy" src="{{ section.settings.bg_image_mobile  | img_url: 'master' }}" alt="" class="h-mobile">
        {% endif %}

        <div class="featured-full-width-content col_35">

            <h4 class="sub-heading f-f-regular mx-0 gray-f">{{ section.settings.sub_heading }}</h4>
            <h2 class="heading text-md f-f-bold mx-0">{{ section.settings.heading }}</h2>
            <div class="product-btn">
                <a href="{{ section.settings.product.url }}" class="btn btn-learn-more">
                    <p class="f-f-regular mx-0">Learn More</p>
                </a>
                <a href="/cart/{{ section.settings.product.selected_or_first_available_variant.id }}:1" class="btn btn-buy-now">
                    <p class="f-f-regular mx-0">Buy Now</p>
                </a>
            </div>
        </div>
    </div>
</div>
{% schema %}
    {
      
        "class": "featured-products-section",
        "name": "Featured Products",
        "templates": ["collection"],
        "limit": 1,
        "settings": [
            {
                "type": "text",
                "id": "section_heading",
                "label": "Section Heading" ,
                "default": "Feature Product"
            },
            {
                "type": "product",
                "id": "product",
                "label": "Product"
            },
            {
                "type": "image_picker",
                "id": "bg_image",
                "label": "Background Image"
            },
            {
                "type": "image_picker",
                "id": "bg_image_mobile",
                "label": "Background Image - Mobile"
            },
            {
                "type": "text",
                "id": "sub_heading",
                "label": "Sub Heading",
                "default": "QCY H3"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading" ,
                "default": "Endless Melody Staying with You"
            }
        ],
        "presets" :[{
            "name" : "Featured Products"
        }]
    }
  {% endschema %} 