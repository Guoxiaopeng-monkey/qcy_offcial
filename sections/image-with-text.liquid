<div class="image-with-text-section">
  <div class="image-wrapper">
    {%- if section.settings.image != blank -%}
      <div class="desktop-only">
        <img
          srcset="{%- if section.settings.image.width >= 1100 -%}{{ section.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
            {%- if section.settings.image.width >= 1500 -%}{{ section.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {%- if section.settings.image.width >= 1780 -%}{{ section.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
            {%- if section.settings.image.width >= 2000 -%}{{ section.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
            {{ section.settings.image | image_url }} {{ section.settings.image.width }}w"
          src="{{ section.settings.image | image_url: width: 1500 }}"
          sizes="100vw"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
        <div class="text-content desktop-text">
          {%- if section.settings.heading != blank -%}
            <h1 class="heading t-up f-f-bph m-0 text-lg f-f-extra-bold mx-0" style="color: {{ section.settings.desktop_heading_color | default: '#000000' }}">{{ section.settings.heading }}</h1>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="h4 f-f-bpp m-auto-r-l" style="color: {{ section.settings.desktop_text_color | default: '#000000' }}">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    
    {%- if section.settings.image_mobile != blank -%}
      <div class="mobile-only">
        <img
          srcset="{%- if section.settings.image_mobile.width >= 375 -%}{{ section.settings.image_mobile | image_url: width: 375 }} 375w,{%- endif -%}
            {%- if section.settings.image_mobile.width >= 750 -%}{{ section.settings.image_mobile | image_url: width: 750 }} 750w,{%- endif -%}
            {{ section.settings.image_mobile | image_url }} {{ section.settings.image_mobile.width }}w"
          src="{{ section.settings.image_mobile | image_url: width: 750 }}"
          sizes="100vw"
          alt="{{ section.settings.image_mobile.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.image_mobile.width }}"
          height="{{ section.settings.image_mobile.height }}"
        >
        <div class="text-content mobile-text">
          {%- if section.settings.heading != blank -%}
            <h1 class="heading t-up f-f-bph m-0 f-f-extra-bold mx-0" style="color: #000000; font-size: 22px;">{{ section.settings.heading }}</h1>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="h4 f-f-bpp m-auto-r-l">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
.image-with-text-section {
  position: relative;
  width: 100%;
}

.image-wrapper {
  position: relative;
  width: 100%;
}

.image-wrapper img {
  width: 100%;
  height: auto;
  display: block;
}

.desktop-only {
  display: block;
  position: relative;
}

.mobile-only {
  display: none;
  position: relative;
}

.desktop-text {
  position: absolute;
  left: 15%;
  top: 50%;
  transform: translateY(-50%);
  max-width: 40%;
}

.mobile-text {
  position: static;
  text-align: center;
  padding: 20px;
  max-width: 100%;
}

@media screen and (max-width: 749px) {
  .desktop-only {
    display: none;
  }
  
  .mobile-only {
    display: block;
  }
}
</style>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Headphones"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Experience immersive sound with soundcore headphones!</p>"
    },
    {
      "type": "color",
      "id": "desktop_heading_color",
      "label": "Desktop Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "desktop_text_color",
      "label": "Desktop Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}