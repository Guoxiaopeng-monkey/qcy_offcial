{% style %}
    .two-layout-section .two-layout-container .row{
        --bs-gutter-y:2rem;
    }
    .two-layout-section .two-layout-item{
        background: #F8F8F8;
        border-radius:6px;
        overflow:hidden;
        height:100%;
    }
    .two-layout-section .two-layout-item .image-container{
        height:360px;
        width:100%;
    }
    .two-layout-section .two-layout-item .image-container img{
        width:100%;
        height:100%;
        object-fit:cover;
    }
    .two-layout-section .two-layout-item .two-layout-content{
        padding:50px;
    }

    /* MOBILES ----------------------------------------------------------------------------------- */

    @media only screen and (min-width: 0px) {
      .two-layout-section .two-layout-item .image-container{
          height:220px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:20px;
      }
    }
    @media only screen and (min-width: 375px) {
      .two-layout-section .two-layout-item .image-container{
          height:220px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:20px;
      }
    }
    @media only screen and (min-width: 390px) {
      .two-layout-section .two-layout-item .image-container{
          height:220px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:20px;
      }
    }
    @media only screen and (min-width: 414px) {
      .two-layout-section .two-layout-item .image-container{
          height:220px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:20px;
      }
    }
    @media only screen and (min-width: 428px) {
      .two-layout-section .two-layout-item .image-container{
          height:220px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:20px;
      }
    }
    @media only screen and (min-width: 480px) {
      .two-layout-section .two-layout-item .image-container{
          height:220px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:20px;
      }
    }
    
    /* TABLETS ----------------------------------------------------------------------------------- */
    
    @media only screen and (min-width: 768px) {
      .two-layout-section .two-layout-item .image-container{
          height:300px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:30px;
      }
    }
    
    
    /* LAPTOPS --------------------------------------------------------------------------------- */
    
    @media only screen and (min-width: 1280px) {
      .two-layout-section .two-layout-item .image-container{
          height:330px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:30px;
      }
    }
    @media only screen and (min-width: 1366px) {
      .two-layout-section .two-layout-item .image-container{
          height:330px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:35px;
      }
    }
    @media only screen and (min-width: 1440px) {
      .two-layout-section .two-layout-item .image-container{
          height:330px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:35px;
      }
    }
    @media only screen and (min-width: 1536px) {
      .two-layout-section .two-layout-item .image-container{
          height:330px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:40px;
      }
    }
    @media only screen and (min-width: 1600px) {
      .two-layout-section .two-layout-item .image-container{
          height:350px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:45px;
      }
    }
    
    /* COMPUTERS --------------------------------------------------------------------------------- */
    @media only screen and (min-width: 1920px) {
      .two-layout-section .two-layout-item .image-container{
          height:360px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:50px;
      }
    }
    @media only screen and (min-width: 2560px) {
      .two-layout-section .two-layout-item .image-container{
          height:360px;
      }
      .two-layout-section .two-layout-item .two-layout-content{
          padding:50px;
      }
    }

{% endstyle %}
<div class="page-width section-content">
    <h2 class="f-f-bold text-md black-f my-3 text-center pb-lg-5 pb-md-4 pb-sm-4">
        {{ section.settings.section_heading }}
    </h2>
    <div class="two-layout-container">
        <div class="row">
          
            <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="two-layout-item">
                    <div class="image-container">
                        <img src="{{ section.settings.Image | img_url: 'master' }}" width="100%" height="100%">
                    </div>
                    <div class="two-layout-content">
                        <h3 class="f-f-bold black-f my-3">
                            {{ section.settings.heading }}
                        </h3>
                        <p class="f-f-regular black-f my-0">
                            {{ section.settings.description }}
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="two-layout-item">
                    <div class="image-container">
                        <img src="{{ section.settings.Image_2 | img_url: 'master' }}" width="100%" height="100%">
                    </div>
                    <div class="two-layout-content">
                        <h3 class="f-f-bold black-f my-3">
                            {{ section.settings.heading_2 }}
                        </h3>
                        <p class="f-f-regular black-f my-0">
                            {{ section.settings.description_2 }}
                        </p>
                    </div>
                </div>
            </div>
          
        </div>
    </div>
</div>
{% schema %}
    {
        "class": "two-layout-section",
        "name": "Two Layout",
        "settings": [
            {
                "type": "text",
                "id": "section_heading",
                "label": "Section Heading",
                "default": "Omnidirectional Noise Cancellation, Deep Immersion"
            },
            {
                "type": "header",
                "content": "First Column"
            },
            {
                "type": "image_picker",
                "id": "Image",
                "label": "Image"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Traditional Products："
            },
            {
                "type": "textarea",
                "id": "description",
                "label": "Description",
                "default": "Conventional active noise-cancelling earbuds typically only target noise from specific directions or frequencies, resulting in limited effectiveness. They perform poorly in complex environments and fail to provide an omnidirectional quiet experience."
            },
            {
                "type": "header",
                "content": "Second Column"
            },
            {
                "type": "image_picker",
                "id": "Image_2",
                "label": "Image"
            },
            {
                "type": "text",
                "id": "heading_2",
                "label": "Heading",
                "default": "Traditional Products："
            },
            {
                "type": "textarea",
                "id": "description_2",
                "label": "Description",
                "default": "Conventional active noise-cancelling earbuds typically only target noise from specific directions or frequencies, resulting in limited effectiveness. They perform poorly in complex environments and fail to provide an omnidirectional quiet experience."
            }
        ],
        "presets" :[{
            "name" : "Two Layout"
        }]
    }
{% endschema %} 