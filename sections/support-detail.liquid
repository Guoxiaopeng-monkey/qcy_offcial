{% assign support_items = shop.metaobjects['product_support'].values %}
{% assign seen_categories = '' %}
{% assign categories_array = '' %}

{% for item in support_items %}
  {% assign category_value = item.product_category.value | strip %}
  {% assign category_key = category_value | downcase %}

  {% unless seen_categories contains category_key %}
    {% capture seen_categories %}{{ seen_categories }},{{ category_key }}{% endcapture %}
    {% capture categories_array %}{{ categories_array }},{{ category_value }}{% endcapture %}
  {% endunless %}
{% endfor %}

{% assign unique_categories = categories_array | remove_first: ',' | split: ',' | sort %}

<section class="support-detail">
    <div class="page-width section-content">
        <div class="row details-row">
            <div class="col-12">
                <div class="breadcrumbs">
                    <a href="{{ pages['support-center'].url }}">
                        Support Center
                    </a>
                    >
                </div>
            </div>
            <div class="col-lg-2 col-md-12 col-sm-12">
                <div class="sidebar">
                    <div class="sideline">
                        {% for category in unique_categories %}
                          {% assign category_slug = category | strip | downcase | replace: ' ', '-' %}
                            <div class="line"></div>
                        {% endfor %}
                    </div>
                    <div class="accordion" id="accordion-product">
                        {% for category in unique_categories %}
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="{{ category }}-{{ forloop.index }}">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ category }}-{{ forloop.index }}" aria-expanded="false" aria-controls="collapse-{{ category }}-{{ forloop.index }}">
                                        {{ category }}
                                    </button>
                                </h2>
                                <div id="collapse-{{ category }}-{{ forloop.index }}" class="accordion-collapse collapse" aria-labelledby="{{ category }}-{{ forloop.index }}" data-bs-parent="#accordion-product">
                                    <div class="accordion-body">
                                        <div class="items">
                          
                                            {% for item in support_items %}
                                              {% if item.product_category.value == category %}
                                                    <a class="selected" href="{{ item.support_link_.value.url }}" data-image="{{ item.image | img_url: 'master' }}">{{ item.product_name }}</a>
                                              {% endif %}
                                            {% endfor %}
                          
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                        
                        {% comment %}
                        {% if earbuds.size > 0 %}
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingOne">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                        Earbuds
                                    </button>
                                </h2>
                                <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordion-product">
                                    <div class="accordion-body">
                                        <div class="items">
                                            {% if shop.metaobjects['product_support'].values_count > 0 %}
                                                {% paginate shop.metaobjects['product_support'].values by 999 %}
                                                    {% assign _data_1 = shop.metaobjects['product_support'].values | where: 'product_category', earbuds_key | sort: 'product_category' %}
                
                                                    {% if _data_1.size > 0 %}
                                                        {% for item in _data_1 %}
                                                            <a class="selected" href="{{ item.support_link_.value.url }}" data-image="{{ item.image | img_url: 'master' }}">{{ item.product_name }}</a>
                                                        {% endfor %}
                                                    {% endif %}
            
                                                {% endpaginate %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if headphones.size > 0 %}
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingTwo">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                        Headphones
                                    </button>
                                </h2>
                                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordion-product">
                                    <div class="accordion-body">
                                        <div class="items">
                                            {% if shop.metaobjects['product_support'].values_count > 0 %}
                                                {% paginate shop.metaobjects['product_support'].values by 999 %}
                                                    {% assign _data_1 = shop.metaobjects['product_support'].values | where: 'product_category', headphones_key | sort: 'product_category' %}
                
                                                    {% if _data_1.size > 0 %}
                                                        {% for item in _data_1 %}
                                                            <a class="selected" href="{{ item.support_link_.value.url }}" data-image="{{ item.image | img_url: 'master' }}">{{ item.product_name }}</a>
                                                        {% endfor %}
                                                    {% endif %}
            
                                                {% endpaginate %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if smartwatches.size > 0 %}
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingThree">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                        Smart Watches
                                    </button>
                                </h2>
                                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordion-product">
                                    <div class="accordion-body">
                                        <div class="items">
                                            {% if shop.metaobjects['product_support'].values_count > 0 %}
                                                {% paginate shop.metaobjects['product_support'].values by 999 %}
                                                    {% assign _data_1 = shop.metaobjects['product_support'].values | where: 'product_category', smartwatches_key | sort: 'product_category' %}
                
                                                    {% if _data_1.size > 0 %}
                                                        {% for item in _data_1 %}
                                                            <a class="selected" href="{{ item.support_link_.value.url }}" data-image="{{ item.image | img_url: 'master' }}">{{ item.product_name }}</a>
                                                        {% endfor %}
                                                    {% endif %}
            
                                                {% endpaginate %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if speakers.size > 0 %}
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingFour">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                                        Speakers
                                    </button>
                                </h2>
                                <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#accordion-product">
                                    <div class="accordion-body">
                                        <div class="items">
                                            {% if shop.metaobjects['product_support'].values_count > 0 %}
                                                {% paginate shop.metaobjects['product_support'].values by 999 %}
                                                    {% assign _data_1 = shop.metaobjects['product_support'].values | where: 'product_category', speakers_key | sort: 'product_category' %}
                
                                                    {% if _data_1.size > 0 %}
                                                        {% for item in _data_1 %}
                                                            <a class="selected" href="{{ item.support_link_.value.url }}" data-image="{{ item.image | img_url: 'master' }}">{{ item.product_name }}</a>
                                                        {% endfor %}
                                                    {% endif %}
            
                                                {% endpaginate %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% endcomment %}
                        
                    </div>
                </div>
            </div>
            <div class="col-lg-10 col-md-12 col-sm-12">
                <h5 class="product-title">
                    Product Title
                </h5>
                <div class="product-image">
                    <img loading="lazy" src="">
                </div>
                <div class="toggles anchor d-lg-flex d-md-flex d-sm-none">
                    <span class="active" data-anchor="support-video">
                        Support Video
                    </span>
                    <span data-anchor="faq">
                        FAQ
                    </span>
                    <span data-anchor="manuals">
                        Documents & Drivers
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="toggles anchor d-lg-none d-md-none d-sm-flex">
        <span class="active" data-anchor="support-video">
            Support Video
        </span>
        <span data-anchor="faq">
            FAQ
        </span>
        <span data-anchor="manuals">
            Documents & Drivers
        </span>
    </div>
</section>

{% schema %}
{
    "name": "Support Detail"
}
{% endschema %}