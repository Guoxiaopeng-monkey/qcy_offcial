{% style %}
    .audio-app-download-section .inner-section{
        background: {{ section.settings.bg_color }};
        border-radius: 24px 24px 24px 24px;
        overflow:hidden;
    }
    .audio-app-download-section .link-container{
        background: #000000;
        border-radius: 8px 8px 8px 8px;
        padding:1rem 2rem;
        display:flex;
        align-items: center;
        gap:1rem;
    }
    .audio-app-download-section .link-container span{
        font-size:10px;
        line-height:normal;
    }
    .audio-app-download-section .link-container img{
        width:40px;
        height:40px;
        object-fit:contain;
    }
    .audio-app-download-section .featured-image{
        mix-blend-mode: multiply;
        width:100%;
        height:100%;
        object-fit:contain;
        object-position: bottom;
    }

  
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .audio-app-download-section .link-container img{
            width:30px;
            height:30px;
        }
        .audio-app-download-section .link-container{
            padding:1rem;
            width:50%;
        }
        .audio-app-download-section .link-container span{
            font-size:7px;
        }
        .audio-app-download-section .link-container h3{
            font-size:14px;
        }
        .inner-container{
            padding:50px 20px 30px;
        }
    }
    
    /* ipad Air */
    @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
        .audio-app-download-section .link-container img{
            width:30px;
            height:30px;
        }
    }

{% endstyle %}
<div class="page-width section-content">
    <div class="inner-section">
        <div class="row h-100 align-items-center">
            <div class="col-lg-6 col-md-6 col-sm-12 h-100">
                <div class="inner-container d-flex flex-column h-100 justify-content-center align-items-center">
                    <div class="d-flex flex-column gap-4 h-100 justify-content-center col-lg-10 col-md-10 col-sm-12">
                        <h2 class="f-f-extra-bold text-lg my-0">{{ section.settings.heading }}</h2>
                        <p class="f-f-regular h5 my-0">{{ section.settings.description }}</p>
                        <div class="col-lg-10 col-md-10 col-sm-12 d-flex gap-4 mt-4">
                            <a href="{{ section.settings.google_link }}" class="link-container">
                              <img src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/45053_2x_1.png?v=1752801918" width="100%" height="100%">
                              <div class="d-flex flex-column">
                                  <span class="f-f-regular white-f">GET IT ON</span>
                                  <h3 class="f-f-bold white-f l-h-normal my-0">Google Play</h3>
                              </div>
                            </a>
                            <a href="{{ section.settings.google_link }}" class="link-container">
                              <img src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/69579_2x_1.png?v=1752801918" width="100%" height="100%">
                              <div class="d-flex flex-column">
                                  <span class="f-f-regular white-f">Downlaod on the</span>
                                  <h3 class="f-f-bold white-f l-h-normal my-0">App Store</h3>
                              </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12 h-100">
                  <img src="{{ section.settings.bg_image | img_url: 'master' }}" width="100%" height="100%" class="featured-image">
            </div>
        </div>
    </div>
</div>
{% schema %}
    {
        "class": "audio-app-download-section",
        "name": "Audio App Download",
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "QcY HearxTM"
            },
            {
                "type": "textarea",
                "id": "description",
                "label": "Description",
                "default": "Expand the functionality of all your soundcore devices by downloading the free app from the Play Store or App Store."
            },
            {
                "type": "color",
                "id": "bg_color",
                "label": "Background Color",
                "default": "#F8F8F8"
            },
            {
                "type": "image_picker",
                "id": "bg_image",
                "label": "Background Image"
            },
            {
                "type": "url",
                "id": "google_link",
                "label": "Google Link"
            },
            {
                "type": "url",
                "id": "appstore_linl",
                "label": "Appstore Link"
            }
        ],
        "templates": ["page"],
    }
{% endschema %} 