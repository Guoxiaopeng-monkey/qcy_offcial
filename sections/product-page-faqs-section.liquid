{% stylesheet %}
    .faqs-section{
        padding:50px 0px;
        margin:50px 0px 80px;
        background-color:#F9F9F9;
    }
    .faqs-section .faqs-list-container{
        padding-top:50px;
    }
    .faqs-section .faqs-list-container .faqs-heading{
        padding:1.7rem 0px;
        border-top: 1px solid #DBDBDB;
        cursor:pointer;    
        position:relative;
        padding-right:30px;
    }
    .faqs-section .faqs-list-container .ui-accordion-content {
        padding-bottom:30px;
    }
    .faqs-section .faqs-list-container .faqs-heading .ui-accordion-header-icon{
        background-image: url(/cdn/shop/files/keyboard_arrow_down--1.svg?v=1728224007);
        background-size: contain;
        display: block;
        width: 25px;
        height: 25px;
        filter: invert(1);
        position: absolute;
        right: 5px;
    }
    .faqs-section .faqs-list-container .faqs-heading.ui-accordion-header-active .ui-accordion-header-icon{
        background-image: url(/cdn/shop/files/keyboard_arrow_up--1.svg?v=1728224060);
    }
    .faqs-section .faqs-list-container{
        border-bottom: 1px solid #DBDBDB;
    }
    .load-more-btn{
        cursor:pointer;
    }

    .faq-item {
        display: none;
    }
    .faq-item.visible {
        display: block;
    }

{% endstylesheet %}
<div class="page-width">
    <h2 class="heading text-md f-f-bold mx-0">{{ section.settings.heading }}</h2>
    <div class="faqs-list-container">
        {% for block in section.blocks %}
            <h4 class="faqs-heading f-f-bold mx-0">{{ block.settings.heading | replace: '<p>', '' | replace: '</p>', '' }}</h4>
            <div>
                <h4 class="mx-0 gray-f">
                    {{ block.settings.description | replace: '<p>', '' | replace: '</p>', '' }}
                </h4>
            </div>
        {% endfor %}
    </div>
    <div class="load-more-btn">
        <h4 class="btn-load-more f-f-bold">
            load more
            <span class="h5">
                <i class="fa-solid fa-angles-down"></i>
            </span>
        </h4>
    </div>
</div>
{% javascript %}
    $('.faqs-list-container').accordion({
        heightStyle: "content",
        active: false,
        collapsible: true
    });
    $('.faqs-list-container').accordion('option', 'active', 0);


    // Initially hide all FAQ items
    $('.faqs-heading').hide();
    
    // Show only the first 4 FAQ items
    $('.faqs-heading').slice(0, 4).show();

    // Click event for the 'Load More' button
    $('.load-more-btn').on('click', function() {
        // Find hidden items and show the next 4
        var hiddenItems = $('.faqs-heading:hidden');
        hiddenItems.slice(0, 4).slideDown();
        
        // If no more items are hidden, hide the 'Load More' button
        if (hiddenItems.length <= 4) {
            $(this).hide();
        }
    });
{% endjavascript %}
{% schema %}
    {
      
        "class": "faq-scroll-section faqs-section section-scroll",
        "name": "FAQs",
        "limit": 1, 
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Frequently asked questions."
            }
        ],
        "blocks": [
            {
                "type": "faqs",
                "name": "FAQs",
                "settings": [
                    {
                        "type": "text",
                        "id": "heading",
                        "label": "Heading"
                    },
                    {
                        "type": "richtext",
                        "id": "description",
                        "label": "Description"
                    }
                ]
            }
        ],
        "presets" :[{
            "name" : "FAQs"
        }]
    }
  {% endschema %} 