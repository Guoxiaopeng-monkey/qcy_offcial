{% schema %}
    {
      
        "class": "user-stories-section",
        "name": "User Stories Section",
        "templates": ["index"],
        "limit": 1,
        "max_blocks": 3,
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "User Stories"
            },
            {
                "type": "richtext",
                "id": "description",
                "label": "Description",
                "default": "<p>Listening is believing. Watch people use QCY products and check out their comments.</p>"
            }
        ],
        "blocks": [
          {
              "type": "video",
              "name": "Video",
              "settings": [
                  {
                      "type": "video",
                      "id": "bg_video",
                      "label": "Background Video"
                  },
                  {
                      "type": "text",
                      "id": "heading",
                      "label": "Heading"
                  },
                  {
                      "type": "url",
                      "id": "link",
                      "label": "Link"
                  }
              ]
          },
          {
              "type": "youtube",
              "name": "Youtube",
              "settings": [
                  {
                      "type": "image_picker",
                      "id": "custom_image",
                      "label": "Custom Image"
                  },
                  {
                      "type": "url",
                      "id": "youtube_link",
                      "label": "Youtube Link"
                  },
                  {
                      "type": "text",
                      "id": "heading",
                      "label": "Heading"
                  },
                  {
                      "type": "url",
                      "id": "link",
                      "label": "Link"
                  }
              ]
          }
        ],
        "presets" :[{
            "name" : "User Stories Section"
        }]
    }
  {% endschema %} 