<div class="page-width section-content">
    <div class="row align-items-center
      {% if section.settings.content_position == 'left' %}
        flex-lg-row-reverse flex-md-row-reverse flex-sm-row
      {% endif %}
      ">
      
        <div class="col-lg-6 col-md-6 col-sm-12" 
          {% if section.settings.animation %}
              {% if section.settings.content_position == 'left' %}
                  data-aos="fade-up-right" 
              {% else %}
                  data-aos="fade-up-left" 
              {% endif %}
          {% endif %}
          
          data-aos-easing="ease" data-aos-duration="400" data-aos-once="true" data-aos-delay="300">
              <img src="{{ section.settings.Image | img_url: 'master' }}" width="100%" height="100%">
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 d-flex justify-content-center"
          {% if section.settings.animation %}
              {% if section.settings.content_position == 'left' %}
                  data-aos="fade-up-left" 
              {% else %}
                  data-aos="fade-up-right" 
              {% endif %}
          {% endif %}
          
          
          data-aos-easing="ease" data-aos-duration="400" data-aos-once="true" data-aos-delay="300">
            <div class="col-lg-9 col-md-9 col-sm-12">
                <h2 class="f-f-bold text-md black-f my-3">
                    {{ section.settings.heading }}
                </h2>
                <div class="f-f-regular h5 black-f">
                    {{ section.settings.description }}
                </div>
                <h2 class="f-f-bold text-md black-f my-3">
                    {{ section.settings.heading_2 }}
                </h2>
                <div class="f-f-regular h5 black-f">
                    {{ section.settings.description_2 }}
                </div>
            </div>
        </div>
      
    </div>
</div>
{% schema %}
    {
        "class": "custom-layout-section",
        "name": "Custom Layout Section",
        "settings": [
            {
                "type": "image_picker",
                "id": "Image",
                "label": "Image"
            },
            {
                "type": "select",
                "id": "content_position",
                "label": "Content Position",
                "options": [
                   {
                       "label": "Right",
                       "value": "right"
                   },
                   {
                       "label": "Left",
                       "value": "left"
                   }
                ]
            },
            {
                "type": "header",
                "content": "First Content"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "CoaxialBeat™ Technology?"
            },
            {
                "type": "textarea",
                "id": "description",
                "label": "Description",
                "default": "CoaxialBeat™ Technology integrates a dynamic driver and a balanced armature driver in a coaxial alignment. This design lets each driver play to its strength—dynamic drivers deliver powerful mid-to-low frequencies (rich bass and clear vocals), and balanced armature drivers capture crisp, detailed highs."
            },
            {
                "type": "header",
                "content": "Second Content"
            },
            {
                "type": "text",
                "id": "heading_2",
                "label": "Heading"
            },
            {
                "type": "textarea",
                "id": "description_2",
                "label": "Description"
            },
            {
                "type": "checkbox",
                "id": "animation",
                "label": "Animation",
                "default": false
            }
        ],
        "templates": ["page"],
        "presets": [
          {
            "name": "Custom Layout Section",
          }
        ]
    }
{% endschema %} 