<script>
  $(".header__inline-menu .mega-menu").each(function() {
      let timeoutId;

      $(this).on("mouseover", function() {
          clearTimeout(timeoutId);
          $(this).attr("open", true);
      });

      $(this).on("mouseleave", function() {
          const detailsElement = $(this);
          timeoutId = setTimeout(function() {
              detailsElement.removeAttr("open");
          }, 100); // 100 milliseconds delay
      });
  });

  if ($('.announcement-bar').length) {
      $('.header.page-width.site-header-transparent').addClass('transparent-padding');
  }

  var minWidth = 1024; // Adjust this value as needed

    $("header.header .header__inline-menu details .header__menu-item").hover(
        function() {
            $('header.header').addClass("hover-header-menu");
            $('.announcement-bar-section').addClass("hover-header-menu");
        },
        function() {
            $('header.header').removeClass("hover-header-menu");
            $('.announcement-bar-section').removeClass("hover-header-menu");
        }
    );

  
    $(".mega-menu__content").hover(
        function() {
            $('header.header').addClass("hover-header-menu");
            $('.announcement-bar-section').addClass("hover-header-menu");
        },
        function() {
            $('header.header').removeClass("hover-header-menu");
            $('.announcement-bar-section').removeClass("hover-header-menu");
        }
    );

  $('.header__icon--menu').on('click', function() {
      $('header.header').toggleClass("hover-header-menu");
      $('.announcement-bar-section').toggleClass("hover-header-menu");
  });

  var iso_code = 'en';
  {% if localization.language.iso_code == 'es' %}
      iso_code = 'es'
  {% endif %}

  $('.mega_menu_display').each(function() {
      var $container = $(this);
      var $containerList = $container.find('.container-list');
      
      // Get the original height of the first .container-list
      var originalHeight = $containerList.first().height() + 'px';
  
      $container.find('.selector-more').click(function() {

          var $selectorMore = $(this);

          if (iso_code == 'en') {
              if ($selectorMore.find('span').text() == 'More') {
                  $selectorMore.find('span').text('Fold');
                  $selectorMore.addClass('active');
                  $containerList.addClass('active');
      
                  // Calculate the target height and animate
                  var targetHeight = $containerList.get(0).scrollHeight;
                  $containerList.css({
                      height: $containerList.height(), // Set current height first
                      transition: 'height 0.5s ease' // Add transition
                  });
      
                  // Apply the new height
                  setTimeout(function() {
                      $containerList.css('height', targetHeight + 'px');
                  }, 10);
      
              } else {
                  $selectorMore.find('span').text('More');
                  $selectorMore.removeClass('active');
                  $containerList.removeClass('active');
      
                  // Animate back to the original height
                  $containerList.css('height', originalHeight);
              }
          }
          else {
              if ($selectorMore.find('span').text() == 'Más') {
                  $selectorMore.find('span').text('Doblar');
                  $selectorMore.addClass('active');
                  $containerList.addClass('active');
      
                  // Calculate the target height and animate
                  var targetHeight = $containerList.get(0).scrollHeight;
                  $containerList.css({
                      height: $containerList.height(), // Set current height first
                      transition: 'height 0.5s ease' // Add transition
                  });
      
                  // Apply the new height
                  setTimeout(function() {
                      $containerList.css('height', targetHeight + 'px');
                  }, 10);
      
              } else {
                  $selectorMore.find('span').text('Más');
                  $selectorMore.removeClass('active');
                  $containerList.removeClass('active');
      
                  // Animate back to the original height
                  $containerList.css('height', originalHeight);
              }
          }
  
      });
  });

  let drawer = document.querySelector('#menu-drawer');
  
  function getHeaderHeight() {
    return document.querySelector('#site-header').offsetHeight;
  }
  
  function adjustDrawerHeightWithAnnouncement() {
    let currentHeight = window.innerHeight;
    let headerHeight = getHeaderHeight();
    drawer.style.height = `calc(${currentHeight}px - ${headerHeight + 40}px)`;
  }
  
  function adjustDrawerHeight() {
    let currentHeight = window.innerHeight;
    let headerHeight = getHeaderHeight();
    drawer.style.height = `calc(${currentHeight}px - ${headerHeight}px)`;
  }
  
  // On load
  adjustDrawerHeightWithAnnouncement();
  
  // On scroll
  $(window).on('scroll', function () {
    var scrollPosition = $(this).scrollTop();
    if (scrollPosition > 50) {
      adjustDrawerHeight();
    } else {
      adjustDrawerHeightWithAnnouncement();
    }
  });
  
  // Also listen to resize — helpful for orientation change or URL bar collapse/expand
  window.addEventListener('resize', () => {
    let scrollPosition = window.scrollY;
    if (scrollPosition > 50) {
      adjustDrawerHeight();
    } else {
      adjustDrawerHeightWithAnnouncement();
    }
  });
  
</script>

