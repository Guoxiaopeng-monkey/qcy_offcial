<div class="{{ section.settings.section_link }} about-us-timeline-section section-scroll">
  <div class="page-width">
    <h2 class="mx-0 f-f-bold section-heading text-cap center">{{ section.settings.title }}</h2>
    <div class="timeline-section-container">
        <div class="timeline-image-slider col_50">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="timeline-image-item swiper-slide">
                  <img loading="lazy" src="{{ block.settings.image | img_url: 'master' }}">
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="timeline-content-slider-container col_50">
          <div class="timeline-content-slider">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                <div class="timeline-content-item swiper-slide">
                  <h4 class="year-text text-sm mx-0 f-f-semi-bold h-mobile">{{ block.settings.year }}</h4>
                  <h3 class="mx-0 f-f-medium">{{ block.settings.description | replace: '<p>', '' | replace: '</p>','' }}</h3>
                </div>
              {% endfor %}
            </div>
          </div>
          
          <div class="timeline-year-slider">
            <div class="swiper-wrapper">
                {% for block in section.blocks %}
                  <div class="timeline-year-item swiper-slide">
                    <h2 class="year-text mx-0 f-f-extra-bold">{{ block.settings.year }}</h2>
                  </div>
                {% endfor %}
            </div>
          </div>
        </div>
    </div>
    <div class="year-pagination-slider-container"> 
      <div class="year-pagination-slider"> </div>
    </div>
  </div>
</div>
<script>
    var slideTitles = [
        {% for block in section.blocks %}
            "{{ block.settings.year }}"{% if forloop.last == false %},{% endif %}
        {% endfor %}
    ];

  var about_timeline_image_slider = new Swiper('.timeline-image-slider', {
      slidesPerView: 1,
      loop: false,
      speed: 800,
      allowTouchMove: true,
      effect: 'creative', // Use the creative effect
      creativeEffect: {
          prev: {
              // Previous slide fades out
              opacity: 0.8,
          },
          next: {
              // Next slide slides in from the right
              translate: ['100%', 0, 0], // Simple slide-in effect
          },
      },
      pagination: {
          el: '.year-pagination-slider',
          clickable: true,
          renderBullet: function (index, className) {
              return `<span class="tab-pagination t-cap ${className}" data-index="${index}" title="${slideTitles[index]}">${slideTitles[index]}</span>`;
          },
      },
  });

  var about_timeline_content_slider = new Swiper('.timeline-content-slider', {
      direction: "vertical",
      slidesPerView: 1,
      loop: false,
      allowTouchMove: false,
      speed: 800,
  });
  
  var about_timeline_year_slider = new Swiper('.timeline-year-slider', {
      direction: "vertical",
      slidesPerView: 1,
      spaceBetween: 20,
      allowTouchMove: false,
      loop: false,
      speed: 800,
  });
  
  about_timeline_image_slider.controller.control = about_timeline_content_slider;
  about_timeline_content_slider.controller.control = about_timeline_year_slider;

</script>
{% schema %}
    {
        "name": "About Us Timeline",
        "templates": ["page"],
        "limit": 1, 
        "settings": [
            {
                "type": "text",
                "id": "section_link",
                "label": "Section Link",
                "default":"milestone-scroll-section"
            },
            {
                "type": "text",
                "id": "title",
                "label": "How we got here"
            }
        ],
        "blocks": [
          {
              "type": "timeline",
              "name": "Timeline",
              "settings": [
                  {
                      "type": "text",
                      "id": "year",
                      "label": "Year"
                  },
                  {
                      "type": "image_picker",
                      "id": "image",
                      "label": "Image"
                  },
                  {
                      "type": "richtext",
                      "id": "description",
                      "label": "Description"
                  }
              ]
          }
        ],
        "presets" :[{
            "name" : "About Us Timeline"
        }]
    }
{% endschema %} 