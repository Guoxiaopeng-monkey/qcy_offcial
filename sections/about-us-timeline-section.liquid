<style>
  .about-us-timeline-section{
    padding:100px 70px;
  }
  .about-us-timeline-section .timeline-section-container{
    margin-top:50px;
    display:flex;
    background-color:#f9f9f9;
    border-radius:20px;
  }
  .about-us-timeline-section .timeline-content-slider-container{
    display: flex;
    align-items: center;
    position:relative;
    -webkit-user-select: none; /* Safari */
    -ms-user-select: none; /* IE 10 and IE 11 */
    user-select: none; /* Standard syntax */
  }
  .about-us-timeline-section .timeline-content-slider-container .timeline-content-slider{
    overflow:hidden;
    height:400px;
    position:relative;
    z-index:1;
  }
  .about-us-timeline-section .timeline-year-slider{
    overflow: hidden;
    position: absolute;
    bottom: 0;
    left: 0;
    width:100%;
    z-index:0;
  }
  .about-us-timeline-section .timeline-year-slider .year-text{
    text-align: center;
    color:#f3f3f3;
  }
  .about-us-timeline-section .timeline-content-item{
     display: flex;
    flex-direction: column;
    justify-content: center
  }
  .about-us-timeline-section .timeline-content-item .year-text{
    padding-bottom:10px;
  }
  .about-us-timeline-section .timeline-content-item h3{
    line-height: inherit;
  }
  .about-us-timeline-section .timeline-image-item{
    display:flex;
    visibility:hidden;
  }
  .about-us-timeline-section .timeline-image-item.swiper-slide-active{
    visibility:visible;
  }
  .about-us-timeline-section .timeline-image-item img{
    width:100%;
    object-fit:cover;
  }
  .about-us-timeline-section .timeline-image-slider{
    overflow:hidden;
    border-radius:20px;
  }
  .about-us-timeline-section .year-pagination-slider-container .year-pagination-slider{
    padding:0px;
     display: grid;
    justify-content: space-between;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    margin-top:50px;
  }
  .about-us-timeline-section .year-pagination-slider-container .year-pagination-slider span{
    font-family: 'Mulish-Bold';
    font-size:26px;
    width: 100%;
    height: fit-content;
    background: transparent;
    text-align:center;
    border-radius: 0px;
    position:relative;
    padding-top:1rem;
    transition: all 0.3s ease;
  }
  .about-us-timeline-section .year-pagination-slider-container .year-pagination-slider span.swiper-pagination-bullet-active{
    padding-top:0px;
  }
  .about-us-timeline-section .year-pagination-slider-container .year-pagination-slider span:before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    height:4px;
    width:100%;
    background-color:#DFDFDF;
  }
  .about-us-timeline-section .year-pagination-slider-container .year-pagination-slider span:first-child:before{
    border-top-left-radius:50px;
    border-bottom-left-radius:50px;
  }
  .about-us-timeline-section .year-pagination-slider-container .year-pagination-slider span:last-child:before{
    border-top-right-radius:50px;
    border-bottom-right-radius:50px;
  }
  .about-us-timeline-section .year-pagination-slider-container .year-pagination-slider span.swiper-pagination-bullet-active:before{
    background-color:#FF8832;
  }
  .about-us-timeline-section .year-pagination-slider-container .year-pagination-slider span.swiper-pagination-bullet-active:before{
    border-radius:50px;
  }

  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
      .about-us-timeline-section{
        padding:20px 0px 50px;
      }
      .about-us-timeline-section .timeline-year-slider{
        display:none;
      }
      .about-us-timeline-section .section-heading{
        text-align:left;
      }
      .about-us-timeline-section .timeline-section-container{
        flex-direction:column;
      }
      .about-us-timeline-section .timeline-content-slider-container .timeline-content-slider{
        height:330px;
      }
      .about-us-timeline-section .timeline-section-container{
        background-color:#fff;
      }
      .year-pagination-slider-container{
        overflow-x:scroll;
      }
