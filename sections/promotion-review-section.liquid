<style>
  .promotion-review-section{
    position:relative;
    overflow:hidden;
    margin:80px 0px;
  }
  .promotion-review-section .review-slider-section{
    overflow:hidden;
  }
  #shopify-section-{{ section.id }}.promotion-review-section:before{
    content: "";
    display: block;
    background-color: {{ section.settings.background }};
    height: 95%;
    width: 100%;
    position: absolute;
    bottom: 0;
  }
  .promotion-review-section .review-slide-item{
    display:flex;
    gap:50px;
  }
  .promotion-review-section .featured-review-image{
    width:100%;
    height:100%;
  }
  .promotion-review-section .review-slide-details-content{
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 95%;
    position:relative;
  }
  .promotion-review-section .review-slide-item .quote-icon{
    width:75px;
    height:80px;
    object-fit:contain;
    position:absolute;
    top:10%;
  }
  .promotion-review-section .right-content-container{
      display:flex;
      align-items: flex-end;
  }
  .promotion-review-section .review-details-list{
      position:absolute;
      bottom:50px;
  }
  .review-section-slider-arrows{
      position:absolute;
      top:50%;
      left:0;
      right:0;
      margin:auto;
      width:100%;
      max-width:var(--page-width);
      padding:0px 20px;
      display:flex;
      flex-direction:row-reverse;
      justify-content: space-between;
  }
  .review-section-slider-arrows .review-section-button-prev, 
  .review-section-slider-arrows .review-section-button-next{
      background: #000;
      border-radius: 50px;
      display: flex;
      cursor: pointer;
      z-index: 2;
      width:fit-content;
      transition: all 0.3s ease;
  }
  .review-section-slider-arrows .review-section-button-prev:hover, 
  .review-section-slider-arrows .review-section-button-next:hover{
      background: #FF8832;
  }

  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
      .promotion-review-section .review-slide-item{
        flex-direction:column;
      }
      .promotion-review-section .review-slide-item .quote-icon{
        position: absolute;
        top: -15%;
        z-index: 0;
      }
      .promotion-review-section{
        padding-bottom:30px;
        margin:50px 0px;
      }
      .promotion-review-section .review-details-list{
        position:unset;
        padding-top:30px;
      }
      .promotion-review-section .review-slide-details-content h2{
        position:relative;
        z-index:1;
      }
      .review-section-slider-arrows{
        top:20%;
        padding:0px 5px;
      }
      .review-section-slider-arrows .review-section-button-prev svg, 
      .review-section-slider-arrows .review-section-button-next svg{
        width:40px;
        height:40px;
      }
  }
  
  /* ipad Air */
  @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
      .promotion-review-section .review-slide-item{
        flex-direction:column;
      }
      .promotion-review-section .review-slide-item .quote-icon{
        position: absolute;
        top: -15%;
        z-index: 0;
      }
      .promotion-review-section{
        padding-bottom:30px;
        margin:50px 0px;
      }
      .promotion-review-section .review-details-list{
        position:unset;
        padding-top:30px;
      }
      .promotion-review-section .review-slide-details-content h2{
        position:relative;
        z-index:1;
      }
  }

</style>
<div class="page-width">
  <div class="review-slider-section">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="review-slide-item swiper-slide">
            <div class="col_50">
              <img loading="lazy" src="{{ block.settings.featured_image | img_url: 'master' }}" class="featured-review-image">
            </div>
            <div class="col_50 right-content-container">
                <div class="review-slide-details-content col_90">
                  <img loading="lazy" src="https://cdn.shopify.com/s/files/1/0639/3492/2809/files/quote-review.png?v=1729009119" class="quote-icon">
                  <h2 class="f-f-bold mx-0" style="color:{{ section.settings.primary_color }};">{{ block.settings.review_comment | replace: '<p>','' | replace: '</p>','' }}</h2>
                  <div class="review-details-list">
                      <h3 class="mx-0 f-f-bold" style="color:{{ section.settings.primary_color }};">{{ block.settings.review_author }}</h3>
                      <h4 class="mx-0 f-f-medium" style="color:{{ section.settings.primary_color }};">{{ block.settings.reviewe_location }}</h4>
                  </div>
                </div>
            </div>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="review-section-slider-arrows "{% if section.blocks.size <= 1 %}style="display:none;"{% endif %}>
      <div class="review-section-button-prev">
          <svg xmlns="http://www.w3.org/2000/svg" width="53" height="52" viewBox="0 0 53 52">
             <g id="right_normal" transform="translate(-1835 -559)">
                 <rect id="矩形_5" data-name="矩形 5" width="53" height="52" rx="5" transform="translate(1835 559)" fill="transparent"></rect>
                 <path id="路径_4" data-name="路径 4" d="M253.944,103.831a.906.906,0,0,1-.7-.3.97.97,0,0,1,.1-1.4l6.385-5.786a.748.748,0,0,0,0-1.2l-6.485-5.487a.99.99,0,0,1,1.3-1.5l6.385,5.487a2.808,2.808,0,0,1,1,2.1,2.871,2.871,0,0,1-.9,2.1l-6.385,5.786a1.85,1.85,0,0,1-.7.2Z" transform="translate(1604.091 489.128)" fill="#fff"></path>
             </g>
         </svg>
      </div>
      <div class="review-section-button-next">
          <svg xmlns="http://www.w3.org/2000/svg" id="left_normal" width="53" height="52" viewBox="0 0 53 52">
              <rect id="矩形_5" data-name="矩形 5" width="53" height="52" rx="5" fill="transparent"></rect>
              <path id="路径_4" data-name="路径 4" d="M260.873,103.831a.906.906,0,0,0,.7-.3.97.97,0,0,0-.1-1.4l-6.385-5.786a.748.748,0,0,1,0-1.2l6.485-5.487a.99.99,0,0,0-1.3-1.5l-6.385,5.487a2.808,2.808,0,0,0-1,2.1,2.871,2.871,0,0,0,.9,2.1l6.385,5.786a1.85,1.85,0,0,0,.7.2Z" transform="translate(-230.909 -69.872)" fill="#fff"></path>
          </svg>
      </div>
  </div>
</div>
{% javascript %}
  var swiper = new Swiper('.review-slider-section', {
      grabCursor: true,
      speed: 600,
      navigation: {
          nextEl: '.review-section-button-prev',
          prevEl: '.review-section-button-next',
      },
  });  
{% endjavascript %}
{% schema %}
  {
    
      "class": "promotion-review-section",
      "name": "Promotion Review",
      "templates": ["page"],
      "settings": [
            {
                "type": "color",
                "id": "background",
                "label": "Background",
                "default":"#FFF0E4"
            },
            {
                "type": "color",
                "id": "primary_color",
                "label": "Primary Color",
                "default":"#1a1a1a"
            }
      ],
      "blocks": [
          {
              "type": "review",
              "name": "Review",
              "settings": [
                  {
                      "type": "image_picker",
                      "id": "featured_image",
                      "label": "Featured Image"
                  },
                  {
                      "type": "richtext",
                        "id": "review_comment",
                      "label": "Review Comment"
                  },
                  {
                      "type": "text",
                        "id": "review_author",
                      "label": "Review Author"
                  },
                  {
                      "type": "text",
                        "id": "reviewe_location",
                      "label": "Location"
                  }
              ]
          }
      ],
      "presets" :[{
          "name" : "Promotion Review"
      }]
  }
{% endschema %} 