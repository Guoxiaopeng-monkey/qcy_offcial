<style>
    .featured-video-section{
        height:300vh;
        background-color:#fff;
    }
    .featured-video video{
      width:100%;
      height:100%;
      object-fit: cover;
      position:absolute;
      top:0;
    }
    .featured-video span.bg_svg{
      position: absolute;
      top: 0;
      color: white;
      background-image: url(https://cdn.shopify.com/s/files/1/0639/3492/2809/files/1_2x_4143acb8-52fd-4cee-9676-919c95c9b494.png?v=1728356538);
      background-size: contain;
      background-position: center;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      transition: all 0.5s ease;
    }
    .content-container-video{
      position:sticky;
      top:0;
      height:100vh;
      overflow:hidden;
    }
    .featured-video-content .page-width{
      height: 100%;
      gap: 10%;
      align-items: center;
      transition: all 0.5s ease;
    }
    .featured-video-content .page-width p{
      padding-top: 3rem;
      border-top: 1px solid white;
    }
    .featured-video .heading{
      position:absolute;
      bottom:28vh;
      left:0;
      right:0;
      margin:auto;
      transition: all 0.3s ease;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
      .content-container-video{
        height:95vh;
        top:5vh;
      }
      .featured-video .heading{
        bottom:32vh;
      }
      .featured-video span.bg_svg{
          background-image: url(https://cdn.shopify.com/s/files/1/0639/3492/2809/files/qcy-2.png?v=1728675673);
      }
      .featured-video-content .page-width{
        flex-direction:column;
        gap:1rem;
        justify-content: center;
      }
      .featured-video span.bg_svg{
          background-repeat: no-repeat;
          background-size: cover;
          background-position: center;
      }
      .featured-video .heading{
        font-size:22px;
      }
    }
</style>
<section class="featured-video-section">
  <div class="content-container-video">
    <video class="video-tag
      {% if section.settings.video_mobile != blank %}
        h-desktop
      {% endif %}
      " poster="{{ section.settings.preview_image.src }}" autoplay muted loop playsinline>
        <source src="{{ section.settings.video.sources[1].url }}" type="video/mp4" alt="{{ section.settings.video.alt | escape }}">
        Your browser does not support the video tag.
    </video>
    {% if section.settings.video_mobile != blank %}
      <video class="video-tag h-mobile" poster="{{ section.settings.preview_image.src }}" autoplay muted loop playsinline alt="{{ section.settings.preview_image.alt | escape }}">
          <source src="{{ section.settings.video_mobile.sources[1].url }}" type="video/mp4">
          Your browser does not support the video tag.
      </video>
    {% endif %}
    <span class="bg_svg">
    </span>
    <h2 class="heading text-md f-f-bold center">{{ section.settings.heading }}</h2>
  </div>
</section>
{% schema %}
    {
      
        "class": "featured-video",
        "name": "Featured Video",
        "templates": ["index"],
        "limit": 1, 
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Go Creative And Go Beyond"
            },
            {
                "type": "video",
                "id": "video",
                "label": "Background Video"
            },
            {
                "type": "video",
                "id": "video_mobile",
                "label": "Background Video - Mobile"
            }
        ],
        "presets" :[{
            "name" : "Featured Video"
        }]
    }
  {% endschema %} 