<style>
    .product-compare-section{
        padding:50px 0px 100px;
    }
    .short-description-compare{
      width:300px;
    }
    .short-description-compare p{
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .compare-product-img{
        width:100%;
        height:300px;
        object-fit:contain;
        mix-blend-mode: multiply;
    }
    .compare-container .compare_li{
        display:flex;
        border-bottom: 2px solid #0000000f;
    }
    .compare-container{
        padding-top:50px;
    }
    .compare-container ul{
        padding-left:0px;
        margin:0px;
    }
    .details_{
        display:flex;
        border-bottom: 2px solid #0000000f;
    }
    .product-container-base{
        background-color:#fff;
        display:flex;
        flex-direction:column;
    }
    .s-main-box-black{
        border-radius:50px;
        padding-top: 1rem;
    }
    .lower-detail{
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem
    }
    .lower-detail a{
        margin-top:1rem;
    }
    .product-variant{
        padding-top:10px;
    }
    .product-variant ul{
        display:flex;
        gap:1rem;
    }
    .product-variant li.selected{
        border-color: #000;
    }
    .product-variant li{
        border-radius: 50px;
        padding: 2px;
        border: 1px solid transparent;
        cursor: pointer;
    }
    .product-detail-item .buy-now-btn{
        padding: 15px 35px;  
    }
    .mobile-d{
        display:none;
    }
    .compare-inner-container li div.product-detail-item:nth-child(even){
        background-color: #F9F9F9;
    }
    .compare-inner-container li .specs-det.label{
        padding:1.5rem 0px;
        padding-right:1rem;
        justify-content: flex-start;
    }
    .compare-inner-container li .specs-det{
        padding:1.5rem 0px;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .product-selected{
        margin: 2rem 1rem;
        background: #fff;
        padding: 0rem 1rem 2rem;
    }
    .product-compare-section .product-item{
      border-radius:0px;
      border:none;
    }
    .product-compare-section .product-item{
        box-shadow:unset !important;
    }
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 768px) {
        .product-selected{
          padding-bottom:1rem;
        }
        .compare-inner-container li .specs-det{
          padding: 2.5rem 10px;
        }
        .product-compare-section{
            padding:50px 0px;
        }
        .compare-inner-container .details_,
        .compare-inner-container .compare_li{
            display:grid;
            grid-template-columns: 25% 35% 35% 35% 35%;
        }
        .compare-inner-container .product-selected{
            margin:1rem;
        }
        .compare-container{
            overflow-x: scroll;
            padding-right:20px;
            padding-top:10px;
            padding-bottom:25px;
        }
        .lower-detail a{
           margin-top: 0px;
          padding: 5px 10px;
        }
        .lower-detail a p{
          font-size:11px;
        }
        .compare-inner-container{
            display:grid;
        }
        .compare-product-img{
            height:160px;
            margin-bottom:1rem;
        }
        .mobile-d{
            display:flex;
        }
        .compare-container::-webkit-scrollbar {
          height:5px;
          border-radius:50px;
        }
        .compare-container::-webkit-scrollbar-track {
          background: #f1f1f1; 
          border-radius: 50px;
        }
        .compare-container::-webkit-scrollbar-thumb {
          background: #FF8832;
          border-radius: 50px;
        }
        
    }
    /* ipad Air */
    @media only screen 
        and (min-device-width : 768px) 
        and (max-device-width : 1024px){
        .product-selected{
          padding-bottom:1rem;
        }
        .product-compare-section{
            padding:50px 0px;
        }
        .compare-inner-container .details_,
        .compare-inner-container .compare_li{
            display:grid;
            grid-template-columns: 25% 35% 35% 35% 35%;
        }
        .compare-inner-container .product-selected{
