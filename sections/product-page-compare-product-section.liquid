                            {% if product.selected_or_first_available_variant.featured_image %}
                                <img loading="lazy" class="product-image compare-product-img" src="{{ product.selected_or_first_available_variant.featured_image | img_url: '2048x2048'  }}" > 
                            {% else %}
                                <img loading="lazy" class="product-image compare-product-img" src="{{ product.featured_image | img_url: '2048x2048'  }}" > 
                            {% endif %}
                            <div class="lower-detail">
                                <div class="product-variant">
                                    <ul class="{{ product.metafields.custom.color_image_variant }}">
                                        {% if product.metafields.custom.color_image_variant %}
                                        <ul class="image-variant variant-desktop">
                                            {% assign count_extra = 0 %}
                                            {% for option in product.options %}
                                                {% if option == "Color" or option == "Colour" %}
                                                    {% assign index = forloop.index0 %}
                                                    {% assign colorlist = '' %}
                                                    {% assign color = '' %}
                                                    {% assign count = 0 %}
                                                    {% for variant in product.variants %}
                                                        {% capture color %}
                                                            {{ variant.options[index] }}
                                                        {% endcapture %}
                                                        {% unless colorlist contains color %}
                                                            {% if count < 4 %}
                                                                <li class="{% if forloop.index == 1 %}selected{% endif %}">
                                                                    <span class="color-variant " data-color="{{ color | handle }}" data-variant-image="{{ variant.featured_image.src | img_url: '2048x2048'  }}" data-variant-url="{{ variant.url }}" data-variant-id="{{ variant.id }}" style="background:url('{{ variant.featured_image.src | img_url: '2048x2048' }}')">{{ color | handle }}</span>
                                                                </li>
                                                                {% assign count = count | plus: 1 %}
                                                            {% else %}
                                                                {% assign count_extra = count_extra | plus: 1 %}
                                                            {% endif %}
                                                            {% capture tempList %}
                                                                {{ colorlist | append: color | append: ' '}}
                                                            {% endcapture %}
                                                            {% assign colorlist = tempList %}
                                                        {% endunless %}
                                                    {% endfor %}
                                                {% endif %}
                                            {% endfor %}
                                            {% if count_extra > 0 %}
                                                <li>
                                                    <a href="{{ product.url }}" class="color-variant mx-0 limit-var p-small black-f">+{{ count_extra }}</a>
                                                </li>
                                            {% endif %}
