        }
        .lower-detail a{
           margin-top: 0px;
          padding: 5px 10px;
        }
        .lower-detail a p{
          font-size:12px;
        }
        .compare-inner-container{
           display:grid;
        }
        .compare-product-img{
            height:160px;
            margin-bottom:1rem;
        }
        .mobile-d{
            display:flex;
        }
        .compare-container::-webkit-scrollbar {
          height:5px;
          border-radius:50px;
        }
        .compare-container::-webkit-scrollbar-track {
          background: #f1f1f1; 
          border-radius: 50px;
        }
        .compare-container::-webkit-scrollbar-thumb {
          background: #FF8832;
          border-radius: 50px;
        }
    }

    
    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 430px) {
        .compare-product-img{
            height:160px;
        }
    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 414px) {
        .compare-product-img{
            height:155px;
        }

    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 390px) {
        .compare-product-img{
            height:145x;
        }

    }

    /* FOR MOBILE PHONE */
    @media only screen and (max-width: 375px) {
        .compare-product-img{
            height:140px;
        }

    }
