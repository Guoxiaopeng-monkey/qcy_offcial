{{ 'custom-product-card.aio.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.aio.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-page-form.aio.min.js' | asset_url }}" defer="defer"></script>
<div 
  id="PromotionCollectionList-{{ section.id }}"
  class="{{ section.settings.product_header | handleize }}-section collection-list-section section-scroll" >
  <div class="page-width">
    <div class="container-header">
        <h2 class="sub-heading text-sm f-f-semibold mx-0 center" style="color:{{ section.settings.primary_color }};">{{ section.settings.sub_heading }}</h2>
        <h2 class="heading section-heading f-f-bold mx-0 center" style="color:{{ section.settings.primary_color }};">{{ section.settings.heading | replace: '<p>','' | replace: '</p>','' }}</h2>
        <span class="btn-guidelines text-underline h4 center" style="color:{{ section.settings.secondary_color }};">{{ section.settings.link_heading }}</span>
    </div>
    <div class="collection-list-container">
        {% for product in section.settings.collection.products %}
              {% render 'custom-card-product', product: product, forloop: forloop,
              background_add_to_cart: section.settings.background_add_to_cart,
              background_icon: section.settings.background_icon,
              background_buy_now: section.settings.background_buy_now,
              background_text: section.settings.background_text
              %}
        {% endfor %}
    </div>
    <div class="load-more-container {% if section.settings.collection.products.size < 8 %} hidden{% endif %}">
      <span class="load-more-btn-products-list h5 white-f">
        <span>Load More</span>
        <span>Show Less</span>
      </span>
    </div>
  </div>
</div>

<div class="custom-modal-section">
  <div class="overlay">
  </div>
  <div class="custom-model-inner-section">
    <div class="custom-modal-container">
        <span class="custom-close">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-close" viewBox="0 0 18 17">
                <path fill="currentColor" d="M.865 15.978a.5.5 0 0 0 .707.707l7.433-7.431 7.579 7.282a.501.501 0 0 0 .846-.37.5.5 0 0 0-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 1 0-.707-.708L8.991 7.853 1.413.573a.5.5 0 1 0-.693.72l7.563 7.268z"></path>
            </svg>
        </span>
        <h3 class="mx-0 f-f-regular  modal-heading">{{ section.settings.modal_heading }}</h3>
        <div class="custom-info-form">
          <div class="p mx-0">
            {{ section.settings.modal_description }}
          </div>
        </div>
    </div>
  </div>
</div>
{{ 'custom-product-card-variant.aio.min.js' | asset_url | script_tag }}
<script>
  $('#PromotionCollectionList-{{ section.id }} .collection-list-schema-section .btn-guidelines').click(() => {
    $('#PromotionCollectionList-{{ section.id }} .collection-list-schema-section .custom-modal-section').addClass('open');
    $('body').addClass('no-scroll');
  });
  
  $(document).ready(function() {
    var initialItems = 8;  // Always show 8 items initially
    var loadItems = 4;     // Number of items to load/hide on each click

    // Initially hide all items except the first 8
    $('#PromotionCollectionList-{{ section.id }} .product-item').hide();
    $('#PromotionCollectionList-{{ section.id }} .product-item').slice(0, initialItems).show();

    // Click event for Load More/Show Less button
    $('#PromotionCollectionList-{{ section.id }} .load-more-btn-products-list').on('click', function(e) {
        e.preventDefault();

        // Check if we're in "Show Less" mode
        if ($(this).hasClass('showing-less')) {
            // Hide items so only 8 remain visible
            var visibleItems = $('#PromotionCollectionList-{{ section.id }} .product-item:visible');
            visibleItems.slice(initialItems).slideUp();

            // Switch button text back to "Load More"
            $(this).removeClass('showing-less');
        } else {
            // Show 3 more items
            var hiddenItems = $('#PromotionCollectionList-{{ section.id }} .product-item:hidden');
            hiddenItems.slice(0, loadItems).slideDown();

            // If all items are shown, change button to "Show Less"
            if (hiddenItems.length <= loadItems) {
                $(this).addClass('showing-less');
            }
        }
    });
});


  
    $('.heading-text-discount').on('click', function() {
        var codeToCopy = $(this).attr('data-discount-code');
        var $tempTextarea = $('<textarea>');
        $('body').append($tempTextarea);
        $tempTextarea.val(codeToCopy).select();
        try {
            var successful = document.execCommand('copy');
            var msg = successful ? 'Code copied successfully!' : 'Failed to copy code';
  
            alert(msg);
        } catch (err) {
        }
  
        $tempTextarea.remove();
    });
</script>

{% schema %}
    {
        "class": "collection-list-schema-section section",
        "name": "Promotion Collection",
        "tag": "section",
        "templates": ["page"],
        "settings": [
            {
                "type": "text",
                "id": "product_header",
                "label": "Product Header"
            },
            {
                "type": "color",
                "id": "background",
                "label": "Background",
                "default":"#fff"
            },
            {
                "type": "color",
                "id": "primary_color",
                "label": "Primary Color",
                "default":"#1a1a1a"
            },
            {
                "type": "color",
                "id": "secondary_color",
                "label": "Secondary Color",
                "default":"#ff8832"
            },
            {
                "type": "text",
                "id": "sub_heading",
                "label": "Sub Heading"
            },
            {
                "type": "richtext",
                "id": "heading",
                "label": "Heading"
            },
            {
                "type": "collection",
                "id": "collection",
                "label": "Collection"
            },
            {
                "type": "text",
                "id": "link_heading",
                "label": "Link Heading"
            },
            {
                "type": "text",
                "id": "modal_heading",
                "label": "Modal Heading"
            },
            {
                "type": "richtext",
                "id": "modal_description",
                "label": "Modal Description"
            },
            {
                "type": "header",
                "content": "Product Item Style"
            },
            {
                "type": "color",
                "id": "background_product_item",
                "label": "Background Product Item",
                "default":"#fff"
            },
            {
                "type": "color",
                "id": "background_add_to_cart",
                "label": "Background - Add to Cart",
                "default":"#f1f1f1"
            },
            {
                "type": "color",
                "id": "background_icon",
                "label": "Color - Icon",
                "default":"#000"
            },
            {
                "type": "color",
                "id": "background_buy_now",
                "label": "Background - Buy Now",
                "default":"#f1f1f1"
            },
            {
                "type": "color",
                "id": "background_text",
                "label": "Color - Text",
                "default":"#000"
            }
        ],
        "presets" :[{
            "name" : "Promotion Collection"
        }]
    }
  {% endschema %} 