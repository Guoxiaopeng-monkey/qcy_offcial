<style>
  #shopify-section-{{ section.id }}{
    background-color:{{ section.settings.background }};
  }
  .collection-list-section {
    padding:80px 0px;
  }
  #shopify-section-{{ section.id }} .container-header .heading strong{
    color:{{ section.settings.secondary_color }};
  }
  .collection-list-section  .container-header a{
    width:fit-content;
    margin-top:10px;
  }
  .container-header{
    display:flex;
    flex-direction:column;
    align-items: center;
    gap:1rem;
  }
  .collection-list-container{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    padding-top: 50px;
    column-gap:20px;
    row-gap:30px;
  }
  .collection-list-section .product-item .lower-details{
    padding:2rem;
  }
  .btn-guidelines{
    cursor:pointer;
  }

   /* MODAL */
  
  .custom-modal-section{
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    z-index: 100;
    opacity: 0;
    visibility:hidden;
    transition: opacity 0.3s;
  }
  .custom-modal-section.open{
    visibility:visible;
    opacity:1;
  }
  .custom-modal-section .overlay{
    position: fixed;
    top: 0;
    background-color: rgba(0, 0, 0, 0.3);
    width: 100%;
    height: 100%;
  }
  .custom-model-inner-section .modal-heading{
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #00000021;
  }
  .custom-model-inner-section{
    height:100%;
    display:flex;
  }
  .custom-modal-container{
    background-color: #fff;
    max-width: 750px;
    border-radius: 20px;
    padding: 30px 40px;
    border: 2rem;
    transition: opacity 0.5s ease 0.5s, transform 0.5s ease 0.6s;
    position: relative;
    margin: auto;
    height:fit-content;
    z-index:3;
  }
  .custom-modal-section.open .custom-modal-container{
    opacity:1;
    transform: translateY(0);
  }
  .custom-info-form::-webkit-scrollbar {
    width: 0px;
  }
  .custom-info-form::-webkit-scrollbar-track {
    background: #f1f1f1; 
  }
  .custom-info-form::-webkit-scrollbar-thumb {
    background: #F89320;
  }
  .custom-info-form::-webkit-scrollbar-thumb:hover {
    background: #555; 
  }
  
  .custom-modal-container .custom-close{
    position:absolute;
    top:10px;
    right:12px;
    border-radius: 50px;
    width: 35px;
    height: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background-color:#FFF0E4;
  }
  .custom-modal-container .custom-close svg{
    width:14px;
  }
  .custom-modal-container .custom-close svg path{
    stroke: #000;
    stroke-width: 2px;
  }
  body.no-scroll{
    overflow:hidden;
  }
  .featured-products-section .modal-heading{
    padding-bottom:1.5rem;
    margin-bottom:1.5rem;
    border-bottom:1px solid #aaa;
  }
  #shopify-section-{{ section.id }} .collection-list-container .product-item{
    background-color: {{ section.settings.background_product_item }};
  }

  /* FOR MOBILE PHONE */
  @media only screen and (max-width: 768px) {
      .load-more-container{
        padding-bottom:50px;
      }
    .collection-list-container{
      grid-template-columns:repeat(2,1fr);
        column-gap: 10px;
        row-gap: 20px;
    }
    .collection-list-section{
      padding:50px 0px;
    }
    .collection-list-section .container-header .sub-heading{
        font-size:20px;
    }
    .collection-list-section .container-header .heading{
      font-size:28px;
    }
    .collection-list-section .container-header a{
      margin-top:0px;
    }
    .collection-list-container{
      padding-top:30px;
    }
    .copy-discount-off-section{
        display:none !important;
    }
    .price-n-button{
        border-top: 1px solid #00000012 !important;
        margin-top:10px !important;
        padding-top:10px !important;
    }
    .collection-list-section .product-item .lower-details{
      padding:1.5rem 1rem;
    }
  }
  
  /* ipad Air */
  @media only screen 
      and (min-device-width : 768px) 
      and (max-device-width : 1024px){
      .load-more-container{
        padding-bottom:50px;
      }
      .collection-list-container{
        grid-template-columns:repeat(2,1fr);
        column-gap: 10px;
        row-gap: 20px;
      }
      .collection-list-section{
        padding:50px 0px;
      }
      .collection-list-section .container-header .sub-heading{
          font-size:20px;
      }
      .collection-list-section .container-header .heading{
        font-size:28px;
      }
      .collection-list-section .container-header a{
        margin-top:0px;
      }
      .collection-list-container{
        padding-top:30px;
      }
      .copy-discount-off-section{
        display:none !important;
      }
      .price-n-button{
          border-top: 1px solid #00000012 !important;
          margin-top:10px !important;
          padding-top:10px !important;
      }
      .collection-list-section .product-item .lower-details{
        padding:1.5rem 1rem;
      }
  }
  /* TABLETS  */ 
  @media only screen and (min-width: 768px) {
    .collection-list-container{
      grid-template-columns:repeat(2,1fr);
    }
  }
   @media only screen and (min-width: 800px) {
    .collection-list-container{
      grid-template-columns:repeat(2,1fr);
    }
  }
  @media (min-width: 1024px) and (orientation: portrait) {
    .collection-list-container{
      grid-template-columns:repeat(2,1fr);
    }
  }
  
   /* COMPUTERS */
  @media (min-width: 1024px) and (orientation: landscape) {
    .collection-list-container{
      grid-template-columns:repeat(2,1fr);
    }
  }
  @media only screen and (min-width: 1280px) {
    .collection-list-container{
      grid-template-columns:repeat(2,1fr);
    }
  }
  @media only screen and (min-width: 1366px) {
    .collection-list-container{
      grid-template-columns:repeat(3,1fr);
    }
  }
  @media only screen and (min-width: 1440px) {
    .collection-list-container{
      grid-template-columns:repeat(3,1fr);
    }
  }
  @media only screen and (min-width: 1536px) {
    .collection-list-container{
      grid-template-columns:repeat(3,1fr);
    }
  }
  @media only screen and (min-width: 1600px) {
    .collection-list-container{
      grid-template-columns:repeat(4,1fr);
    }
  }
  @media only screen and (min-width: 1920px) {
    .collection-list-container{
      grid-template-columns:repeat(4,1fr);
    }
  }
  .load-more-container{
    display:flex;
    justify-content: center;
    width:100%;
    position:relative;
    top:50px;
  }
  .load-more-btn-products-list{
    padding:1rem 3rem;
    background-color:#000;
    border-radius:50px;
    transition: all 0.3s ease;
    cursor:pointer;
  }
  .load-more-btn-products-list:hover{
    background-color:#FF8832;
  }
  .load-more-btn-products-list span:nth-child(2){
    display:none;
  }
  .load-more-btn-products-list.showing-less span:nth-child(1){
    display:none;
  }
  .load-more-btn-products-list.showing-less span:nth-child(2){
    display:block;
  }
  .collection-list-schema-section .collection-list-container .product-item{
    height:fit-content;
  }


  .copy-discount-off-section{
    display:flex;
    position:relative;
    gap:3px;
    margin-top:0.3rem;
    padding-top:1.3rem;
    border-top:1px solid #00000012;
  }
  .copy-discount-off-section .col_65{
    background-color:#FFF0E4;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    position:relative;
    padding:7px 0px;
  }
  .copy-discount-off-section .col_65:before{
    content: "";
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50px;
    background-color: #fff;
    left: -10px;
    top:25%;
    position: absolute;
  }
  .copy-discount-off-section .col_65:after{
    content: "";
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50px;
    background-color: #fff;
    right: -10px;
    bottom:-10px;
    position: absolute;
    z-index: 1;
  }
  .copy-discount-off-section .col_35{
    background-color:#F8F8F8;    
    display: flex;
    align-items: center;
    justify-content: center;    
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    position:relative;
  }
  .copy-discount-off-section .col_35:after{
    content: "";
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50px;
    background-color: #fff;
    right: -10px;
    position: absolute;
  }
  .copy-discount-off-section .col_35:before{
    content: "";
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50px;
    background-color: #fff;
    left: -10px;
    top:-10px;
    position: absolute;
  }
  .heading-text-discount{
    font-size: 12px;
    color: #000;
    display: flex;
    gap: 5px;
    align-items: center;
    cursor:pointer;
  }
  .sub-heading-text-discount{
    font-size:10px;
  }
  /* CUSTOM CSS */
  .price-n-button{
    padding-top:0px;
    border:none;
  }
  .product-item .price{
    gap:0.8rem;
  }
  .product-item .compare-price{
    color:#AAAAAA;
  }
  .product-item .add-to-cart-btn{
    width:35px;
    height:35px;
  }
  .product-item .add-to-cart-btn svg{
    width:18px;
    height:18px;
  }
  
</style>
